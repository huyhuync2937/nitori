<smc:Form x:Class="Poctpna.FrmPoctpnaGetHDM"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:smc="clr-namespace:SasControls;assembly=SasControls"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          KeyUp="Form_KeyUp" Loaded="Form_Loaded" Title="Chon hop dong mua" LanguageID="PoctpnaGet"
          Height="218" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" OnCancel="ConfirmGridView_OnCancel" Margin="0">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Border Grid.Row="0" Margin="12,12,12,0" Height="119" BorderThickness="1" BorderBrush="#FF808080">
      <smc:GridLayout RowHeights="25,25,25,25" RowCount="4" Margin="12,9.5" ColumnCount="3" ColumnWidths="100,140,*">
        <TextBlock Name="tblngay_ct_old" Text="Ngày bắt đầu" Grid.Column="0" Grid.Row="0"
                   Style="{StaticResource ContentTextStyle}"/>
        <smc:DateTextBox Name="txtNgay_ct_old" DisplayMode="IncludeBoth" Grid.Column="1" IsAlwaysInEditMode="true"
                         VerticalAlignment="Center" Style="{StaticResource DateTextBoxStyle}" TabIndex="10"/>
        <TextBlock Name="tblngay_ct_new" Text="Ngày kết thúc" Grid.Column="0" Grid.Row="1"
                   Style="{StaticResource ContentTextStyle}"/>
        <smc:DateTextBox Name="txtNgay_ct_new" DisplayMode="IncludeBoth" Grid.Column="1" Grid.Row="1"
                         VerticalAlignment="Center" Style="{StaticResource DateTextBoxStyle}" IsAlwaysInEditMode="true"
                         TabIndex="20" Width="140"/>
        <TextBlock Name="tblma_khach" Text="Mã ncc" Grid.Column="0" Grid.Row="2"
                   Style="{StaticResource ContentTextStyle}"/>
        <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_kh_PreviewLostFocus" Name="txtMa_kh" Grid.Column="1" Grid.Row="2"
                                 TabIndex="30" VerticalAlignment="Center" Style="{StaticResource AutoCompleteTextBoxStyle}"
                                 AllowEmty="true" AllowWrong="true" ListID="dmkh"
                                 ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                 SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
        <TextBlock Name="tblTen_kh" Grid.Row="2" Grid.Column="2" Margin="12,0,0,0"
                   Style="{StaticResource ContentTextStyle}" Text="{smc:BindingEx Path=ten_kh}"/>
        <TextBlock Name="tblma_hdm" Text="Số đh mua" Grid.Column="0" Grid.Row="3"
                   Style="{StaticResource ContentTextStyle}"/>
        <smc:AutoCompleteTextBox Name="txtma_hdm" Grid.Column="1" Grid.Row="3" TabIndex="40" VerticalAlignment="Center"
                                 AllowEmty="true" Style="{StaticResource AutoCompleteTextBoxStyle}" AllowWrong="true" ListID="dmhdm"
                                 ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                 SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
      </smc:GridLayout>
    </Border>
  </smc:ConfirmGridView>
</smc:Form>