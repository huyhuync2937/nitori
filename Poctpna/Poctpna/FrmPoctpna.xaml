                  IsChecked="{smc:BindingEx sua_tien, Converter={StaticResource IsCheckedConverter}}"/>
                <TextBlock Name="tblCtrlTab" Text="Ctrl+Tab - Ra khỏi chi tiết" Margin="0,4,0,0"
                   Style="{StaticResource ContentTextStyle}" Height="19"/>
            </StackPanel>
        </smc:GridLayout>
        <GroupBox Name="gbTotal" Header="Tổng cộng" Margin="12,0,12,12" Grid.Column="0" Grid.Row="3">
            <smc:GridLayout x:Name="GrdLayoutTongCong" Margin="0">
                <smc:GridLayout x:Name="grdTotal" Row="3" RowCount="4" HeightPerRow="25" ColumnCount="5"
                        ColumnWidths="25,18*,22*,252,140">
                    <smc:GridLayout x:Name="GrdLayout11" Column="0" Grid.ColumnSpan="3"  Row="0" RowSpan="4" RowCount="4" HeightPerRow="25" ColumnCount="4">
                        <CheckBox Click="ChkTaoPc_Click" Name="ChkTaoPc" Grid.Row="0" Margin="20,0,0,0"                                  
                          Content="Tạo phiếu chi" IsTabStop="false" Style="{StaticResource CheckBoxEditModeEnable}"
                          IsChecked="{smc:BindingEx tao_pc, Converter={StaticResource IsCheckedConverter}}" VerticalAlignment="Top"/>

                        <TextBlock x:Name="lblstt_rec_pc" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" ToolTip="Xem phiếu" Foreground="DodgerBlue"
                            Style="{StaticResource ContentTextStyle}" Text="{smc:BindingEx Path=so_ct_pc}" MouseLeftButtonDown="btnViewPC_Click"/>
                        
                        <CheckBox Click="ChkTaoPB_Click" Name="ChkTaoPB" Grid.Row="1" Margin="20,0,0,0"                                  
                              Content="Tạo phân bổ" IsTabStop="false" Style="{StaticResource CheckBoxEditModeEnable}" 
                              IsChecked="{smc:BindingEx tag_pb, Converter={StaticResource IsCheckedConverter}}" VerticalAlignment="Top"/>

                        <smc:GridLayout x:Name="GrdLayout31" Column="2" Row="0" RowSpan="3" RowCount="4" HeightPerRow="25" Visibility="Collapsed"
                                Margin="-30,0,-130,0" ColumnCount="2" ColumnWidths="*,*">                            
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="PB chiết khấu theo hóa đơn " Foreground="BlueViolet"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Số tiền"/>

                                <smc:NumericTextBox   Name="txtso_tien_pb"  IsEnabled="True" Grid.Row="1" Grid.Column="1" 
                                      Style="{StaticResource NumericTextBoxrEditModeEnable}" Value="{smc:BindingEx Path=so_tien_pb}"
                                    Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Phương pháp PB"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" SelectedValue="{Binding Path=tag_pb, Mode=TwoWay}" SelectedValuePath="Tag" >
                                    <ComboBoxItem Content="Theo số lượng" Tag="0" />
                                    <ComboBoxItem Content="Theo giá trị" Tag="1"/>
                                </ComboBox>

                                <Button Click="btnPhanBo_HD_Click" Name="btnPhanBo_HD" Content="Phân bổ ck" Width="100" Height="25"   Foreground="AliceBlue" Background="BlueViolet"
                                    Grid.Row="3"/>                
                        </smc:GridLayout>
                    </smc:GridLayout>

                    <smc:GridLayout x:Name="GrdLayout21" Column="3" Row="0" RowSpan="4" RowCount="6" HeightPerRow="25"
                            Margin="0,0,12,0" ColumnCount="2" ColumnWidths="*,140">
                        <TextBlock Name="tblt_tien_nt" Text="Cộng tiền hàng" Grid.Column="0" Grid.Row="0"
                            Style="{StaticResource ContentTextStyle}"/>
                        <smc:NumericTextBox x:Name="txtT_Tien_nt" IsEnabled="false" Grid.Row="0" Grid.Column="1"
                            Value="{smc:BindingEx Path=t_tien_nt0}"
                            Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN_NT}"/>
                        <TextBlock Name="tblt_ck_nt" Text="Tiền ck" Grid.Column="0" Grid.Row="1"
                            Style="{StaticResource ContentTextStyle}"/>
                        <smc:NumericTextBox  Name="txtt_ck_nt" IsEnabled="false" ValueChanged="txtt_ck_nt_ValueChanged"
                             Grid.Row="1" Grid.Column="1"
                            Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN_NT}"
                            Value="{smc:BindingEx Path=t_ck_nt}"/>
                        <TextBlock Name="tblt_tien_sau_ck_nt" Text="Tiền sau ck" Grid.Column="0" Grid.Row="2" 
                            Style="{StaticResource ContentTextStyle}"/>
                        <smc:NumericTextBox Name="txtt_tien_sau_ck_nt" IsEnabled="false" Grid.Row="2" Grid.Column="1"  
                            Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN_NT}"
                            Value="{smc:BindingEx Path=t_tien_sau_ck_nt}"/>
                        <TextBlock Name="tblt_cp_nt" Text="Tiền chi phí" Grid.Column="0" Grid.Row="3"
                            Style="{StaticResource ContentTextStyle}"/>
                        <smc:NumericTextBox x:Name="txtT_cp_nt" IsEnabled="false" Grid.Row="3" Grid.Column="3"
                            Value="{smc:BindingEx Path=t_cp_nt}"
                            Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN_NT}"/>
                        <TextBlock Name="tblt_thue_nt" Text="Tiền thuế GTGT" Grid.Column="0" Grid.Row="4"
                            Style="{StaticResource ContentTextStyle}"/>
                        <smc:NumericTextBox x:Name="txtT_thue_nt" IsEnabled="false" Grid.Row="4" Grid.Column="3" ValueChanged="txtT_thue_nt_ValueChanged" LostFocus="txtT_thue_nt_LostFocus" 
                            Value="{smc:BindingEx Path=t_thue_nt}"
                            Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN_NT}"/>
                        <TextBlock Name="tblt_tt_nt" Text="Tổng tiền tt" Grid.Column="0" Grid.Row="6"
                            Style="{StaticResource ContentTextStyle}"/>
                        <smc:NumericTextBox x:Name="txtT_tt_nt" IsEnabled="false" Grid.Row="6" Grid.Column="3"   IsReadOnly="true" IsTabStop="false"
                            Value="{smc:BindingEx Path=t_tt_nt}"
                            Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN_NT}"/>
                    </smc:GridLayout>
                    <smc:GridLayout x:Name="GrdLayout20" Column="4" Row="0" RowSpan="4" Margin="0,0,0,0" RowCount="6" HeightPerRow="25"
                         ColumnCount="1" ColumnWidths="140">
                        <UIElement.Visibility>
                            <MultiBinding Converter="{StaticResource VisibilityConverter}" ConverterParameter="NotMaNt0">
                                <Binding Path="Value" Source="{StaticResource Voucher_Ma_nt0}"/>
                            </MultiBinding>
                        </UIElement.Visibility>
                        <smc:NumericTextBox x:Name="txtT_Tien_Nt0" IsEnabled="false" Grid.Row="0" Grid.Column="0"
                            Value="{smc:BindingEx Path=t_tien0}"
                            Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>
                        <smc:NumericTextBox  Name="txtt_ck" IsEnabled="false" Grid.Row="1"  ValueChanged="txtt_ck_ValueChanged"
                          Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"
                          Value="{smc:BindingEx Path=t_ck}"/>
                        <smc:NumericTextBox Name="txtt_tien_sau_ck" IsEnabled="false" Grid.Row="2"
                          Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"
                          Value="{smc:BindingEx Path=t_tien_sau_ck}"/>
                        <smc:NumericTextBox x:Name="txtT_cp_Nt0" IsEnabled="false" Grid.Row="3" Grid.Column="0"
                        Value="{smc:BindingEx Path=t_cp}"
                        Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>
                        <smc:NumericTextBox x:Name="txtT_thue_Nt0" IsEnabled="false" Grid.Row="4" Grid.Column="0"  ValueChanged="txtT_thue_ValueChanged" 
                            Value="{smc:BindingEx Path=t_thue}"
                            Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>
                        <smc:NumericTextBox x:Name="txtT_tt_Nt0" IsEnabled="false" Grid.Row="6" Grid.Column="0"
                            Value="{smc:BindingEx Path=t_tt}"
                            Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>
                    </smc:GridLayout>
                </smc:GridLayout>
            </smc:GridLayout>
        </GroupBox>
    </smc:GridLayout>
</smvc:FormTrans>