<smc:Form x:Class="COSXLSX.CODMNVL.FrmTimKiem"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:smc="http://sis.vn/SasControls"
          Loaded="Form_Loaded" Height="210" LanguageID="COSXLSX.CODMNVL_TimKiem" Width="600" Title="Tìm kiếm">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid>
        <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" OnCancel="ConfirmGridView_OnCancel" Name="GrdOkCancel">
            <GroupBox Name="Grdgroup" Margin="12,4,12,0" Style="{StaticResource NonHeaderGroupBoxStyle}">
                <smc:GridLayout Name="GrdInfo" RowCount="4" RowHeights="25,25,25,25" ColumnCount="5" ColumnWidths="120,140,12,120,140">
                    <TextBlock Name="tblMa_sp" Text="Mã sản phẩm" Grid.Column="0" Grid.Row="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_sp_PreviewLostFocus" x:Name="txtMa_sp" Grid.Column="1" Grid.Row="0"
                                   TabIndex="1" AllowEmty="true" AllowWrong="false" CharacterCasing="Upper" ListID="dmsp"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="lblTenSp" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Margin="5,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Name="tblMa_vt" Text="Mã vật tư" Grid.Column="0" Grid.Row="1"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_vt_PreviewLostFocus" x:Name="txtMa_vt" Grid.Column="1" Grid.Row="1"
                                   TabIndex="2" AllowEmty="true" AllowWrong="false" CharacterCasing="Upper" ListID="dmvt"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="lblTenVt" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="5,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Name="tblMa_px" Text="Mã chuyền" Grid.Column="0" Grid.Row="2"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_px_PreviewLostFocus" x:Name="txtMa_px" Grid.Column="1" Grid.Row="2"
                                   TabIndex="3" AllowEmty="true" AllowWrong="false" CharacterCasing="Upper" ListID="dmpx"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="lblTenPx" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </smc:GridLayout>
            </GroupBox>
        </smc:ConfirmGridView>
    </Grid>
</smc:Form>
