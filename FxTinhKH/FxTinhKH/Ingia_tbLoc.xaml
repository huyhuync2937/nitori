<smr:FormFilter x:Class="FxTinhKH.Ingia_tbLoc"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:smc="http://sis.vn/SasControls"
                     xmlns:smr="clr-namespace:SasFormReport;assembly=SasFormReport"
                     xmlns:igEditors="http://infragistics.com/Editors"
                     xmlns:local="clr-namespace:FxTinhKH"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                     Loaded="FrmIngia_tbLoc_Loaded" x:Name="FrmIngia_tbLoc" LanguageID="FXTinhKH_0" EscToClose="true"
                     Title="Tính khấu hao tài sản cố định" Height="279" Width="763" ResizeMode="CanMinimize">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <smc:NegativeConverter x:Key="mau_bcConverter"/>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" Name="grid0">
        <smc:ExTabControl Name="TabCtrl" Margin="12,10,12,0">
            <smc:ExTabItem Name="PageGeneral" Header="Thông tin chung">
                <smc:GridLayout Name="conGrid" RowCount="2" RowHeights="153,*" Margin="8,0,8,0">
                    <GroupBox Name="grid1" Grid.Row="0" Header="Điều kiện lọc" Style="{StaticResource TabGroupBoxStyle}">
                        <smc:GridLayout Name="grid2" RowCount="6" RowHeights="25,25,25,25,25,*" ColumnCount="3" ColumnWidths="100, 140, *">
                            <TextBlock Name="lblnam" Grid.Row="0" Grid.Column="0" Text="Năm"/>
                            <igEditors:XamMaskedEditor xmlns:igEditors="http://infragistics.com/Editors"
                                         GotFocus="txtGotFocus" ValueChanged="txt_LostFocus" Name="txtYear1" Mask="####"
                                         Margin="0,2.5,0,2.5" ValueType="{x:Type sys:Int32}" Grid.Column="1" Grid.Row="0"
                                         InvalidValueBehavior="RetainValue" TabIndex="10" FlowDirection="RightToLeft" PromptChar=" "
                                         Value="{smc:BindingEx nam1}">
                                <igEditors:ValueEditor.ValueConstraint>
                                    <igEditors:ValueConstraint MaxInclusive="2079" MinInclusive="1900" Nullable="False"/>
                                </igEditors:ValueEditor.ValueConstraint>
                            </igEditors:XamMaskedEditor>
                            <TextBlock Name="lblky1" Grid.Row="1" Grid.Column="0" Text="Từ kỳ"/>
                            <igEditors:XamMaskedEditor xmlns:igEditors="http://infragistics.com/Editors"
                                         LostFocus="txtPeriod1_LostFocus" GotFocus="txtGotFocus" ValueChanged="txt_LostFocus"
                                         x:Name="txtPeriod1" Mask="{}{number:0-12}" ValueType="{x:Type sys:Int32}" SpinIncrement="0"
                                         Grid.Column="1" Grid.Row="1" Margin="0,2.5,0,2.5" InvalidValueBehavior="RetainValue"
                                         FlowDirection="RightToLeft" TabIndex="20" PromptChar=" " Value="{smc:BindingEx ky1}">
                                <igEditors:ValueEditor.ValueConstraint>
                                    <igEditors:ValueConstraint Nullable="False" MaxInclusive="12"/>
                                </igEditors:ValueEditor.ValueConstraint>
                            </igEditors:XamMaskedEditor>
                            <TextBlock Name="lblNgay_ct1" Grid.Row="1" Grid.Column="3" Margin="12,0" Text="01-01-2010" Grid.ColumnSpan="2"/>
                            <TextBlock Name="lblky2" Grid.Row="2" Grid.Column="0" Text="Đến kỳ"/>
                            <igEditors:XamMaskedEditor xmlns:igEditors="http://infragistics.com/Editors"
                                         LostFocus="txtPeriod2_LostFocus" GotFocus="txtGotFocus" ValueChanged="txt_LostFocus"
                                         x:Name="txtPeriod2" Mask="{}{number:0-12}" ValueType="{x:Type sys:Int32}" SpinIncrement="0"
                                         Grid.Column="1" Grid.Row="2" Margin="0,2.5,0,2.5" InvalidValueBehavior="RetainValue"
                                         FlowDirection="RightToLeft" TabIndex="20" PromptChar=" " Value="{smc:BindingEx ky2}">
                                <igEditors:ValueEditor.ValueConstraint>
                                    <igEditors:ValueConstraint Nullable="False" MaxInclusive="12"/>
                                </igEditors:ValueEditor.ValueConstraint>
                            </igEditors:XamMaskedEditor>
                            <TextBlock Name="lblNgay_ct2" Grid.Row="2" Grid.Column="3" Margin="12,0" Text="01-01-2010" Grid.ColumnSpan="2"/>
                            <TextBlock Name="lblds_ts" Grid.Row="3" Grid.Column="0" Text="Ds công cụ (F11)"/>
                            <TextBox PreviewKeyUp="txtMaTs_PreviewKeyUp" Name="txtMaTs" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2"
                       TabIndex="25"/>
                            <TextBlock Name="lblMa_dvcs" Grid.Row="4" Grid.Column="0" Text="Mã ĐVCS"/>
                            <smc:AutoCompleteTextBox LostFocus="txtMa_dvcs_LostFocus" Name="txtMa_dvcs" Grid.Row="4" Grid.Column="1" AllowEmty="true"
                                       AllowWrong="true" ListID="dmdvcs" TabIndex="30"
                                       SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                       ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                       Text="{smc:BindingEx Path=M_MA_DVCS, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                            <TextBlock Name="txtTen_dvcs" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="3" TextWrapping="NoWrap"
                         Margin="12,0,0,0"/>
                        </smc:GridLayout>
                    </GroupBox>
                </smc:GridLayout>
            </smc:ExTabItem>
        </smc:ExTabControl>
        <Canvas Grid.Row="2" Width="150" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,33">
            <TextBlock Name="tblTraCuu" Text="F5 - Tra cứu" Width="150" HorizontalAlignment="Right" TextAlignment="Right"
                 Visibility="Collapsed"/>
        </Canvas>
    </smc:ConfirmGridView>
</smr:FormFilter>
