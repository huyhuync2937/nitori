            bool? nullable = frmSetValue.ShowDialog();
            if ((!nullable.GetValueOrDefault() ? 1 : (!nullable.HasValue ? 1 : 0)) != 0 || (frmSetValue.cbField.Value == null || frmSetValue.cbField.Value.ToString().Trim() == ""))
