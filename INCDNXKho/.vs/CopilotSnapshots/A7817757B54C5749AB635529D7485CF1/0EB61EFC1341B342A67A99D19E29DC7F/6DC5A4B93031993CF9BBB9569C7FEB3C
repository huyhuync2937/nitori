                                string otherMaCa = otherRow["ma_ca"]?.ToString().Trim() ?? "";
                                double otherSoCa = string.IsNullOrEmpty(otherRow["so_ca"]?.ToString()) ? 0 : Double.Parse(otherRow["so_ca"].ToString());
                                
                                if (!string.IsNullOrEmpty(otherMaCa) && otherSoCa > 0)
                                {
                                    otherNgayKt = GetNgayKetThuc(otherSoCa, otherNgayBd, otherMaCa);
                                }

                                // Check if date ranges overlap
                                // Two date ranges overlap if: Start1 <= End2 AND Start2 <= End1
                                if (ngay_bd_check <= otherNgayKt && otherNgayBd <= ngay_kt_check)
                                {
                                    int num = (int)ExMessageBox.Show(500, StartupBase.SasObj, "Mã máy đã sản xuất vật tư khác", "", MessageBoxButton.OK, MessageBoxImage.Asterisk);
                                    return;
                                }
                            }
