            }

            // Validate machine code with date range overlap
            if (frmSetValue.cbField.Value.ToString().Trim() == "ma_may")
            {
                DateTime ngay_bd_check = DateTime.Now;
                if (!string.IsNullOrEmpty(record.Cells["ngay_bd"].Value?.ToString()))
                {
                    ngay_bd_check = Convert.ToDateTime(record.Cells["ngay_bd"].Value.ToString());
                }

                string ma_ca_check = record.Cells["ma_ca"].Value?.ToString().Trim() ?? "";
                double so_ca_check = string.IsNullOrEmpty(record.Cells["so_ca"].Value?.ToString()) ? 0 : Double.Parse(record.Cells["so_ca"].Value.ToString());

                // Get the end date for current record
                DateTime ngay_kt_check = ngay_bd_check;
                if (!string.IsNullOrEmpty(ma_ca_check) && so_ca_check > 0)
                {
                    ngay_kt_check = GetNgayKetThuc(so_ca_check, ngay_bd_check, ma_ca_check);
                }

                // Check all other selected rows for the same machine code with overlapping date range
                foreach (DataRowView otherRow in dataView)
                {
                    if ((bool)otherRow["chon"])
                    {
                        string otherMaMay = otherRow["ma_may"]?.ToString().Trim() ?? "";
                        
                        // Only check if this row also has the same machine code as the one being set
                        if (otherMaMay == value && !string.IsNullOrEmpty(value))
                        {
                            string otherNgayBdStr = otherRow["ngay_bd"]?.ToString().Trim() ?? "";
                            if (!string.IsNullOrEmpty(otherNgayBdStr))
                            {
                                DateTime otherNgayBd = Convert.ToDateTime(otherNgayBdStr);
