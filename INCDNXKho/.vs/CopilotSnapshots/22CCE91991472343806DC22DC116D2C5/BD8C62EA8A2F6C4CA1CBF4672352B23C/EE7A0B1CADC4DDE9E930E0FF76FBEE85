    #region Conflict Validation

    private static void ValidateDateConflict(
    DataRowView[] selectedRows,
    DataRecord record,
    string newValue,
    string fieldName)
    {
        // =====================================================
        // Lấy giá trị hiện tại trên grid
        // =====================================================

        string ngayBdStr = GetCellString(record, FieldNames.NGAY_BD);
        string ngayKtStr = GetCellString(record, FieldNames.NGAY_KT);
        string maMayStr = GetCellString(record, FieldNames.MA_MAY);
        string maCaBd ;


        // =====================================================
        // Nếu đang edit thì dùng giá trị mới nhập
        // vì record lúc này có thể chưa update
        // =====================================================

        if (fieldName == FieldNames.NGAY_BD)
        {
            ngayBdStr = SafeToString(newValue).Trim();
        }

        if (fieldName == FieldNames.NGAY_KT)
        {
            ngayKtStr = SafeToString(newValue).Trim();
        }
        if (fieldName == FieldNames.MA_CA)
        {
            maCaBd = SafeToString(newValue).Trim();
        }

        DateTime currentStartDate;
        DateTime currentEndDate;

        // =====================================================
        // Validate nhập NGAY_BD trước
        // =====================================================

        if (fieldName == FieldNames.NGAY_BD || fieldName == FieldNames.MA_CA)
        {
            // chưa nhập -> bỏ qua
            if (string.IsNullOrEmpty(ngayBdStr))
                return;

            if (!TryParseDate(ngayBdStr, out currentStartDate))
                return;

            DataView dataView = StartUp.oBrowse.DataGrid.DataSource as DataView;
            DataRow currentRow = (record.DataItem as DataRowView)?.Row;

            foreach (DataRowView otherRow in dataView)
            {
                // bỏ qua chính dòng hiện tại
                if (otherRow.Row == currentRow)
                    continue;

                string otherMachineCode =
                    SafeToString(otherRow[FieldNames.MA_MAY]).Trim();

                if (otherMachineCode != maMayStr ||
                    string.IsNullOrEmpty(maMayStr))
                    continue;

                string otherNgayBdStr =
                    SafeToString(otherRow[FieldNames.NGAY_BD]).Trim();

                string otherMaCaStr =
                  SafeToString(otherRow[FieldNames.MA_CA]).Trim();

            

                string otherMaCaKtStr =
        SafeToString(otherRow[FieldNames.MA_CA_KT]).Trim();

                string otherNgayKtStr =
                    SafeToString(otherRow[FieldNames.NGAY_KT]).Trim();

                if (string.IsNullOrEmpty(otherNgayBdStr) ||
                    string.IsNullOrEmpty(otherNgayKtStr))
                    continue;

                DateTime otherStartDate;
                DateTime otherEndDate;

                if (!DateTime.TryParse(otherNgayBdStr, out otherStartDate))
                    continue;

                if (!DateTime.TryParse(otherNgayKtStr, out otherEndDate))
                    continue;

                // =================================================
                // chỉ check NGAY_BD mới nhập
                // có nằm trong khoảng khác không
                // =================================================

                if (currentStartDate > otherStartDate &&
                    currentStartDate < otherEndDate )
                {
                    ExMessageBox.Show(
                        Messages.MACHINE_CONFLICT,
                        StartupBase.SasObj,
                        "Ngày bắt đầu bị trùng khoảng thời gian sản xuất",
                        "",
                        MessageBoxButton.OK,
                        MessageBoxImage.Asterisk
                    );

                    throw new InvalidOperationException(
                        "Machine code conflict detected");
                }

                if(currentStartDate == otherStartDate && currentStartDate != otherEndDate && fieldName == FieldNames.MA_CA)
                {
                    int currentShift = GetShiftOrder(SafeToString(newValue).Trim());
                    int otherShift = GetShiftOrder(otherMaCaStr);

                    if (currentShift >= otherShift)
                    {
                        ExMessageBox.Show(
                            Messages.MACHINE_CONFLICT,
                            StartupBase.SasObj,
                            "Ngày bắt đầu bị trùng khoảng thời gian sản xuất",
                            "",
                            MessageBoxButton.OK,
                            MessageBoxImage.Asterisk
                        );

                        throw new InvalidOperationException(
                            "Machine code conflict detected");
                    }
                }
                if (currentStartDate == otherEndDate && fieldName == FieldNames.MA_CA)
                {
                    int currentShift = GetShiftOrder(SafeToString(newValue).Trim());
                    int otherShift = GetShiftOrder(otherMaCaKtStr);

                    if (currentShift <= otherShift)
                    {
                        ExMessageBox.Show(
                            Messages.MACHINE_CONFLICT,
                            StartupBase.SasObj,
                            "Ngày bắt đầu bị trùng khoảng thời gian sản xuất",
                            "",
                            MessageBoxButton.OK,
                            MessageBoxImage.Asterisk
                        );

                        throw new InvalidOperationException(
                            "Machine code conflict detected");
                    }
                }


            }
            return;
        }

        // =====================================================
        // Validate NGAY_KT
        // =====================================================

        if (fieldName == FieldNames.NGAY_KT)
        {
            // phải có NGAY_BD trước
            if (string.IsNullOrEmpty(ngayBdStr) ||
                string.IsNullOrEmpty(ngayKtStr))
                return;

            if (!DateTime.TryParse(ngayBdStr, out currentStartDate))
                return;

            if (!DateTime.TryParse(ngayKtStr, out currentEndDate))
                return;

            // validate khoảng ngày hợp lệ
            if (currentEndDate < currentStartDate)
            {
                ExMessageBox.Show(
                    Messages.MACHINE_CONFLICT,
                    StartupBase.SasObj,
                    "Ngày kết thúc không được nhỏ hơn ngày bắt đầu",
                    "",
                    MessageBoxButton.OK,
                    MessageBoxImage.Asterisk
                );

                throw new InvalidOperationException(
                    "Invalid date range");
            }

            DataView dataView = StartUp.oBrowse.DataGrid.DataSource as DataView;

            foreach (DataRowView otherRow in dataView)
            {
                // bỏ qua chính nó
                if (ReferenceEquals(otherRow, record))
                    continue;

              

               
                string otherNgayBdStr =
                    SafeToString(otherRow[FieldNames.NGAY_BD]).Trim();

                string otherNgayKtStr =
                    SafeToString(otherRow[FieldNames.NGAY_KT]).Trim();

                if (string.IsNullOrEmpty(otherNgayBdStr) ||
                    string.IsNullOrEmpty(otherNgayKtStr))
                    continue;

                DateTime otherStartDate;
                DateTime otherEndDate;

                if (!DateTime.TryParse(otherNgayBdStr, out otherStartDate))
                    continue;

                if (!DateTime.TryParse(otherNgayKtStr, out otherEndDate))
                    continue;

                // =================================================
                // overlap full range
                // =================================================

                bool isOverlap =
                    !(currentEndDate < otherStartDate ||
                      currentStartDate > otherEndDate);

                if (isOverlap)
                {
                    ExMessageBox.Show(
                        Messages.MACHINE_CONFLICT,
                        StartupBase.SasObj,
                        "Mã máy đã sản xuất vật tư khác trong khoảng thời gian này",
                        "",
                        MessageBoxButton.OK,
                        MessageBoxImage.Asterisk
                    );

                    throw new InvalidOperationException(
                        "Machine code conflict detected");
                }
            }
        }
    }
