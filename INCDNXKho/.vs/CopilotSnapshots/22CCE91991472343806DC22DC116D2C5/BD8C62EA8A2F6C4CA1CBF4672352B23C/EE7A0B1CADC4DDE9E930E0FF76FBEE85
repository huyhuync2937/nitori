    #region Form Creation and Configuration

    private static FrmSetValue CreateAndConfigureForm(string oldValue, string fieldName)
    {
        FrmSetValue frm = new FrmSetValue(oldValue, fieldName);
        frm.cbField.ItemsProvider = new ComboBoxItemsProvider();
        frm.cbField.ValuePath = "Value";

        PopulateFieldCombo(frm);
        SetFieldValue(frm, fieldName);
        ConfigureFormByFieldType(frm, fieldName);

        return frm;
    }

    private static void PopulateFieldCombo(FrmSetValue frm)
    {
        FieldCollection fields = StartUp.oBrowse.frmBrw.oBrowse.FieldLayouts[0].Fields;

        foreach (string field in StartUp.CanChangeValueFields)
        {
            string displayName = field;

            if (fields.Any(f => f.Name == field))
            {
                displayName = fields[field].Label.ToString();
            }

            frm.cbField.ItemsProvider.Items.Add(new ComboBoxDataItem(field, displayName));
        }
    }

    private static void SetFieldValue(FrmSetValue frm, string fieldName)
    {
        if (CanChangeField(fieldName))
        {
            frm.cbField.Value = fieldName;
        }
        else
        {
            frm.cbField.SelectedIndex = 0;
        }
    }

    private static void ConfigureFormByFieldType(FrmSetValue frm, string fieldName)
    {
        string fieldValue = SafeToString(frm.cbField.Value).Trim();

        if (fieldValue == FieldNames.MA_MAY)
        {
            ConfigureForMaMay(frm);
        }
        else if (fieldValue == FieldNames.MA_CA || fieldValue == FieldNames.MA_CA_KT)
        {
            ConfigureForMaCa(frm);
        }
        else if (fieldValue == FieldNames.NGAY_BD || fieldValue == FieldNames.NGAY_KT)
        {
            ConfigureForDate(frm);
        }
        else if (fieldValue == FieldNames.SL_KG_LENH || fieldValue == FieldNames.SL_CAI_LENH)
        {
            ConfigureForQuantity(frm);
        }
        else if (fieldValue == FieldNames.ID)
        {
            ConfigureForId(frm);
        }

        frm.txtNewValue.IsFocus = true;
    }

