    #region Update Execution

    private static void ExecuteUpdates(UpdateData data)
    {
        if (data.SelectedRows.Length == 0)
            return;
        DataRowView currentRow = data.Record.DataItem as DataRowView;

        // ✅ FIX: Handle cascade update for consecutive IDs when updating ma_ca
        if (data.FieldName == FieldNames.MA_CA &&  Convert.ToInt32(currentRow[FieldNames.ID]) == 1)
        {
            ExecuteCascadeMaCaUpdate(data);
        }
        else
        {
            ExecuteNormalUpdates(data);
        }

        RefreshGridReport();
    }

    private static void ExecuteNormalUpdates(UpdateData data)
    {
        SasFormBrowes.FrmWaiting frmWait = new SasFormBrowes.FrmWaiting(data.SelectedRows.Length);
        try
        {
            frmWait.Show();

            foreach (DataRowView row in data.SelectedRows)
            {
                ExecuteSingleUpdate(row, data);
                frmWait.Set(1);
            }
        }
        finally
        {
            if (frmWait != null)
            {
                frmWait.Hide();
                frmWait.Close();
                frmWait = null;
            }
        }
    }

    private static void ExecuteCascadeMaCaUpdate(UpdateData data)
    {
        // Get the current record's info (the one being edited)
        DataRowView currentRow = data.Record.DataItem as DataRowView;
        if (currentRow == null)
        {
            ExecuteNormalUpdates(data);
            return;
        }

        string currentMaMay = SafeToString(currentRow[FieldNames.MA_MAY]).Trim();
        int currentId = Convert.ToInt32(currentRow[FieldNames.ID]);

        // Get all records with the same ma_may sorted by id
        DataView dataView = StartUp.oBrowse.DataGrid.DataSource as DataView;
        List<DataRowView> groupedRows = new List<DataRowView>();

        foreach (DataRowView row in dataView)
        {
            string rowMaMay = SafeToString(row[FieldNames.MA_MAY]).Trim();
            if (rowMaMay == currentMaMay)
                groupedRows.Add(row);
        }

        // Sort by ID
        groupedRows.Sort((a, b) => 
            Convert.ToInt32(a[FieldNames.ID]).CompareTo(Convert.ToInt32(b[FieldNames.ID])));

        // Find the starting index - we want to update from current id onwards
        int startIndex = 0;
        for (int i = 0; i < groupedRows.Count; i++)
        {
            if (Convert.ToInt32(groupedRows[i][FieldNames.ID]) == currentId)
            {
                startIndex = i;
                break;
            }
        }

        SasFormBrowes.FrmWaiting frmWait = new SasFormBrowes.FrmWaiting(groupedRows.Count - startIndex);
        try
        {
            frmWait.Show();

            DateTime currentNgayBd = DateTime.MinValue;
            string currentMaCa = data.NewValue; // The new ma_ca being set
            
            // Get start date from current record
            string ngayBdStr = GetCellString(data.Record, FieldNames.NGAY_BD);
            if (string.IsNullOrEmpty(ngayBdStr))
            {
                // No start date, do normal update
                ExecuteNormalUpdates(data);
                return;
            }

            currentNgayBd = Convert.ToDateTime(ngayBdStr);

            // Update records starting from currentId with consecutive dates and shifts
            for (int i = startIndex; i < groupedRows.Count; i++)
            {
                DataRowView row = groupedRows[i];
                
                // Extract context from current row for calculations
                UpdateContext context = ExtractRowContext(row, data.Record);
                
                // Calculate end shift and end date for this record
                string maCaKt = GetCaKetThuc(context.SoCaLamTron, currentMaCa);
                DateTime ngayKt = GetNgayKetThuc(context.SoCaLamTron, currentNgayBd, currentMaCa);

                // Build custom SQL update that includes ngay_bd, ma_ca, ma_ca_kt, and ngay_kt
                string baseWhere = string.Format(" WHERE vung_may = N'{0}' AND " +
                               "nhom_may = N'{1}' AND " +
                               "ma_nvl_gop = N'{2}' AND " +
                               "id = {3}",
                               context.VungMay, context.NhomMay, context.MaNvlGop, 
                               Convert.ToInt32(row[FieldNames.ID]));

                string updateCommand = string.Format(
                    "UPDATE {0} SET ngay_bd = '{1}', ma_ca = '{2}', ma_ca_kt = '{3}', ngay_kt = '{4}'{5}",
                    TABLE_NAME,
                    currentNgayBd.ToString(DATE_FORMAT),
                    currentMaCa,
                    maCaKt,
                    ngayKt.ToString(DATE_FORMAT),
                    baseWhere);

                SqlCommand cmd = new SqlCommand(updateCommand);
                StartupBase.SasObj.ExcuteNonQuery(cmd);

                // Calculate next shift and date for next iteration
                DateTime nextNgayBd = ngayKt;
                currentMaCa = GetNextMaCa(maCaKt);
                currentNgayBd = nextNgayBd;

                frmWait.Set(1);
            }
        }
        finally
        {
            if (frmWait != null)
            {
                frmWait.Hide();
                frmWait.Close();
                frmWait = null;
            }
        }
    }

    private static string GetNextMaCa(string currentMaCa)
    {
        switch (SafeToString(currentMaCa).Trim())
        {
            case "CA01":
                return "CA02";
            case "CA02":
                return "CA03";
            case "CA03":
                return "CA01";
            default:
                return "CA01";
        }
    }

    private static void ExecuteSingleUpdate(DataRowView row, UpdateData data)
    {
        UpdateContext context = ExtractRowContext(row, data.Record);
        string commandText = BuildUpdateCommand(data, context);

        SqlCommand cmd = new SqlCommand(commandText);
        StartupBase.SasObj.ExcuteNonQuery(cmd);
    }

    private class UpdateContext
    {
        public string MaNvlGop { get; set; }
        public string VungMay { get; set; }
        public string NhomMay { get; set; }
        public string SoCa { get; set; }
        public string SoCalenh { get; set; }
        public string MaCa { get; set; }
        public decimal Nsc { get; set; }
        public double SoCaLamTron { get; set; }
    }

    private static UpdateContext ExtractRowContext(DataRowView row, DataRecord record)
    {
        string soCa = row[FieldNames.SO_CA].ToString();
        string SoCalenh = row[FieldNames.SO_CA_LENH].ToString();
        string maCa = GetCellString(record, FieldNames.MA_CA);
        decimal nsc = Convert.ToDecimal(GetCellString(record, FieldNames.NSC));

        double numSoCa = 0;
        double tempVal = 0;

        if (double.TryParse(SoCalenh, out tempVal) && tempVal != 0)
        {
            numSoCa = tempVal;
        }
        else if (double.TryParse(soCa, out tempVal))
        {
            numSoCa = tempVal;
        }

        UpdateContext context = new UpdateContext();
        context.MaNvlGop = row[FieldNames.MA_NVL_GOP].ToString();
        context.VungMay = row[FieldNames.VUNG_MAY].ToString();
        context.NhomMay = row[FieldNames.NHOM_MAY].ToString();
        context.SoCa = soCa;
        context.SoCalenh = SoCalenh;
        context.MaCa = maCa;
        context.Nsc = nsc;
        context.SoCaLamTron = Math.Ceiling(numSoCa);

        return context;
    }

    private static string BuildUpdateCommand(UpdateData data, UpdateContext context)
    {
        string baseWhere = string.Format(" WHERE vung_may = N'{0}' AND " +
                           "nhom_may = N'{1}' AND " +
                           "ma_nvl_gop = N'{2}' ",
                           context.VungMay, context.NhomMay, context.MaNvlGop);

        if (data.FieldName == FieldNames.NGAY_BD)
        {
            return BuildDateUpdateCommand(data, context, baseWhere);
        }
        else if (data.FieldName == FieldNames.MA_CA)
        {
            return BuildMaCaUpdateCommand(data, context, baseWhere);
        }
        else if (data.FieldName == FieldNames.MA_CA_KT)
        {
            return string.Format("UPDATE {0} SET {1} = '{2}'{3}",
                TABLE_NAME, data.FieldName, data.NewValue, baseWhere);
        }
        else if (data.FieldName == FieldNames.NGAY_KT)
        {
            return string.Format("UPDATE {0} SET {1} = '{2}'{3}",
                TABLE_NAME, data.FieldName, data.NewValue, baseWhere);
        }
        else if (data.FieldName == FieldNames.SL_CAI_LENH)
        {
            return BuildQuantityUpdateCommand(data, context, baseWhere, false);
        }
        else if (data.FieldName == FieldNames.SL_KG_LENH)
        {
            return BuildQuantityUpdateCommand(data, context, baseWhere, true);
        }
        else if (data.FieldName == FieldNames.ID)
        {
            return string.Format("UPDATE {0} SET {1} = '{2}'{3}",
                TABLE_NAME, data.FieldName, data.Quantity, baseWhere);
        }
        else
        {
            return string.Format("UPDATE {0} SET {1} = '{2}'{3}",
                TABLE_NAME, data.FieldName, data.NewValue, baseWhere);
        }
    }

    private static string BuildDateUpdateCommand(UpdateData data, UpdateContext context, string baseWhere)
    {
        // When updating ngay_bd (start date)
        // We need to recalculate ngay_kt ONLY if ma_ca exists

        string maCa = GetCellString(data.Record, FieldNames.MA_CA);

        if (!string.IsNullOrEmpty(maCa))
        {
            // ✅ ma_ca EXISTS → Calculate and update ngay_kt
            DateTime ngayBd = DateTime.ParseExact(data.NewValue, DATE_FORMAT, CultureInfo.InvariantCulture);
            double soCaDouble = 0;
            double.TryParse(context.SoCa, out soCaDouble);

            DateTime ngayKt = GetNgayKetThuc(soCaDouble, ngayBd, maCa);

            return string.Format("UPDATE {0} SET {1} = '{2}', ngay_kt = '{3}'{4}",
                TABLE_NAME, data.FieldName, data.NewValue, ngayKt.ToString(DATE_FORMAT), baseWhere);
        }
        else
        {
            // ❌ ma_ca does NOT exist → Only update ngay_bd, NOT ngay_kt
            return string.Format("UPDATE {0} SET {1} = '{2}'{3}",
                TABLE_NAME, data.FieldName, data.NewValue, baseWhere);
        }
    }


    private static string BuildMaCaUpdateCommand(UpdateData data, UpdateContext context, string baseWhere)
    {
      

        // ✅ FIX: Only update ma_ca_kt and ngay_kt with proper conditions

        string newMaCa = data.NewValue; // The new ma_ca value being set
        string maCaKt = GetCaKetThuc(context.SoCaLamTron, newMaCa);

        // Check if ngay_bd exists
        string ngayBdStr = GetCellString(data.Record, FieldNames.NGAY_BD);


        if (!string.IsNullOrEmpty(ngayBdStr) )
        {
            // ✅ ngay_bd EXISTS → Update both ma_ca_kt AND ngay_kt
            DateTime ngayBd = Convert.ToDateTime(ngayBdStr);
            double soCaDouble = context.SoCaLamTron;


            DateTime ngayKt = GetNgayKetThuc(soCaDouble, ngayBd, newMaCa);


            return string.Format("UPDATE {0} SET {1} = '{2}', ma_ca_kt = '{3}', ngay_kt = '{4}'{5}",
                TABLE_NAME, data.FieldName, newMaCa, maCaKt, ngayKt.ToString(DATE_FORMAT), baseWhere);
        }
        else
        {
            // ❌ ngay_bd does NOT exist → Update ma_ca_kt but NOT ngay_kt
            return string.Format("UPDATE {0} SET {1} = '{2}', ma_ca_kt = '{3}'{4}",
                TABLE_NAME, data.FieldName, newMaCa, maCaKt, baseWhere);
        }
    }

    private static string BuildQuantityUpdateCommand(UpdateData data, UpdateContext context, string baseWhere, bool isKg)
    {
        DataRow rowQD = GetDVTKL(context.MaNvlGop);
        if (rowQD == null)
        {
            return string.Format("UPDATE {0} SET {1} = {2}{3}",
                TABLE_NAME, data.FieldName, data.Quantity, baseWhere);
        }

        decimal hsQd = 0;
        if (!Decimal.TryParse(rowQD[FieldNames.HS_QD].ToString(), out hsQd) || hsQd <= 0)
        {
            return string.Format("UPDATE {0} SET {1} = {2}{3}",
                TABLE_NAME, data.FieldName, data.Quantity, baseWhere);
        }

        decimal slKgLenh, slCaiLenh, soCa;

        if (isKg)
        {
            slKgLenh = data.Quantity;
            slCaiLenh = Math.Round(data.Quantity * hsQd, 2);
            soCa = Math.Round(slCaiLenh / context.Nsc, 2);
        }
        else
        {
            slCaiLenh = data.Quantity;
            slKgLenh = Math.Round(data.Quantity / hsQd, 2);
            soCa = Math.Round(slCaiLenh / context.Nsc, 2);
        }

        // ✅ FIX #1: Check if ma_ca exists before calculating ma_ca_kt
        string maCa = GetCellString(data.Record, FieldNames.MA_CA);
        if (string.IsNullOrEmpty(maCa))
        {
            // ❌ Nếu ma_ca KHÔNG có → KHÔNG update ma_ca_kt và ngay_kt
            return string.Format(
                "UPDATE {0} SET sl_kg_lenh = {1}, sl_cai_lenh = {2}, so_ca_lenh = {3}{4}",
                TABLE_NAME,
                slKgLenh.ToString(CultureInfo.InvariantCulture),
                slCaiLenh.ToString(CultureInfo.InvariantCulture),
                soCa.ToString(CultureInfo.InvariantCulture),
                baseWhere);
        }

        // ✅ FIX #2: ma_ca EXISTS - now check if ngay_bd exists for ngay_kt
        string maCaKt = GetCaKetThuc(Math.Ceiling(Convert.ToDouble(soCa)), maCa);
        string ngayBdStr = GetCellString(data.Record, FieldNames.NGAY_BD);

        if (!string.IsNullOrEmpty(ngayBdStr))
        {
            // ✅ Both ma_ca AND ngay_bd exist → Update ALL fields including ngay_kt
            DateTime ngayBd = Convert.ToDateTime(ngayBdStr);
            DateTime ngayKt = GetNgayKetThuc(Convert.ToDouble(soCa), ngayBd, maCaKt);

            return string.Format(
                "UPDATE {0} SET sl_kg_lenh = {1}, sl_cai_lenh = {2}, " +
                "so_ca_lenh = {3}, ma_ca_kt = '{4}', ngay_kt = '{5}'{6}",
                TABLE_NAME,
                slKgLenh.ToString(CultureInfo.InvariantCulture),
                slCaiLenh.ToString(CultureInfo.InvariantCulture),
                soCa.ToString(CultureInfo.InvariantCulture),
                maCaKt,
                ngayKt.ToString(DATE_FORMAT),
                baseWhere);
        }
        else
        {
            // ✅ ma_ca EXISTS but ngay_bd does NOT → Update ma_ca_kt but NOT ngay_kt
            return string.Format(
                "UPDATE {0} SET sl_kg_lenh = {1}, sl_cai_lenh = {2}, " +
                "so_ca_lenh = {3}, ma_ca_kt = '{4}'{5}",
                TABLE_NAME,
                slKgLenh.ToString(CultureInfo.InvariantCulture),
                slCaiLenh.ToString(CultureInfo.InvariantCulture),
                soCa.ToString(CultureInfo.InvariantCulture),
                maCaKt,
                baseWhere);
        }
    }


