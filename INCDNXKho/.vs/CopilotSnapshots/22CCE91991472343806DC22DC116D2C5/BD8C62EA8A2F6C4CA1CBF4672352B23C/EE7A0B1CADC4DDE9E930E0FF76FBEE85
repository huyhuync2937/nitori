    private class UpdateData
    {
        public string FieldName { get; set; }
        public string NewValue { get; set; }
        public decimal Quantity { get; set; }
        public DataRowView[] SelectedRows { get; set; }
        public DataRecord Record { get; set; }
    }

    private static UpdateData ExtractUpdateData(FrmSetValue frm, CellInfo cellInfo)
    {
        string fieldName = SafeToString(frm.cbField.Value).Trim();
        DataView dataView = StartUp.oBrowse.DataGrid.DataSource as DataView;

        DataTable distinctValues = dataView.ToTable(true,
            FieldNames.CHON, FieldNames.MA_NVL_GOP, FieldNames.VUNG_MAY,
            FieldNames.NHOM_MAY, FieldNames.NGAY_BD, FieldNames.SO_CA,
            FieldNames.MA_MAY, FieldNames.SS, FieldNames.MA_CA,
            FieldNames.SL_KG_LENH, FieldNames.SL_CAI_LENH, FieldNames.NSC, FieldNames.SO_CA_LENH, FieldNames.ID);

        List<DataRowView> selectedRowsList = new List<DataRowView>();
        foreach (DataRowView row in distinctValues.DefaultView)
        {
            bool isSelected = (bool)row[FieldNames.CHON];
            if (isSelected)
                selectedRowsList.Add(row);
        }

        string newValue = GetFieldValue(fieldName, frm);
        decimal quantity = GetQuantityValue(fieldName, frm);

        // Validate before returning
        if (fieldName == FieldNames.NGAY_BD || fieldName == FieldNames.NGAY_KT || fieldName == FieldNames.MA_CA)
            ValidateDateConflict(selectedRowsList.ToArray(), cellInfo.Record, newValue, fieldName);

        UpdateData updateData = new UpdateData();
        updateData.FieldName = fieldName;
        updateData.NewValue = newValue;
        updateData.Quantity = quantity;
        updateData.SelectedRows = selectedRowsList.ToArray();
        updateData.Record = cellInfo.Record;

        return updateData;
    }

    private static string GetFieldValue(string fieldName, FrmSetValue frm)
    {
        if (fieldName == FieldNames.NGAY_BD || fieldName == FieldNames.NGAY_KT)
            return frm.txtNgay_bd.dValue.ToString(DATE_FORMAT);
        else
            return frm.txtNewValue.Text.Trim();
    }

    private static decimal GetQuantityValue(string fieldName, FrmSetValue frm)
    {
        if (fieldName == FieldNames.SL_CAI_LENH || fieldName == FieldNames.SL_KG_LENH)
            return Convert.ToDecimal(frm.txtsl.Value);
        if (fieldName == FieldNames.ID)
            return Convert.ToInt32(frm.txtsl.Value);
        return 0;
    }

