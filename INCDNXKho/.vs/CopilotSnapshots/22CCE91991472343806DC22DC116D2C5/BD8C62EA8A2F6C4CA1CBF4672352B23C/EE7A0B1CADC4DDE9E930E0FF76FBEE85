    public static DataRow GetDVTKL(string ma_sp)
    {
        string sql = "SELECT * FROM v_dmvtdvt WHERE ma_vt = @ma_sp and hs_qd <> 1 ";

        using (SqlCommand sqlCommand = new SqlCommand(sql))
        {
            sqlCommand.Parameters.Add("@ma_sp", SqlDbType.Char, 16).Value = ma_sp;

            DataSet dataSet = StartupBase.SasObj.ExcuteReader(sqlCommand);
            return (dataSet.Tables.Count > 0 && dataSet.Tables[0].Rows.Count > 0)
                ? dataSet.Tables[0].Rows[0]
                : null;
        }
    }

    public static string GetCaKetThuc(double soCa, string ma_ca)
    {
        int ca = (int)Math.Ceiling(soCa); // làm tròn lên

        int startIndex;
        if (ma_ca == "CA01")
            startIndex = 1;
        else if (ma_ca == "CA02")
            startIndex = 2;
        else if (ma_ca == "CA03")
            startIndex = 3;
        else
            startIndex = 1;

        int totalCa = startIndex - 1 + ca;

        int index = ((totalCa - 1) % 3) + 1;

        if (index == 1)
            return "CA01";
        else if (index == 2)
            return "CA02";
        else
            return "CA03";
    }


    public static DateTime GetNgayKetThuc(double soCa, DateTime ngay_bd, string ma_ca)
    {

        int startIndex;
        switch (ma_ca)
        {
            case "CA01":
                startIndex = 1;
                break;
            case "CA02":
                startIndex = 2;
                break;
            case "CA03":
                startIndex = 3;
                break;
            default:
                startIndex = 1;
                break;
        }

        int totalCa = startIndex - 1 + (int)Math.Ceiling(soCa);

        int soNgayTang = (totalCa - 1) / 3;

        return ngay_bd.AddDays(soNgayTang);
    }
    private static bool TryParseDate(string value, out DateTime result)
    {
        result = DateTime.MinValue;

        if (string.IsNullOrEmpty(value))
            return false;

        value = value.Trim();

        // format: 20260501
        if (DateTime.TryParseExact(
                value,
                "yyyyMMdd",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out result))
        {
            return true;
        }

        // fallback
        return DateTime.TryParse(value, out result);
    }

