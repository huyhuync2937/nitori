    // Main entry point
    public static void Execute()
    {
        try
        {
            // Validation
            if (!ValidatePrerequisites())
                return;

            CellInfo cellInfo = ExtractCellInfo();
            if (cellInfo == null)
                return;

            FrmSetValue frmSetValue = CreateAndConfigureForm(cellInfo.Value.ToString(), cellInfo.FieldName);

            if (!ShowFormDialog(frmSetValue))
                return;

            if (!ConfirmUpdate())
                return;

            UpdateData updateData = ExtractUpdateData(frmSetValue, cellInfo);
            ExecuteUpdates(updateData);
        }
        catch (Exception ex)
        {
            HandleException(ex);
        }
    }

    #region Validation Methods

    private static bool ValidatePrerequisites()
    {
        return StartUp.CanChangeValueFields != null &&
               StartUp.CanChangeValueFields.Length > 0 &&
               StartUp.oBrowse.frmBrw.oBrowse.ActiveCell != null;
    }

    private static bool IsValidEditableField(string fieldName)
    {
        string[] validFields = new[]
        {
            FieldNames.NGAY_BD, FieldNames.MA_MAY, FieldNames.MA_CA,
            FieldNames.NGAY_KT, FieldNames.MA_CA_KT, FieldNames.SL_KG_LENH,
            FieldNames.SL_CAI_LENH,FieldNames.ID
        };

        foreach (string field in validFields)
        {
            if (field == fieldName)
                return true;
        }
        return false;
    }

    private static bool CanChangeField(string fieldName)
    {
        foreach (string field in StartUp.CanChangeValueFields)
        {
            if (field == fieldName)
                return true;
        }
        return false;
    }

    #endregion

    #region Cell Info Extraction

    private class CellInfo
    {
        public string FieldName { get; set; }
        public object Value { get; set; }
        public DataRecord Record { get; set; }
    }

    private static CellInfo ExtractCellInfo()
    {
        Cell cell = StartUp.oBrowse.frmBrw.oBrowse.ActiveCell;
        string fieldName = cell.Field.Name.ToString();

        if (!IsValidEditableField(fieldName))
            return null;

        if (StartUp.oBrowse.ActiveRecord != null)
        {
            EndEditMode();
            StartUp.oBrowse.ActiveRecord.Update();
        }

        CellInfo cellInfo = new CellInfo();
        cellInfo.FieldName = fieldName;
        cellInfo.Value = CanChangeField(fieldName) ? cell.Value : "";
        cellInfo.Record = cell.Record as DataRecord;

        return cellInfo;
    }

    private static void EndEditMode()
    {
        Cell activeCell = StartUp.oBrowse.DataGrid.ActiveCell;
        if (activeCell != null && activeCell.IsInEditMode)
            activeCell.EndEditMode();
    }

