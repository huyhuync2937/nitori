    private static string GetCellString(DataRecord record, string fieldName)
    {
        if (record == null || record.Cells[fieldName] == null)
            return "";

        object value = record.Cells[fieldName].Value;
        return value != null ? value.ToString().Trim() : "";
    }

    private static DateTime GetCellDateTime(DataRecord record, string fieldName, DateTime defaultValue)
    {
        string value = GetCellString(record, fieldName);
        if (string.IsNullOrEmpty(value))
            return defaultValue;

        try
        {
            return Convert.ToDateTime(value);
        }
        catch
        {
            return defaultValue;
        }
    }

    private static double GetCellDouble(DataRecord record, string fieldName)
    {
        string value = GetCellString(record, fieldName);
        if (string.IsNullOrEmpty(value))
            return 0;

        double result = 0;
        double.TryParse(value, out result);
        return result;
    }

    private static double GetRowDouble(DataRowView row, string fieldName)
    {
        object value = row[fieldName];
        if (value == null)
            return 0;

        double result = 0;
        double.TryParse(value.ToString(), out result);
        return result;
    }

