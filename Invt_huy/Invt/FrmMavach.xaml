<smc:FormList x:Class="Invt.FrmMavach"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sys="clr-namespace:System;assembly=mscorlib"
          xmlns:smc="http://sis.vn/SasControls"
          xmlns:SasFormReport="clr-namespace:SasFormReport;assembly=SasFormReport"
          xmlns:igEditors="http://infragistics.com/Editors"
          xmlns:local="clr-namespace:Invt" Loaded="FrmMavach_Loaded"
          x:Name="frmMavach" LanguageID="Invt_mavach" EscToClose="true" Title="Khai báo thông tin mã vạch" 
          Height="280" Width="740">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <smc:NegativeConverter x:Key="mau_bcConverter"/>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:ConfirmGridView OnCancel="Mavach_ConfirmGV_OnCancel" OnOk="Mavach_ConfirmGridView_OnOk">
        <smc:GridLayout Name="gridMain" RowCount="7" RowHeights="25,25,25,25,7,25,80,*" ColumnCount="6" ColumnWidths="*,140,12,*,12,140"  Margin="12,12,12,0">
            <TextBlock Name="lblMa_vt" Grid.Row="0" Grid.Column="0" Text="Mã vật tư" Style="{StaticResource ContentTextStyle}" />
            <TextBox x:Name="txtma_vt" Grid.Column="1" Grid.Row="0" TabIndex="1"
                     CharacterCasing="Upper" IsReadOnly="True" Text="{smc:BindingEx ma_vt}"/>
            <TextBlock Name="txtTen_vt" Grid.Row="0" Grid.Column="3" Text="{smc:BindingEx ten_vt}" TextWrapping="NoWrap" Margin="12,0,0,0"/>

            <TextBlock Name="tblDvt" Text="Đơn vị tính" Grid.Row="1" Grid.Column="0" Style="{StaticResource ContentTextStyle}"/>
            <TextBox x:Name="txtDvt" Grid.Column="1" Grid.Row="1" TabIndex="2" Text="{smc:BindingEx dvt}"/>

            <TextBlock Name="lblSl_sp" Grid.Row="2" Grid.Column="0" Text="Số lượng"/>
            <smc:NumericTextBox GotFocus="txtNum_GotFocus" LostFocus="txtLostFocus" Name="txtSl_sp" Grid.Column="1"
                            Grid.Row="2" IsReadOnly="False" TabIndex="3"
                            Value="{smc:BindingEx sl_sp}"/>
            <TextBlock Name="lblGia_sp" Grid.Row="3" Grid.Column="0" Text="Giá bán"/>
            <smc:NumericTextBox GotFocus="txtNum_GotFocus" LostFocus="txtLostFocus" Name="txtGia_sp" Grid.Column="1"
                            Grid.Row="3" IsReadOnly="False" TabIndex="4"
                            Value="{Binding gia_sp}"/>

            <Separator Background="#FFCACACA" Grid.Row="4" Margin="0,0,12,0" Grid.ColumnSpan="6" HorizontalAlignment="Stretch"/>

            <TextBlock Name="lblSl_tem" Grid.Row="5" Grid.Column="0" Text="Số lượng tem"/>
            <smc:NumericTextBox GotFocus="txtSl_tem_GotFocus" Name="txtSl_tem" Grid.Row="5" Grid.Column="1" 
                          TabIndex="5" Mask="{}{number:1-9999}" ValueType="{x:Type sys:Int32}"
                          Value="{smc:BindingEx sl_tem}">
                <igEditors:ValueEditor.ValueConstraint>
                    <igEditors:ValueConstraint MinInclusive="1" Nullable="False" MaxInclusive="9999"/>
                </igEditors:ValueEditor.ValueConstraint>
            </smc:NumericTextBox>
            <Image x:Name="imageViewerBmp" Stretch="Uniform" Grid.Column="1" Grid.Row="6" Height="80" />
        </smc:GridLayout>
    </smc:ConfirmGridView>
</smc:FormList>
