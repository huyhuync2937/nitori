<smc:Form x:Class="SasPermission.FrmLogin"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:smc="http://sis.vn/SasControls"
          LanguageID="SasPermission_0" EscToClose="true" Height="143" Width="430">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk">
    <GroupBox Name="GroupInfo" Margin="12,4,12,0">
      <smc:GridLayout Name="gridMain" ColumnCount="2" ColumnWidths="*,140">
        <TextBlock Name="tblpassword" Text="Gõ vào mật khẩu đăng nhập hệ thống" Grid.Column="0"/>
        <PasswordBox x:Name="txtPassword" Grid.Column="1" Width="140" Height="20" HorizontalAlignment="Left"/>
      </smc:GridLayout>
    </GroupBox>
  </smc:ConfirmGridView>
</smc:Form>