                    <TextBlock Name="tblngay_lsx" Text="Ngày ksx" Grid.Row="0" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:DateTextBox x:Name="txtngay_lsx" Grid.Column="1" Grid.Row="0" TabIndex="30"
