<smc:Form x:Class="COSXKSX.KSXW.FrmTaoPXNVL"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:smc="clr-namespace:SasControls;assembly=SasControls"
          Loaded="Form_Loaded" Height="470" LanguageID="COSXLSX.LSX_XNVL" Width="700" Title="Tao phieu xuat kho">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid>
        <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" OnCancel="ConfirmGridView_OnCancel" Name="GrdOkCancel">
            <GroupBox Name="Grdgroup" Margin="12,4,12,0" Style="{StaticResource NonHeaderGroupBoxStyle}">
                <smc:GridLayout Name="GrdInfo" RowCount="13" ColumnCount="5" ColumnWidths="120,140,120,*">
                    <TextBlock Name="tblma_bpht" Text="Mã bppht" Grid.Column="0" Grid.Row="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_bpht_PreviewLostFocus"  Name="txtMa_bpht" AllowEmty="false" AllowWrong="false"
                                   Grid.Column="1" Grid.Row="0" TabIndex="0" SelectAllOnFocus="true" ListID="dmbpht"
                                   Text="{smc:BindingEx ma_bpht_i}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
                    <TextBlock Name="txtTen_bpht" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}"/>

                    <TextBlock Name="tblma_kh" Text="Mã khách" Grid.Column="0" Grid.Row="1"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_kh_PreviewLostFocus" Name="txtMa_kh" AllowEmty="false" AllowWrong="false"
                                   Grid.Column="1" Grid.Row="1" TabIndex="5" SelectAllOnFocus="true" ListID="dmkh"
                                   Text="{smc:BindingEx ma_kh}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
                    <TextBlock Name="txtTen_kh" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}"/>

                    <TextBlock Name="tblma_gd" Text="Mã gd" Grid.Column="0" Grid.Row="2" Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_gd_PreviewLostFocus" Name="txtMa_gd" AllowEmty="false" AllowWrong="false"
                                   Grid.Column="1" Grid.Row="2" TabIndex="10" SelectAllOnFocus="true" ListID="dmmagd"
                                   Text="{smc:BindingEx ma_gd}"
                                   Filter = "ma_ct = 'PXD' and status = 1 and ma_gd IN ('4')"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
                    <TextBlock Name="txtTen_gd" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBlock Name="tblma_qs" Text="Quyển c.từ" Grid.Column="0" Grid.Row="3"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_qs_PreviewLostFocus" x:Name="txtMa_qs" Grid.Column="1" Grid.Row="3"
                                   TabIndex="10" AllowEmty="false" AllowWrong="false" ListID="dmqs"
                                   Text="{smc:BindingEx ma_qs}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="tblso_ct" Text="Số phiếu xuất" Grid.Column="0" Grid.Row="4"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox Name="txtso_ct" Grid.Column="1" Grid.Row="4" 
                             Text="{smc:BindingEx so_ct}"
                             TabIndex="15"/>
                    <TextBlock Name="tblma_nt" Text="Mã n.tệ" Grid.Column="0" Grid.Row="5"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox Name="txtMa_nt" Grid.Column="1" Grid.Row="5" AllowEmty="false" AllowWrong="false" ListID="dmnt"
                                   TabIndex="20"  Text="{smc:BindingEx ma_nt}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="tblOng_ba" Text="Người nhận hàng" Grid.Column="0" Grid.Row="6"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox Name="txtOng_ba" Grid.Column="1" Grid.Row="6" 
                             Text="{smc:BindingEx ong_ba}"  TabIndex="30"/>
                    <TextBlock Name="tblDien_giai" Text="Diễn giải" Grid.Column="0" Grid.Row="7"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox Name="txtDien_giai" Grid.Column="1" 
                             Text="{smc:BindingEx dien_giai}"
                             TabIndex="35" Grid.ColumnSpan="3" Grid.Row="7"/>

                    <TextBlock Name="tblma_kho" Text="Mã kho" Grid.Column="0" Grid.Row="8" Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_kho_PreviewLostFocus" Name="txtMa_kho" AllowEmty="false" AllowWrong="false"
                                   Grid.Column="1" Grid.Row="8" TabIndex="40" SelectAllOnFocus="true" ListID="dmkho"
                                             Text="{smc:BindingEx ma_kho}"
                                             Filter="{Binding DK_MA_DVCS, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
                    <TextBlock Name="txtTen_kho" Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                               Style="{StaticResource ContentTextStyle}"/>

                    <TextBlock Name="tblma_nx" Text="Mã nx (tk nợ)" Grid.Row="9" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_nx_PreviewLostFocus" x:Name="txtMa_nx" Grid.Column="1"
                                   Grid.Row="9" TabIndex="40" AllowEmty="True" AllowWrong="false" ListID="dmnx"
                                  Text="{smc:BindingEx ma_nx}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>

                    <TextBlock Name="tblTenNX" Grid.Row="9" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}" Text="{smc:BindingEx Path=ten_nx, Path2=ten_nx2}"/>

                    <TextBlock  Text="Mã tự do" Grid.Column="0" Grid.Row="10"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_tudo_PreviewLostFocus"  Name="txtMa_tudo" AllowEmty="True" AllowWrong="false"
                                   Grid.Column="1" Grid.Row="10" TabIndex="41" SelectAllOnFocus="true" ListID="dmtd"
                                   Text="{smc:BindingEx ma_td_i}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
                    <TextBlock Name="txtTen_tudo" Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}"/>

                    <TextBlock  Text="Mã tự do 2" Grid.Column="0" Grid.Row="11"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_tudo2_PreviewLostFocus"  Name="txtMa_tudo2" AllowEmty="True" AllowWrong="false"
                                   Grid.Column="1" Grid.Row="11" TabIndex="42" SelectAllOnFocus="true" ListID="dmtd2"
                                   Text="{smc:BindingEx ma_td2_i}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
                    <TextBlock Name="txtTen_tudo2" Grid.Row="11" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBlock  Text="Mã tự do 3" Grid.Column="0" Grid.Row="12"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_tudo3_PreviewLostFocus"  Name="txtMa_tudo3" AllowEmty="True" AllowWrong="false"
                                   Grid.Column="1" Grid.Row="12" TabIndex="43" SelectAllOnFocus="true" ListID="dmtd3"
                                   Text="{smc:BindingEx ma_td3_i}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
                    <TextBlock Name="txtTen_tudo3" Grid.Row="12" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}"/>
                </smc:GridLayout>
            </GroupBox>
        </smc:ConfirmGridView>
    </Grid>
</smc:Form>