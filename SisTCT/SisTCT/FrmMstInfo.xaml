<smc:Form  x:Class="SisTCT.FrmMstInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SisTCT" 
        xmlns:smc="http://sis.vn/SasControls" 
        xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors;assembly=InfragisticsWPF3.Editors.v10.2"
        Title="Thong tin doanh nghiep" 
           LanguageID="FrmMstInfo_0" Width="650" Height="382" 
           WindowStartupLocation="Manual" Loaded="FormList_Loaded" Closed="FormList_Closed">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <smc:EditModeBindingObject x:Key="IsInEditMode" IsEditMode="False" />
           
            <Style x:Key="MaskedTextBoxReadOnly" TargetType="{x:Type smc:MaskedTextBox}"
             BasedOn="{StaticResource MaskedTextBoxStyle}">
                <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnly" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                <Setter Property="TextBoxBase.IsReadOnly" Value="True" />
                <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnlyNumericTextBox" TargetType="{x:Type smc:NumericTextBox}" BasedOn="{StaticResource NumericTextBoxStyle}">
                <Setter Property="IsReadOnly" Value="True" />
                <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}">
                        <Setter Property="IsReadOnly" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AutoCompleteReadOnly" TargetType="{x:Type smc:AutoCompleteTextBox}" BasedOn="{StaticResource AutoCompleteTextBoxStyle}">
                <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="True" />
                <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}">
                        <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:ConfirmGridView Name="ConfirmGV" OnCancel="ConfirmGV_OnCancel" OnOk="ConfirmGV_OnOk">
        <smc:GridLayout Margin="0,0,0,0">
            <smc:GridLayout RowCount="2" RowHeights="40,275,*" ColumnCount="1" ColumnWidths="*">
                <StackPanel>
                    <smc:GridLayout RowCount="1" RowHeights="40" ColumnCount="3" ColumnWidths="120,160,*" Margin="12,0,0,0">
                        <TextBlock Name="tblma_so_thue" Text="Mã số thuế" />
                        <TextBox Name="txtma_so_thue" Grid.Column="1" Width="140" HorizontalAlignment="Left" Style="{StaticResource ReadOnly}" />
                    </smc:GridLayout>
                </StackPanel>
                <StackPanel Grid.Row="1" Background="#FFFFFFFF" Margin="12,0,12,0">
                    <Border BorderBrush="#FFD3D3D3" BorderThickness="1">
                        <smc:GridLayout Name="GrdLayoutContent" RowCount="9" RowHeights="50,25,25,50,25,25,25,25,25,*" ColumnCount="3" ColumnWidths="120,160,*">
                            <TextBlock Name="txtten_cong_ty" Text="" Margin="12,0,0,0" TextWrapping="Wrap" Grid.ColumnSpan="3" FontWeight="Bold" />
                            <Border Grid.Row="1" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="0,1,0,1">
                                <TextBlock Name="tbltinh_trang1" Text="Tình trạng" FontWeight="Bold" Foreground="#FFFF0000" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Padding="12,0,0,0" Grid.ColumnSpan="3" BorderBrush="#FFD3D3D3" BorderThickness="1,1,0,1">
                                <TextBlock Name="txttinh_trang1" Text="" FontWeight="Bold" Foreground="#FFFF0000" TextWrapping="Wrap" />
                            </Border>
                            <Border Name="borderTenVietTat" Grid.Row="2" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="0,1,0,1">
                                <TextBlock Name="tblten_viet_tat" Text="Tên viết tắt" />
                            </Border>
                            <Border Name="borderTenVietTat1" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="1,1,0,1">
                                <TextBlock Name="txtten_viet_tat" Text="" />
                            </Border>
                            <Border Grid.Row="3" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="0,0,0,1">
                                <TextBlock Name="tbldia_chi" Text="Địa chỉ" />
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="1,0,0,1">
                                <TextBlock Name="txtdia_chi" Text="" TextWrapping="Wrap" />
                            </Border>
                            <Border Grid.Row="4" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="0,0,0,1">
                                <TextBlock Name="tblnguoi_dai_dien" Text="Người đại diện" />
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" Padding="12,0,0,0" Grid.ColumnSpan="3" BorderBrush="#FFD3D3D3" BorderThickness="1,0,0,1">
                                <TextBlock Name="txtnguoi_dai_dien" Text="" TextWrapping="Wrap" />
                            </Border>
                            <Border Grid.Row="5" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="0,0,0,1">
                                <TextBlock Name="tbldien_thoai" Text="Điện thoại" />
                            </Border>
                            <Border Grid.Row="5" Grid.Column="1" Padding="12,0,0,0" Grid.ColumnSpan="3" BorderBrush="#FFD3D3D3" BorderThickness="1,0,0,1">
                                <TextBlock Name="txtdien_thoai" Text="" TextWrapping="Wrap" />
                            </Border>
                            <Border Grid.Row="6" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="0,0,0,1">
                                <TextBlock Name="tblngay_thanh_lap" Text="Ngày thành lập" />
                            </Border>
                            <Border Grid.Row="6" Grid.Column="1" Padding="12,0,0,0" Grid.ColumnSpan="3" BorderBrush="#FFD3D3D3" BorderThickness="1,0,0,1">
                                <TextBlock Name="txtngay_thanh_lap" Text="" TextWrapping="Wrap" />
                            </Border>
                            <Border Name="borderTenQuocTe" Grid.Row="7" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="0,0,0,1">
                                <TextBlock Name="tblten_quoc_te" Text="Tên quốc tế" />
                            </Border>
                            <Border Name="borderTenQuocTe1" Grid.Row="7" Grid.Column="1" Padding="12,0,0,0" Grid.ColumnSpan="3" BorderBrush="#FFD3D3D3" BorderThickness="1,0,0,1">
                                <TextBlock Name="txtten_quoc_te" Text="" TextWrapping="Wrap" />
                            </Border>
                            <Border Grid.Row="8" Padding="12,0,0,0" BorderBrush="#FFD3D3D3" BorderThickness="0">
                                <TextBlock Name="tbltinh_trang" Text="Tình trạng" FontWeight="Bold" Foreground="#FFFF0000" />
                            </Border>
                            <Border Grid.Row="8" Grid.Column="1" Padding="12,0,0,0" Grid.ColumnSpan="3" BorderBrush="#FFD3D3D3" BorderThickness="1,0,0,0">
                                <TextBlock Name="txttinh_trang" Text="" FontWeight="Bold" Foreground="#FFFF0000" TextWrapping="Wrap" />
                            </Border>
                        </smc:GridLayout>
                    </Border>
                </StackPanel>
            </smc:GridLayout>
        </smc:GridLayout>
    </smc:ConfirmGridView>
</smc:Form>