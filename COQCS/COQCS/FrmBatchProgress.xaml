<Window x:Class="COQCS.FrmBatchProgress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiến trình chạy QCS" Height="420" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="True"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblStatus" Grid.Row="0" FontWeight="Bold" Margin="0,0,0,6" Text="Đang chuẩn bị..."/>

        <ProgressBar x:Name="pbProgress" Grid.Row="1" Height="22" Minimum="0" Maximum="100" Value="0"/>

        <TextBlock x:Name="lblDetail" Grid.Row="2" Margin="0,6,0,6" Text=""/>

        <GroupBox Grid.Row="3" Header="Danh sách mã lỗi">
            <ListView x:Name="lvErrors">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Mã vật tư" Width="150" DisplayMemberBinding="{Binding MaVt}"/>
                        <GridViewColumn Header="Loại" Width="110" DisplayMemberBinding="{Binding Loai}"/>
                        <GridViewColumn Header="Worker" Width="60" DisplayMemberBinding="{Binding Worker}"/>
                        <GridViewColumn Header="Lỗi" Width="300" DisplayMemberBinding="{Binding Loi}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnClose" Content="Đóng" Width="90" Height="28" IsEnabled="False" Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
