		private static bool ShowTrung(DataSet dsResult, string fields_trung, string fields_long)
		{
			int num = 0;
			if (dsResult.Tables.Count > 0 && dsResult.Tables[0].Rows.Count > 0)
			{
				if (StartUp.waiting != null)
				{
					StartUp.waiting.Close();
				}
				FormBrowse formBrowse = new FormBrowse(StartupBase.SasObj, dsResult.Tables[0].DefaultView, fields_trung + ";lan:H=Số dòng bị trùng");
				formBrowse.frmBrw.Title = (StartupBase.M_LAN.Equals("V") ? SysFunc.Cat_Dau("Những mã trùng từ dữ liệu Excel") : "The same code excel data");
				formBrowse.frmBrw.LanguageID = "SasIeDm_5";
				formBrowse.ShowDialog();
				num++;
			}
			if (dsResult.Tables.Count > 1 && dsResult.Tables[1].Rows.Count > 0)
			{
				if (StartUp.waiting != null)
				{
					StartUp.waiting.Close();
				}
				FormBrowse formBrowse = new FormBrowse(StartupBase.SasObj, dsResult.Tables[1].DefaultView, fields_long);
				formBrowse.frmBrw.Title = (StartupBase.M_LAN.Equals("V") ? SysFunc.Cat_Dau("Những mã lòng nhau") : "The nested code");
				formBrowse.frmBrw.LanguageID = "SasIeDm_6";
				formBrowse.ShowDialog();
				num++;
			}
			return num == 0;
		}

