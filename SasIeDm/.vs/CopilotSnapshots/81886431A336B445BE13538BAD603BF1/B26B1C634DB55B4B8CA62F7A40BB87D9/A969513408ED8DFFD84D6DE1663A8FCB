		public static string GetImexMessage(string M_LAN, string ma_imex, string stt, int flag)
		{
			string empty = string.Empty;
			DataRow[] array = StartUp.dtImexMessage.Select($"ma_imex = '{ma_imex.Trim()}' and stt = '{stt.Trim()}'");
			if (M_LAN.Equals("V"))
			{
				if (flag == 0)
				{
					return array[0]["field"].ToString().Trim();
				}
				return array[0]["title"].ToString().Trim();
			}
			if (flag == 0)
			{
				return array[0]["field2"].ToString().Trim();
			}
			return array[0]["title2"].ToString().Trim();
		}
	}
