<smc:Form x:Class="SasIeDm.FrmWaiting"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:sys="clr-namespace:System;assembly=mscorlib" 
          xmlns:smc="http://sis.vn/SasControls" 
          x:Name="FrmWaitingExecute"
          Height="218" Width="427" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="NoResize" LanguageID="SasIeDm_1">
    <Grid Height="121" Width="314">
        <Border Background="#FFFFFFFF" BorderBrush="#FFFFEBCD" BorderThickness="2" CornerRadius="5" Padding="5" Margin="0,0,0,12">
            <HeaderedContentControl>
                <HeaderedContentControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.ColumnSpan="2" Fill="AntiqueWhite" />
                        <TextBlock Name="txtVer" Grid.Column="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="3" Text="Sas Innova 20" />
                    </Grid>
                </HeaderedContentControl.Header>
                <ContentControl.Content>
                    <smc:GridLayout RowCount="4" RowHeights="12,25,25,12" ColumnCount="3" ColumnWidths="12,*,12">
                        <TextBlock Name="lblMessage" Text="Đang thực hiện ..." Grid.Row="1" Grid.Column="1" />
                        <ProgressBar Name="PBar" Grid.Row="2" Grid.Column="1" IsIndeterminate="False" />
                    </smc:GridLayout>
                </ContentControl.Content>
            </HeaderedContentControl>
        </Border>
    </Grid>
</smc:Form>
