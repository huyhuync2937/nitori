                    <TextBox Name="txtNhom_hh" Grid.Column="1" Grid.Row="5" FontWeight="Normal" Grid.ColumnSpan="4" Height="20"
                   Style="{StaticResource TextBoxEditModeEnable}" TabIndex="0" Text="{smc:BindingEx Path=ten_vtthue}"/>
                </smc:GridLayout>
            </GroupBox>
            <GroupBox Name="gbVoucher" Header="Chứng từ" Grid.Column="4" Grid.Row="0">
                <smc:GridLayout Name="GrdVoucher" ColumnCount="2" ColumnWidths="*,140" RowCount="7"
                        RowHeights="25,25,25,25,25,25,25">
                    <TextBlock Name="tblngay_ct" Text="Ngày ht" Grid.Column="0" Grid.Row="0"
                     Style="{StaticResource ContentTextStyle}"/>
