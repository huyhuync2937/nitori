                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                                <Setter Property="TextBoxBase.IsReadOnly">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource ReadOnlyConverter}" ConverterParameter="PH;ong_ba">
                                            <Binding Mode="OneWay" Source="{StaticResource IsInEditMode}" Path="Value"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Control.IsTabStop" Value="true"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsReadOnly, ElementName=txtOng_ba}" Value="True">
                                        <Setter Property="Control.IsTabStop" Value="false"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </FrameworkElement.Style>
                    </TextBox>
                    <TextBlock Name="tblSoDuKH" Text="Số dư" Grid.Row="2" Grid.Column="3" Margin="10,0,0,0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:NumericTextBox x:Name="txtSoDuKH" Grid.Column="4" Grid.Row="2" IsTabStop="false" IsReadOnly="true"
                              Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>
                    <TextBlock Name="tbldien_giai" Text="Diễn giải" Grid.Row="3" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox Name="txtDien_giai" TabIndex="30" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="4" Height="20"
                   FontWeight="Normal" Style="{StaticResource TextBoxEditModeEnable}"
                   Text="{smc:BindingEx Path=dien_giai}"/>
                    <TextBlock Name="tblma_nx" Text="Mã nx (tk nợ)" Grid.Row="4" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_nx_PreviewLostFocus" x:Name="txtMa_nx" Grid.Column="1" Grid.Row="4"
                                   TabIndex="40" AllowEmty="false" AllowWrong="false" ListID="dmnx"
                                   Style="{StaticResource AutoCompleteTextBoxEditModeEnable}" Text="{smc:BindingEx Path=ma_nx}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="txtTen_nx" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0"
                     Style="{StaticResource ContentTextStyle}" Text="{smc:BindingEx Path=ten_nx, Path2=ten_nx2}"/>

                    <TextBlock Name="tblma_nm" Text="Mã nhà máy" Grid.Row="4" Grid.Column="3" 
     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox Name="txtMa_nm" Grid.Column="4" Grid.Row="4"
                   TabIndex="10" AllowEmty="false" AllowWrong="false" ListID="dmtd3"
                   Style="{StaticResource AutoCompleteTextBoxEditModeEnable}" Text="{smc:BindingEx Path=ma_td1}"
                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smvc:FormTrans}}"
                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smvc:FormTrans}}"/>



                    <TextBlock Name="lbNhom_hh" Grid.Column="0" Grid.Row="5" Style="{StaticResource ContentTextStyle}"
