<smvc:FormTrans x:Class="Poctpxf.FrmPoctpxf"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:src="clr-namespace:Poctpxf"
                xmlns:igWindows="http://infragistics.com/Windows"
                xmlns:smc="http://sis.vn/SasControls"
                xmlns:smvc="clr-namespace:SasVoucherLib;assembly=SasVoucherLib"
                xmlns:System="clr-namespace:System;assembly=mscorlib"
                xmlns:igEditors="http://infragistics.com/Editors"
                xmlns:igDP="http://infragistics.com/DataPresenter"
                xmlns:diagnostics="clr-namespace:System.Diagnostics;assembly=WindowsBase"
                xmlns:igThemes="http://infragistics.com/Themes"
                Cm_Moi="V_Moi" Cm_Sua="V_Sua" Cm_Nhan="V_Nhan" Cm_Xoa="V_Xoa" Cm_In="V_In" Cm_Huy="V_Huy"
                Cm_Tim="V_Tim" Cm_Xem="V_Xem" Cm_Copy="V_Copy" Cm_Truoc="V_Previous" Cm_Sau="V_Next" Cm_Dau="V_Top"
                Cm_Cuoi="V_Bottom" Cm_HuyHD="V_HuyHD" EditModeEnded="FormMain_EditModeEnded" Name="FormMain"
                AssignMaxLengthControlList="txtSo_ct;txtDia_chi;txtOng_ba;txtDien_giai;txtGhi_chu;txtNhom_hh;txtSo_seri;txtghi_chu"
                LanguageID="PoctpxfMain" Height="680" Width="1000" Theme="Voucher">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <smvc:BindingVisibility x:Key="VisibilityConverter"/>
            <smvc:FormatMaskNumberConverter x:Key="MaskNumeric"/>
            <smvc:BindingStatusVoucher x:Key="StatusVoucher"/>
            <smc:CheckBoxConverter x:Key="IsCheckedConverter"/>
            <smc:BoolInverter x:Key="BoolInverter"/>
            <src:BindingReadOnly x:Key="ReadOnlyConverter"/>
            <src:BindingFilter x:Key="FilterConverter"/>
            <src:BindingTabStop x:Key="IsTabStop"/>
            <src:BindingFormatTonKho x:Key="BindingFormatTonKho"/>
            <smc:CodeValueBindingObject x:Key="IsCheckedPx_gia_dd" Value="False" />
            <smc:CodeValueBindingObject x:Key="Voucher_Ma_nt0" Value="false"/>
            <smc:CodeValueBindingObject x:Key="IsInEditMode" Value="false"/>
            <smc:CodeValueBindingObject x:Key="IsCheckedSua_tien" Value="false"/>
            <smc:CodeValueBindingObject x:Key="Ty_Gia_ValueChange" Value="false"/>
            <smc:CodeValueBindingObject x:Key="Voucher_Lan0" Value="false"/>
            <Style x:Key="ButtonEditModeDisable" TargetType="{x:Type Button}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="UIElement.IsEnabled" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MaskedTextBoxReadOnly" TargetType="{x:Type smc:MaskedTextBox}"
             BasedOn="{StaticResource MaskedTextBoxStyle}">
                <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ButtonEditModeEnable" TargetType="{x:Type Button}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="UIElement.IsEnabled" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TextBoxEditModeEnable" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AutoCompleteTextBoxEditModeEnable" TargetType="{x:Type smc:AutoCompleteTextBox}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="XamMaskedEditorEditModeEnable" TargetType="{x:Type igEditors:XamMaskedEditor}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NumericTextBoxrEditModeEnable" TargetType="{x:Type smc:NumericTextBox}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CheckBoxEditModeEnable" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="UIElement.IsEnabled" Value="false"/>
                        <Setter Property="Control.Foreground" Value="Black"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CheckBoxEditModeEnable2" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBoxStyle}">
                <Setter Property="IsEnabled" Value="False" />
                <Style.Triggers>
                    <DataTrigger Value="False" Binding="{smc:BindingEx IsEnabled, RelativeSource={x:Static RelativeSource.Self}}">
                        <Setter Property="Foreground" Value="#FF000000" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DateTextBoxEditModeEnable" TargetType="{x:Type smc:DateTextBox}"
             BasedOn="{StaticResource DateTextBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}"
                       Value="False">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ComboBoxEditModeEnable" TargetType="{x:Type igEditors:XamComboEditor}"
             BasedOn="{StaticResource XamComboEditorStyle}">
                <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_act"/>
                <Setter Property="UIElement.IsEnabled" Value="false"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="False"/>
                            <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type smvc:FormTrans}}}"
                         Value="E"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_act2"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="True"/>
                            <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type smvc:FormTrans}}}"
                         Value="V"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_post"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="True"/>
                            <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type smvc:FormTrans}}}"
                         Value="E"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_post2"/>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="True">
                        <Setter Property="UIElement.IsEnabled" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:GridLayout x:Name="GrdLayout00" Margin="0" RowCount="5" RowHeights="35,193,*,25,139">
        <Grid Name="notused" Visibility="Hidden" Width="0" Height="0">
            <TextBlock Name="tblHan_tt" Grid.Column="0" Margin="0" Style="{StaticResource ContentTextStyle}" Text="Hạn tt"
                 Grid.Row="3"/>
            <smc:NumericTextBox GotFocus="txtHan_tt_GotFocus" Name="txtHan_tt" Grid.Column="1" TabIndex="0" Format="#,0"
                          Grid.Row="3" Value="{smc:BindingEx Path=han_tt}"
                          Style="{smc:MergedStyles BasedOn={StaticResource NumericTextBoxrEditModeEnable}, MergeStyle={StaticResource NumericTextBoxStyle}}"/>
            <TextBlock Name="tblkh_mau_hd" Grid.Column="0" Margin="0" Style="{StaticResource ContentTextStyle}"
                 Text="Mẫu hóa đơn" Grid.Row="4"/>
            <smc:AutoCompleteTextBox PreviewKeyDown="txtkh_mau_hd_PreviewKeyDown" x:Name="txtkh_mau_hd" Grid.Column="1" Grid.Row="4"
                               TabIndex="0" AllowEmty="true" AllowWrong="false"
                               Style="{StaticResource AutoCompleteTextBoxEditModeEnable}" ListID="dmmauhd30"
                               Text="{smc:BindingEx Path=kh_mau_hd}"
                               ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                               SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
            <TextBlock Name="lbhttt" Grid.Column="0" Grid.Row="5" Style="{StaticResource ContentTextStyle}"
                 Text="Hình thức tt"/>
            <TextBox PreviewKeyDown="txtHTTT_PreviewKeyDown" Name="txtHTTT" Grid.Column="1" Grid.Row="5"
               Style="{StaticResource TextBoxEditModeEnable}" TabIndex="0" Text="{smc:BindingEx Path=ht_tt}"/>
            <TextBlock Name="tblt_so_luong" Text="Số lượng" Grid.Column="0" Grid.Row="0"
                 Style="{StaticResource ContentTextStyle}"/>
            <smc:NumericTextBox Name="txtt_so_luong" Grid.Column="1" Grid.Row="0" IsReadOnly="true" IsTabStop="false"
                          Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_SL}"
                          Value="{smc:BindingEx t_so_luong}"/>
            <TextBlock Name="tblma_kh2" Text="Cục thuế" Grid.Row="2" Grid.Column="0"
                 Style="{StaticResource ContentTextStyle}"/>
            <smc:AutoCompleteTextBox x:Name="txtMa_kh2" Grid.Column="1" Grid.Row="2" TabIndex="0" AllowEmty="false" AllowWrong="false"
                               ListID="dmkh" Text="{smc:BindingEx Path=ma_kh2}"
                               ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                               SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                               IsTabStop="{Binding Path=tk_thue_co_cn, Mode=OneWay, Converter={StaticResource IsTabStop}}">
                <FrameworkElement.Style>
                    <Style TargetType="{x:Type smc:AutoCompleteTextBox}">
                        <Setter Property="smc:AutoCompleteTextBox.IsReadOnly">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource ReadOnlyConverter}" ConverterParameter="CT;ma_kh2_ph">
                                    <Binding Path="tk_thue_co_cn" Mode="OneWay"/>
                                    <Binding Path="Value" Source="{StaticResource IsInEditMode}" Mode="OneWay"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </FrameworkElement.Style>
            </smc:AutoCompleteTextBox>
            <TextBlock Name="tblso_seri" Grid.Row="3" Grid.Column="0" Text="Số seri"
                 Style="{StaticResource ContentTextStyle}"/>
            <TextBox GotFocus="txtSo_seri_GotFocus" x:Name="txtSo_seri" Grid.Column="1" Height="20" Grid.Row="3"
               TabIndex="0" Width="Auto" CharacterCasing="Upper" Margin="0,2" Text="{smc:BindingEx Path=so_seri}"
               Style="{smc:MergedStyles BasedOn={StaticResource TextBoxStyle}, MergeStyle={StaticResource TextBoxEditModeEnable}}">
            </TextBox>
        </Grid>
        <smc:GridLayout Name="GridLayoutMain" Row="1" RowCount="3" RowHeights="*" ColumnCount="5"
                    ColumnWidths="23*,10,45*,12,316" Margin="12,4,12,12">
            <GroupBox Name="gbInfo" Header="Thông tin chung" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0">
                <smc:GridLayout Name="GrdLayout10" RowCount="7" RowHeights="25,25,25,25,25,25,25" ColumnCount="5"
                        ColumnWidths="100,140,*,100,140">
                    <TextBlock Name="tblma_kh" Text="Mã ncc" Grid.Row="0" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_kh_PreviewLostFocus" Name="txtMa_kh" Grid.Column="1" Grid.Row="0"
                                   TabIndex="10" FontWeight="Normal" AllowEmty="false" AllowWrong="false"
                                   Style="{StaticResource AutoCompleteTextBoxEditModeEnable}" ListID="dmkh"
                                   Text="{smc:BindingEx Path=ma_kh}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smvc:FormTrans}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smvc:FormTrans}}"/>

                    <Button Click="btnNG_Click" Name="btnNG" Content="Lấy NG" Grid.Row="0" Grid.Column="4"
HorizontalAlignment="Left" Width="75" Style="{StaticResource ButtonEditModeEnable}"/>

                    <TextBlock Name="txtTen_kh" Grid.Row="0" Margin="12,0" Grid.Column="2" Grid.ColumnSpan="2"
                     Style="{StaticResource ContentTextStyle}" Text="{smc:BindingEx Path=ten_kh, Path2=ten_kh2}"/>
                    <TextBlock Name="tbldia_chi" Text="Địa chỉ" Grid.Row="1" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox GotFocus="txtDia_chi_GotFocus" x:Name="txtDia_chi" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                   TabIndex="15" Height="20" FontWeight="Normal" Style="{StaticResource TextBoxEditModeEnable}"
                   Text="{smc:BindingEx Path=dia_chi}"/>
                    <TextBlock Name="tblma_so_thue" Text="MST" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left"
                     Style="{StaticResource ContentTextStyle}" Margin="12,0,5,0"/>
                    <TextBox x:Name="txtma_so_thue" Grid.Column="4" Grid.Row="1" IsReadOnly="true" Margin="0,2,0,2"
                   Text="{smc:BindingEx Path=ma_so_thue}"/>
                    <TextBlock Name="tblong_ba" Text="Ng. nhận hàng" Grid.Row="2" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox x:Name="txtOng_ba" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" TabIndex="20" Height="20"
                   FontWeight="Normal" Text="{smc:BindingEx Path=ong_ba}">
