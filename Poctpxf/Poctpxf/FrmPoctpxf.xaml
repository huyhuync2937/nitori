                            <Style TargetType="{x:Type smc:DateTextBox}" BasedOn="{StaticResource DateTextBoxStyle}">
                                <Setter Property="igEditors:ValueEditor.IsReadOnly">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource ReadOnlyConverter}" ConverterParameter="PH;ngay_lct">
                                            <Binding Mode="OneWay" Source="{StaticResource IsInEditMode}" Path="Value"/>
                                        </MultiBinding>
                                    </Setter.Value>
