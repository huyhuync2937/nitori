                           TabIndex="50" AllowEmpty="false" FontWeight="Normal"
                           Style="{StaticResource DateTextBoxEditModeEnable}" Value="{smc:BindingEx Path=ngay_ct}"/>
                    <TextBlock Name="tblngay_lct" Grid.Column="0" Grid.Row="1" Text="Ngày lập c.từ"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:DateTextBox LostFocus="txtngay_lct_LostFocus" x:Name="txtngay_lct" Grid.Column="1" Height="20" Grid.Row="1"
                           TabIndex="60" Margin="0,2" FontWeight="Normal" Value="{smc:BindingEx Path=ngay_lct}">
