<smc:FormList
    x:Class="Inhsqd.newForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:smc="http://sis.vn/SasControls"
    xmlns:igWindows="http://infragistics.com/Windows"
    xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors;assembly=InfragisticsWPF3.Editors.v10.2"
    Title="Them moi dvt"
    LanguageID="Inhsqd_0"
    Width="747"
    Height="254"
    Loaded="newForm_Loaded"
    Closed="FormList_Closed"
    PreviewKeyUp="FormList_PreviewKeyUp">

    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml" />
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <smc:EditModeBindingObject x:Key="IsInEditMode" IsEditMode="False" />
            <smc:CodeValueBindingObject x:Key="M_IP_GIA" />
            <smc:CodeValueBindingObject x:Key="M_IP_GIA_NT" />
            <smc:CodeValueBindingObject x:Key="M_IP_SL" />

            <Style x:Key="MaskedTextBoxReadOnly" TargetType="{x:Type smc:MaskedTextBox}" BasedOn="{StaticResource MaskedTextBoxStyle}">
                <Setter Property="TextBoxBase.IsReadOnly" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TextBoxReadOnly" TargetType="{x:Type smc:NumericTextBox}">
                <Setter Property="TextBoxBase.IsReadOnly" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ReadOnly" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                <Setter Property="TextBoxBase.IsReadOnly" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ReadOnlyNumericTextBox" TargetType="{x:Type smc:NumericTextBox}" BasedOn="{StaticResource NumericTextBoxStyle}">
                <Setter Property="TextBoxBase.IsReadOnly" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ReadOnlyDateTime" TargetType="{x:Type smc:DateTextBox}" BasedOn="{StaticResource DateTextBoxStyle}">
                <Setter Property="TextBoxBase.IsReadOnly" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AutoCompleteReadOnly" TargetType="{x:Type smc:AutoCompleteTextBox}" BasedOn="{StaticResource AutoCompleteTextBoxStyle}">
                <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <smc:ConfirmGridView Name="ConfirmGV" OnCancel="ConfirmGV_OnCancel" OnOk="ConfirmGridView_OnOk">
        <smc:GridLayout Margin="12,12,12,0">
            <igWindows:XamTabControl Name="TabInfor" Theme="Generic">

                <igWindows:TabItemEx Name="TabMain" Header="_1. Thông tin chính" IsTabStop="False">
                    <smc:GridLayout
                        Name="gridMain"
                        Margin="8,5.5,8,5.5"
                        ColumnCount="5"
                        ColumnWidths="130,140,*,90,140"
                        RowCount="5"
                        RowHeights="25,25,25,25">

                        <!-- Row 0: Mã vật tư -->
                        <TextBlock Name="tblvat_tu" Grid.Row="0" Grid.Column="0" Text="Mã vật tư" />
                        <smc:AutoCompleteTextBox
                            Name="txtMa_vt"
                            Grid.Row="0" Grid.Column="1"
                            TabIndex="10"
                            Style="{StaticResource AutoCompleteReadOnly}"
                            AllowEmty="False"
                            AllowWrong="False"
                            ListID="dmvt"
                            Text="{smc:BindingEx ma_vt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            LostFocus="txtMa_vt_LostFocus" />
                        <TextBlock
                            Name="txtten_vt"
                            Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3"
                            Margin="12,0,0,0"
                            Text="{smc:BindingEx Path=ten_vt, Path2=ten_vt2}" />

                        <!-- Row 1: Đơn vị tính -->
                        <TextBlock Name="tblNgay" Grid.Row="1" Grid.Column="0" Text="Đơn vị tính" />
                        <TextBox
                            Name="txtDvt"
                            Grid.Row="1" Grid.Column="1"
                            TabIndex="13"
                            IsTabStop="False"
                            IsReadOnly="True"
                            Text="{smc:BindingEx dvt}" />

                        <!-- Row 2: Đơn vị tính quy đổi -->
                        <TextBlock Name="tblGia_VND" Grid.Row="2" Grid.Column="0" Text="Đơn vị tính quy đổi" />
                        <TextBox
                            Name="txtDvt1"
                            Grid.Row="2" Grid.Column="1"
                            TabIndex="24"
                            Height="20"
                            Padding="2"
                            Text="{smc:BindingEx dvt1}" />

                        <!-- Row 3: Hệ số quy đổi -->
                        <TextBlock Name="tblnh_kh2" Grid.Row="3" Text="Hệ số quy đổi" />
                        <smc:NumericTextBox
                            Name="txtHs_qd"
                            xmlns:p12="http://infragistics.com/Editors"
                            Grid.Row="3" Grid.Column="1"
                            TabIndex="24"
                            Height="20"
                            Padding="2"
                            Style="{StaticResource ReadOnlyNumericTextBox}"
                            IsInEditMode="True"
                            Value="{smc:BindingEx hs_qd}"
                            Format="{Binding Path=Text, Source={StaticResource M_IP_SL}, Mode=OneWay}"
                            GotFocus="txtHs_qd_GotFocus" />

                        <!-- Row 4: Trạng thái -->
                        <TextBlock Name="tblStatus" Grid.Row="4" Grid.Column="0" Text="Trạng thái" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal">
                            <smc:MaskedTextBox
                                Name="txtstatus"
                                xmlns:p13="http://infragistics.com/Editors"
                                Width="38"
                                TabIndex="230"
                                Style="{StaticResource MaskedTextBoxReadOnly}"
                                HorizontalContentAlignment="Right"
                                Format="M"
                                InputMask="0,1"
                                Value="{smc:BindingEx status}"
                                LostFocus="txtstatus_LostFocus" />
                            <TextBlock Name="txtstatus_ghi_chu" Margin="12,0,0,0" Text="0 - Không sử dụng, 1 - Sử dụng" />
                        </StackPanel>

                    </smc:GridLayout>
                </igWindows:TabItemEx>

                <igWindows:TabItemEx Name="TabEx" Header="_2. Thông tin khác" IsTabStop="False" />

            </igWindows:XamTabControl>
        </smc:GridLayout>
    </smc:ConfirmGridView>
</smc:FormList>
