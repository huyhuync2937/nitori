<smc:FormList x:Class="CrmDmEmailcr.newForm"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:smc="http://sis.vn/SasControls"
              xmlns:igWindows="http://infragistics.com/Windows"
              xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors;assembly=InfragisticsWPF3.Editors.v10.2"
              Loaded="newForm_Loaded" Closed="FormList_Closed" PreviewKeyUp="FormList_PreviewKeyUp"
              Title="Them moi loai khach hang" LanguageID="CrmDmEmailcr_0" Width="650" Height="285">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <smc:EditModeBindingObject x:Key="IsInEditMode" IsEditMode="false"/>
            <Style x:Key="ReadOnly" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                <Setter Property="TextBoxBase.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnlyNumericTextBox" TargetType="{x:Type smc:NumericTextBox}"
             BasedOn="{StaticResource NumericTextBoxStyle}">
                <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AutoCompleteReadOnly" TargetType="{x:Type smc:AutoCompleteTextBox}"
             BasedOn="{StaticResource AutoCompleteTextBoxStyle}">
                <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DateTextBoxReadOnly" TargetType="{x:Type smc:DateTextBox}"
             BasedOn="{StaticResource DateTextBoxStyle}">
                <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MaskedTextBoxReadOnly" TargetType="{x:Type smc:MaskedTextBox}"
             BasedOn="{StaticResource MaskedTextBoxStyle}">
                <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="XamComboEditorReadOnly" TargetType="{x:Type igEditors:XamComboEditor}"
             BasedOn="{StaticResource XamComboEditorStyle}">
                <Setter Property="UIElement.IsEnabled" Value="false"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="UIElement.IsEnabled" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="btnDsns" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="UIElement.IsEnabled" Value="false"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="UIElement.IsEnabled" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" OnCancel="ConfirmGV_OnCancel" Name="ConfirmGV">
        <smc:GridLayout Margin="12,4,12,0">
            <igWindows:XamTabControl Name="TabInfor" Theme="Generic">
                <FrameworkElement.Resources>
                    <Style TargetType="{x:Type igWindows:TabItemEx}" BasedOn="{StaticResource TabItemStyle}"/>
                </FrameworkElement.Resources>
                <igWindows:TabItemEx Name="TabMain" Header="_1. Thông tin chính" IsTabStop="false">
                    <smc:GridLayout Name="gridMain" Margin="8,5,8,0" ColumnCount="5" ColumnWidths="150,140,*,90,140" RowCount="6"
                          RowHeights="25,25,25,25,25,25">
                        <TextBlock Name="tblma_emailcr" Text="Mã danh sách Email" Grid.Row="0" Grid.Column="0"/>
                        <TextBox GotFocus="txtma_emailcr_GotFocus" x:Name="txtma_emailcr" Grid.Column="1" Grid.Row="0" TabIndex="10"
                     CharacterCasing="Upper" Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ma_emailcr}"/>
                        <TextBlock Name="tblma_tra_cuu" Text="Mã tra cứu" Grid.Row="0" Grid.Column="3"/>
                        <TextBox GotFocus="txtma_tra_cuu_GotFocus" x:Name="txtma_tra_cuu" Grid.Column="4" Grid.Row="0" TabIndex="20"
                     Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ma_tra_cuu}"/>
                        <TextBlock Name="tblten_emailcr" Text="Tên danh sách Email" Grid.Row="1" Grid.Column="0"/>
                        <TextBox x:Name="txtten_emailcr" Grid.ColumnSpan="4" Grid.Row="1" Grid.Column="1" TabIndex="30"
                     Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ten_emailcr}"/>
                        <TextBlock Name="tblten_emailcr2" Text="Tên 2" Grid.Row="2" Grid.Column="0"/>
                        <TextBox x:Name="txtten_emailcr2" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="4" TabIndex="40"
                     Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ten_emailcr2}"/>

                        <TextBlock Name="tblghi_chu" Text="Diễn giải" Grid.Row="3" Grid.Column="0"/>
                        <TextBox x:Name="txtghi_chu" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="4" TabIndex="45"
                     Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ghi_chu}"/>
                        
                        <TextBlock Name="tblma_kh_list" Text="Danh sách khách hàng" Grid.Row="4" Grid.Column="0"/>
                        <StackPanel Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="4" Orientation="Horizontal">
                            <TextBox x:Name="txtma_kh_list" TabIndex="50" Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ma_kh_list}" IsReadOnly="True" Width="390"/>
                            <Button Name="btnma_kh_list" Content="..." Margin="12,0,0,0" Style="{StaticResource btnDsns}" Click="btnma_kh_list_Click" Width="30" Height="25"/>
                        </StackPanel>
                        
                        <TextBlock Name="tblstatus" Text="Trạng thái sử dụng" Grid.Row="5" Grid.Column="0"/>
                        <StackPanel Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="5" Orientation="Horizontal">
                            <smc:MaskedTextBox LostFocus="txtstatus_LostFocus" Name="txtstatus" Format="M" InputMask="0,1" Width="38"
                                 TabIndex="70" Style="{StaticResource MaskedTextBoxReadOnly}" HorizontalContentAlignment="Right"
                                 Value="{smc:BindingEx status}"/>
                            <TextBlock Name="txtstatus_ghi_chu" Text="0 - Không sử dụng, 1 - Sử dụng" Margin="12,0,0,0"/>
                        </StackPanel>
                    </smc:GridLayout>
                </igWindows:TabItemEx>
                <igWindows:TabItemEx Name="TabEx" IsTabStop="false" Header="_2. Thông tin khác"/>
            </igWindows:XamTabControl>
        </smc:GridLayout>
    </smc:ConfirmGridView>
</smc:FormList>