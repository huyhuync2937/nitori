<smc:FormList x:Class="CrmDmEmailcr.FrmSendEmaiCr"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:smc="http://sis.vn/SasControls"
              xmlns:igWindows="http://infragistics.com/Windows"
              xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors;assembly=InfragisticsWPF3.Editors.v10.2" xmlns:smith="clr-namespace:Smith.WPF.HtmlEditor;assembly=Smith.WPF.HtmlEditor"
              Loaded="newForm_Loaded" Closed="FormList_Closed" PreviewKeyUp="FormList_PreviewKeyUp"
              Title="Gui Email" LanguageID="CrmDmEmailcr_0" Width="1050" Height="650">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <smc:EditModeBindingObject x:Key="IsInEditMode" IsEditMode="True"/>
            <Style x:Key="ReadOnly" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                <Setter Property="TextBoxBase.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnlyNumericTextBox" TargetType="{x:Type smc:NumericTextBox}"
             BasedOn="{StaticResource NumericTextBoxStyle}">
                <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AutoCompleteReadOnly" TargetType="{x:Type smc:AutoCompleteTextBox}"
             BasedOn="{StaticResource AutoCompleteTextBoxStyle}">
                <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DateTextBoxReadOnly" TargetType="{x:Type smc:DateTextBox}"
             BasedOn="{StaticResource DateTextBoxStyle}">
                <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MaskedTextBoxReadOnly" TargetType="{x:Type smc:MaskedTextBox}"
             BasedOn="{StaticResource MaskedTextBoxStyle}">
                <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="XamComboEditorReadOnly" TargetType="{x:Type igEditors:XamComboEditor}"
             BasedOn="{StaticResource XamComboEditorStyle}">
                <Setter Property="UIElement.IsEnabled" Value="false"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="UIElement.IsEnabled" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="btnDsns" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="UIElement.IsEnabled" Value="false"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="UIElement.IsEnabled" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:GridLayout RowCount="2" RowHeights="*,49">
        <smc:GridLayout Margin="12,4,12,0">
            <igWindows:XamTabControl Name="TabInfor" Theme="Generic">
                <FrameworkElement.Resources>
                    <Style TargetType="{x:Type igWindows:TabItemEx}" BasedOn="{StaticResource TabItemStyle}"/>
                </FrameworkElement.Resources>
                <igWindows:TabItemEx Name="TabMain" Header="_1. Thông tin chính" IsTabStop="false">
                    <smc:GridLayout Name="gridMain" Margin="8,5,8,0" ColumnCount="5" ColumnWidths="150,140,*,90,140" RowCount="7"
                          RowHeights="25,50,25,25,*,60,25">
                        <TextBlock Name="tblemail_from" Text="Người gửi" Grid.Row="0" Grid.Column="0"/>
                        <TextBox x:Name="txtemail_from" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="4" TabIndex="10" Style="{StaticResource ReadOnly}" IsReadOnly="True" IsTabStop="False"/>

                        <TextBlock Name="tblemail_to_list" Text="Danh sách người nhận" Grid.Row="1" Grid.Column="0"/>
                        <TextBox x:Name="txtemail_to_list" Grid.ColumnSpan="4" Grid.Row="1" Grid.Column="1" TabIndex="20" Height="50" TextWrapping="Wrap"
                     Style="{StaticResource ReadOnly}"/>
                        <TextBlock Name="tblma_kh_list" Text="Danh sách khách hàng" Grid.Row="1" Grid.Column="0" Visibility="Hidden"/>
                        <TextBox x:Name="txtma_kh_list" Grid.ColumnSpan="4" Grid.Row="1" Grid.Column="1" TabIndex="30" Visibility="Hidden"
                     Style="{StaticResource ReadOnly}"/>

                        <TextBlock Name="tbltieu_de" Text="Tiêu đè" Grid.Row="2" Grid.Column="0"/>
                        <TextBox x:Name="txttieu_de" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="4" TabIndex="30"
                     Style="{StaticResource ReadOnly}"/>


                        <TextBlock Name="tblnoi_dung" Text="Nội dung" Grid.Row="3" Grid.Column="0"/>
                        
                        <smith:HtmlEditor x:Name="Editor" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" 
                                          TabIndex="40" IsTabStop="true" BorderThickness="1" BorderBrush="#FFC5C5C5"/>
                        
                        <smc:GridLayout Grid.Row="5" Grid.ColumnSpan="6" ColumnCount="5" ColumnWidths="100,50,*,10,50">
                            <TextBlock Name="lblfile" Text="File đính kèm" Margin="0,0,12,0" Grid.Column="0" FontWeight="Bold"  FontSize="12" />
                            <ListBox Name="lbFiles" Grid.Column="2" IsEnabled="true" IsTabStop="false" Height="50" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                            <Button Click="btnfile_Click" Name="btnfile" BorderBrush="Transparent" Grid.Column="4" FontSize="16" FontWeight="ExtraBold"  Background="#E2E2E2" Foreground="#1072B9" Content="..." VerticalContentAlignment="Center" TabIndex="5" Width="50" Height="35"  HorizontalAlignment="Right"/>
                        </smc:GridLayout>

                    </smc:GridLayout>
                </igWindows:TabItemEx>
                <igWindows:TabItemEx Name="TabEx" IsTabStop="false" Header="_2. Thông tin khác"/>
            </igWindows:XamTabControl>
        </smc:GridLayout>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="12,0,0,0">
            <Button x:Name="btnSend" Content="Gửi" Width="100" Height="25" Click="btnSend_Click"/>
            <Button x:Name="btnCancel" Content="Huỷ" Width="100" Height="25" Margin="12,0,0,0" Click="btnCancel_Click"/>
        </StackPanel>
    </smc:GridLayout>
</smc:FormList>