<smc:Form x:Class="Socthda.FrmKHInfo"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:smc="clr-namespace:SasControls;assembly=SasControls"
          Loaded="Form_Loaded" Title="Khach hang VAT" Height="192" Width="600" LanguageID="Socthda_1"
          EscToClose="true" Theme="Voucher">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" OnCancel="ConfirmGridView_OnCancel" Name="GrdOkCancel">
    <GroupBox Name="Grdgroup" Margin="12,4,12,0" Style="{StaticResource NonHeaderGroupBoxStyle}">
      <smc:GridLayout Name="GrdInfo" RowCount="3" ColumnCount="3" ColumnWidths="120,140,*">
        <TextBlock Name="tblTen_kh" Text="Tên khách hàng" Grid.Column="0" Grid.Row="0"
                   Style="{StaticResource ContentTextStyle}"/>
        <TextBox Name="txtTen_kh" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" TabIndex="10"/>
        <TextBlock Name="tblDia_chi" Text="Địa chỉ" Grid.Column="0" Grid.Row="1"
                   Style="{StaticResource ContentTextStyle}"/>
        <TextBox Name="txtDia_chi" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" TabIndex="20"/>
        <TextBlock Name="tblMa_so_thue" Text="Mã số thuế" Grid.Column="0" Grid.Row="2"
                   Style="{StaticResource ContentTextStyle}"/>
        <TextBox Name="txtMa_so_thue" Grid.Column="1" Grid.Row="2" TabIndex="30"/>
      </smc:GridLayout>
    </GroupBox>
  </smc:ConfirmGridView>
</smc:Form>