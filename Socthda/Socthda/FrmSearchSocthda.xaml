<SasFormReport:FormFilter x:Class="Socthda.FrmSearchSocthda"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:src="clr-namespace:Socthda"
                     xmlns:smc="http://sis.vn/SasControls"
                     xmlns:igDP="http://infragistics.com/DataPresenter"
                     xmlns:my="clr-namespace:System;assembly=mscorlib"
                     xmlns:SasFormReport="clr-namespace:SasFormReport;assembly=SasFormReport"
                     xmlns:igEditors="http://infragistics.com/Editors"
                     xmlns:smvc="clr-namespace:SasVoucherLib;assembly=SasVoucherLib"
                     Unloaded="FormSearch_Unloaded" Loaded="FrmSearchSocthda_Loaded" Name="FormSearch" EscToClose="true"
                     LanguageID="Socthda_3" Title="Loc chung tu" Height="700" Width="960" Theme="Voucher">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <smc:NotNullConverter x:Key="NotNullControl"/>
      <smvc:BindingStatusVoucher x:Key="StatusVoucher"/>
      <Style x:Key="ComboBoxEditModeEnable" TargetType="{x:Type igEditors:XamComboEditor}"
             BasedOn="{StaticResource XamComboEditorStyle}">
        <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_act"/>
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="E"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_act2"/>
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <smc:ConfirmGridView OnOk="grdConfirm_OnOk" Name="grdConfirm">
    <smc:GridLayout RowCount="2" RowHeights="257,*" Margin="12,4,12,0">
      <GroupBox Name="grpLocCT" Header="Điều kiện lọc" Grid.Column="0" Grid.Row="0" Margin="0,0,0,4">
        <smc:GridLayout Name="GrdPhLoc" RowCount="10" RowHeights="25,25,25,25,25,25,25,25,25,*" ColumnCount="6"
                        ColumnWidths="100,140,12,100,140,*">
          <TextBlock Name="tblma_qs" Grid.Column="0" Grid.Row="0" Text="Quyển c.từ"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_qs_PreviewLostFocus" Name="txtMa_qs" Grid.Column="1" Grid.Row="0"
                                   TabIndex="1" IsFocus="true" AllowEmty="true" AllowWrong="false" ListID="dmqs"
                                   Filter="ma_cts like '%HDA%' and status =1" Margin="0,2"
                                   Text="{smc:BindingEx Path=M_MA_QS, ElementName=FrmFilter}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
          <TextBlock Name="lbltenqs" Grid.Column="3" Grid.ColumnSpan="4" Grid.Row="0"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <TextBlock Name="tblso_ct1" Grid.Column="0" Grid.Row="1" Text="Hđ từ số"/>
          <TextBox Name="txtSo_ct1" Grid.Column="1" Grid.Row="1" TabIndex="10" CharacterCasing="Upper"/>
          <TextBlock Name="tblso_ct2" Grid.Column="3" Grid.Row="1" Text="Đến số"/>
          <TextBox Name="txtSo_ct2" Grid.Column="4" Grid.Row="1" TabIndex="12" CharacterCasing="Upper"/>
          <TextBlock Name="tblngay_ct1" Grid.Column="0" Grid.Row="2" Text="Hđ từ ngày"/>
          <smc:DateTextBox Name="txtNgay_ct1" DisplayMode="IncludeBoth" Grid.Column="1" Grid.Row="2" AllowEmpty="false"
                           IsAlwaysInEditMode="true" TabIndex="20"
                           Value="{smc:BindingEx Path=M_NGAY_CT1, ElementName=FormSearch}"/>
          <TextBlock Name="tblngay_ct2" Grid.Column="3" Grid.Row="2" Text="Đến ngày"/>
          <smc:DateTextBox Name="txtNgay_ct2" DisplayMode="IncludeBoth" Grid.Column="4" Grid.Row="2" AllowEmpty="false"
                           IsAlwaysInEditMode="true" TabIndex="30"
                           Value="{smc:BindingEx Path=M_NGAY_CT2, ElementName=FormSearch}"/>
          <TextBlock Name="tblMa_kh" Text="Mã khách" Grid.Column="0" Grid.Row="3"/>
          <smc:AutoCompleteTextBox LostFocus="txtMa_kh_LostFocus" Name="txtMa_kh" Grid.Column="1" Grid.Row="3" TabIndex="40"
                                   AllowEmty="true" AllowWrong="false" ListID="dmkh"
                                   Text="{smc:BindingEx Path=M_MA_KH, ElementName=FormSearch}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
          <TextBlock Name="tblTen_kh" Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="3"/>
          <TextBlock Name="tblMa_nx" Text="Mã nx (tk nợ)" Grid.Column="0" Grid.Row="4"/>
          <smc:AutoCompleteTextBox LostFocus="txtMa_nx_LostFocus" Name="txtMa_nx" Grid.Column="1" Grid.Row="4" TabIndex="41"
                                   AllowEmty="true" AllowWrong="false" ListID="dmtk"
                                   Text="{smc:BindingEx Path=M_TK, ElementName=FormSearch}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
          <TextBlock Name="tblTen_tk" Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="4"/>
          <TextBlock Name="tblma_bp" Grid.Column="0" Grid.Row="5" Text="Mã NVBH"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_bp_PreviewLostFocus" Name="txtMa_bp" Grid.Column="1" Grid.Row="5"
                                   TabIndex="46" AllowEmty="true" AllowWrong="false" ListID="dmbp" Margin="0,2"
                                   Text="{smc:BindingEx Path=M_MA_BP, ElementName=FrmFilter}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
          <TextBlock Name="lbltenbp" Grid.Column="3" Grid.ColumnSpan="4" Grid.Row="5"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <TextBlock Name="lblStatus" Text="Trạng thái" Grid.Column="0" Grid.Row="6"/>
          <igEditors:XamComboEditor Name="txtStatus" Style="{StaticResource ComboBoxEditModeEnable}" ValuePath="ma_post"
                                    Grid.Column="1" Height="20" Margin="0" Grid.Row="6" TabIndex="48"
                                    SelectedIndex="{Binding Path=status, Converter={StaticResource StatusVoucher}}"/>
          <TextBlock Name="lblMaDVCS" Text="Mã ĐVCS" Grid.Column="0" Grid.Row="7"/>
          <smc:AutoCompleteTextBox LostFocus="txtMaDVCS_LostFocus" Name="txtMaDVCS" Grid.Column="1" Grid.Row="7" TabIndex="49"
                                   AllowEmty="true" AllowWrong="false" ListID="dmdvcs"
                                   Text="{smc:BindingEx Path=M_MA_DVCS, ElementName=FormSearch}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
          <TextBlock Name="lblTenDVCS" Grid.Column="3" Grid.ColumnSpan="4" Grid.Row="7"/>
          <TextBlock Name="tblloc_nsd" Grid.Column="0" Grid.Row="8" Text="Lọc theo NSD"/>
          <StackPanel Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="8" Orientation="Horizontal">
            <smc:MaskedTextBox LostFocus="txtloc_nsd_LostFocus" Name="txtloc_nsd" TabIndex="50" Format="M" InputMask="0,1"
                               Width="140"/>
            <TextBlock Name="tblCommentloc_nsd" Text="0 - Không, 1 - Có" Margin="12,0,0,0"/>
          </StackPanel>
        </smc:GridLayout>
      </GroupBox>
      <SasFormReport:ControlDetailFilter3 x:Name="GridSearch" Grid.Row="1" FontWeight="Normal"/>
    </smc:GridLayout>
    <Canvas Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,78,33">
      <TextBlock Name="tblF5Des" Text="F5 - Tra cứu"/>
    </Canvas>
  </smc:ConfirmGridView>
</SasFormReport:FormFilter>