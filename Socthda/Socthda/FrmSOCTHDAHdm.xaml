<smc:Form x:Class="Socthda.FrmSOCTHDAHdm"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:smc="clr-namespace:SasControls;assembly=SasControls"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          KeyUp="Form_KeyUp" Loaded="Form_Loaded" Title="Chon don hang ban" LanguageID="Socthda_5"
          Height="212" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" OnCancel="ConfirmGridView_OnCancel" Margin="0">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Border Grid.Row="0" Margin="12,12,12,0" BorderThickness="1" BorderBrush="#FF808080">
      <smc:GridLayout RowCount="4" RowHeights="25,25,25,25" Margin="12,9.5" ColumnCount="3" ColumnWidths="100,140,*">
        <TextBlock Name="tblngay_ct_old" Text="Ngày bắt đầu" Grid.Column="0" Grid.Row="0"
                   Style="{StaticResource ContentTextStyle}"/>
        <smc:DateTextBox Name="txtNgay_ct_old" DisplayMode="IncludeBoth" Grid.Column="1" Grid.Row="0" Margin="0"
                         Style="{StaticResource DateTextBoxStyle}" IsAlwaysInEditMode="true" TabIndex="10"/>
        <TextBlock Name="tblngay_ct_new" Text="Ngày kết thúc" Grid.Column="0" Grid.Row="1"
                   Style="{StaticResource ContentTextStyle}"/>
        <smc:DateTextBox Name="txtNgay_ct_new" DisplayMode="IncludeBoth" Grid.Column="1" Grid.Row="1" Margin="0,0,0,2.417"
                         Style="{StaticResource DateTextBoxStyle}" IsAlwaysInEditMode="true" TabIndex="20" Height="20"
                         VerticalAlignment="Bottom" Width="140"/>
        <TextBlock Name="tblma_khach" Text="Mã khách" Grid.Column="0" Grid.Row="2"
                   Style="{StaticResource ContentTextStyle}"/>
        <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_kh_PreviewLostFocus" Name="txtMa_kh" Grid.Column="1" Grid.Row="2"
                                 TabIndex="30" AllowEmty="true" AllowWrong="true" ListID="dmkh"
                                 ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                 SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
        <TextBlock Name="tblTen_kh" Grid.Row="2" Grid.Column="2" Margin="12,0,0,0"
                   Style="{StaticResource ContentTextStyle}"/>
        <TextBlock Name="tblma_hdb" Text="Số đh bán" Grid.Column="0" Grid.Row="3"
                   Style="{StaticResource ContentTextStyle}"/>
        <smc:AutoCompleteTextBox Name="txtma_hdm" Grid.Column="1" Grid.Row="3" TabIndex="40" AllowEmty="true" AllowWrong="true"
                                 ListID="dmhd"
                                 ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"
                                 SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smc:Form}}"/>
      </smc:GridLayout>
    </Border>
  </smc:ConfirmGridView>
</smc:Form>