<smc:Form x:Class="Socthda.FrmPrintSocthda"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:smc="http://sis.vn/SasControls"
          xmlns:igDP="http://infragistics.com/DataPresenter"
          xmlns:SasFormReport="clr-namespace:SasFormReport;assembly=SasFormReport"
          xmlns:igEditors="http://infragistics.com/Editors"
          Loaded="Form_Loaded" Title="Danh muc mau bao cao" LanguageID="Socthda_2" EscToClose="true"
          Height="450" Width="750">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <smc:GridLayout RowCount="5" RowHeights="*,25,25,0,47" ColumnCount="7" Margin="12,4,12,0"
                  ColumnWidths="140,12,140,120,*,12,92">
    <SasFormReport:ControlFilterReport Name="GridSearch" Grid.ColumnSpan="7"/>
    <TextBlock Name="lblctu0" Grid.Row="1" Text="Số c.từ gốc kèm theo"/>
    <smc:NumericTextBox LostFocus="txtctu0_LostFocus" Name="txtctu0" Format="#,0" Grid.Column="2" Grid.Row="1" TabIndex="2"
                        InvalidValueBehavior="RevertValue" Value="{smc:BindingEx so01}">
      <igEditors:ValueEditor.ValueConstraint>
        <igEditors:ValueConstraint ValidateAsType="Integer32" MinInclusive="0" MaxInclusive="99"/>
      </igEditors:ValueEditor.ValueConstraint>
    </smc:NumericTextBox>
    <TextBlock Name="lbllien" Grid.Row="2" Text="Số liên"/>
    <smc:NumericTextBox LostFocus="txtlien_LostFocus" Name="txtlien" Format="#,0" Grid.Column="2" Grid.Row="2" TabIndex="3"
                        InvalidValueBehavior="RevertValue" Value="{smc:BindingEx so02}">
      <igEditors:ValueEditor.ValueConstraint>
        <igEditors:ValueConstraint ValidateAsType="Integer16" MinInclusive="1" MaxInclusive="9"/>
      </igEditors:ValueEditor.ValueConstraint>
    </smc:NumericTextBox>
    <TextBlock Name="tblHt_tt" Text="Hình thức tt" Grid.Column="0" Grid.Row="3"
               Style="{StaticResource ContentTextStyle}"/>
    <TextBox PreviewLostKeyboardFocus="txtHt_tt_PreviewLostKeyboardFocus" LostFocus="txtHt_tt_LostFocus"
             Name="txtHt_tt" Grid.Column="2" Grid.Row="3" TabIndex="6" Text="{smc:BindingEx Path=ht_tt}"/>
    <smc:GridLayout Row="4" ColumnSpan="5" ColumnCount="5" ColumnWidths="104,104,104,200,*">
      <Button Click="btnin_Click" Name="btnin" Content="_In" Grid.Column="0" Width="92"
              VerticalAlignment="Bottom" Margin="0,0,0,12" HorizontalAlignment="Left" TabIndex="4"/>
      <Button Click="btnin_lt_Click" Name="btnin_lt" Content="_In liên tục" Grid.Column="1" Width="92"
              VerticalAlignment="Bottom" Margin="0,0,0,12" HorizontalAlignment="Left" TabIndex="5"/>
      <Button Click="btnxem_Click" Name="btnxem" Content="_Xem" Grid.Column="2" Width="92"
              VerticalAlignment="Bottom" Margin="0,0,0,12" HorizontalAlignment="Left" TabIndex="6"/>
      <Button Click="btnExport_Click" Name="btnExport" Grid.Column="3" Width="188" VerticalAlignment="Bottom"
              Margin="0,0,0,12" HorizontalAlignment="Left" TabIndex="6"/>
      <Button Click="btnthoat_Click" Name="btnthoat" Content="_Quay ra" Grid.Column="4" Width="92"
              HorizontalAlignment="Left" TabIndex="7"/>
    </smc:GridLayout>
  </smc:GridLayout>
</smc:Form>