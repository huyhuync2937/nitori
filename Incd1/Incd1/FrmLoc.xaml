<smr:FormFilter x:Class="Incd1.FrmLoc"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:Incd1"
                xmlns:igEditors="http://infragistics.com/Editors"
                xmlns:igWindows="http://infragistics.com/Windows"
                xmlns:sys="clr-namespace:System;assembly=mscorlib"
                xmlns:smc="http://sis.vn/SasControls"
                xmlns:smr="clr-namespace:SasFormReport;assembly=SasFormReport"
                Loaded="Form_Loaded" Name="frmIncd1" Theme="Standard" Height="640" Width="882" LanguageID="Incd1_0">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" x:Name="gridMain">
    <smc:ExTabControl Name="TabInfo" Margin="12,12,12,0" Theme="Generic">
      <smc:ExTabItem Name="TabMain" Header="Thông tin chung">
        <smc:GridLayout ColumnCount="8" RowCount="6" RowHeights="0,153,4,*,8" ColumnWidths="8,*,12,290,8">
          <GroupBox Name="Grp00" Grid.Row="1" Grid.RowSpan="1" Style="{StaticResource TabGroupBoxStyle}"
                    Grid.Column="1" Grid.ColumnSpan="1" Header="Điều kiện lọc">
            <smc:GridLayout Name="grid00" RowCount="5" ColumnCount="5" ColumnWidths="120,140,12,*,140"
                            RowHeights="25,25,25,25,25">
              <TextBlock Name="lblTuNgay" Text="C.từ từ ngày" Grid.Row="0" Grid.Column="0"/>
              <smc:DateTextBox Name="TxtStartDateTime" Grid.Column="1" Grid.Row="0" TabIndex="10"
                               Value="{smc:BindingEx Path=M_NGAY_CT1, ElementName=frmIncd1}"/>
              <TextBlock Name="lblDenNgay" Text="Đến ngày" Grid.Row="0" Grid.Column="3"/>
              <smc:DateTextBox Name="TxtEndDateTime" Grid.Row="0" Grid.Column="4" TabIndex="20"
                               Value="{smc:BindingEx Path=M_NGAY_CT2, ElementName=frmIncd1}"/>
              <TextBlock Name="lblMaKho" Text="Mã kho" Grid.Row="1" Grid.Column="0"/>
              <smc:AutoCompleteTextBox PreviewLostFocus="txtma_kho_PreviewLostFocus" Name="txtMa_kho" AllowEmty="true" AllowWrong="true"
                                       Grid.Column="1" Grid.Row="1" ListID="dmkho" TabIndex="40"
                                       Text="{smc:BindingEx Path=M_MA_KHO, ElementName=frmIncd1}"
                                       ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                       SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
              <TextBlock Name="txtten_kho" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="1"/>
              <TextBlock Name="lblMaVatTu" Grid.ColumnSpan="1" Grid.Row="2" Text="Mã vật tư" Grid.Column="0"/>
              <smc:AutoCompleteTextBox PreviewLostFocus="txtMaterial_PreviewLostFocus" Name="txtMaterial" AllowEmty="true"
                                       AllowWrong="true" Grid.Column="1" Grid.Row="2" ListID="dmvt" TabIndex="40"
                                       Text="{smc:BindingEx Path=M_MA_VT, ElementName=frmIncd1}"
                                       ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                       SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
              <TextBlock Name="txtTenVT" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="2"/>
              <TextBlock Name="lblPS" Grid.ColumnSpan="1" Grid.Row="3" Margin="0,2" Text="V.tư theo dõi tồn kho"
                         Grid.Column="0"/>
              <smc:MaskedTextBox LostFocus="txtVtTonkho_LostFocus" Name="txtVtTonkho" Grid.Column="1" Grid.Row="3" Text="1"
                                 TabIndex="50" InputMask="0,1,*" Format="M" IsTabStop="true" HorizontalContentAlignment="Right"/>
              <TextBlock Name="lblDetailPS" Grid.ColumnSpan="2" Grid.Row="3" Margin="0,2"
                         Text="0 - Không, 1 - Có, * - Cả hai" Grid.Column="3"/>
              <TextBlock Name="lblTinh_dc" Grid.Row="4" Grid.Column="0" Text="Ps điều chuyển kho"/>
              <smc:MaskedTextBox LostFocus="txtVtTonkho_LostFocus" Name="txtCt_dc" Grid.Column="1" Grid.Row="4" Text="0"
                                 TabIndex="50" InputMask="0,1" Format="M" IsTabStop="true" HorizontalContentAlignment="Right"/>
              <TextBlock Name="lblten_ct_dc" Grid.ColumnSpan="2" Grid.Row="4" Margin="0,2"
                         Text="0 - Không tính, 1 - Có tính" Grid.Column="3"/>
            </smc:GridLayout>
          </GroupBox>
          <smc:GridLayout Name="gridlayout01" Row="1" Column="3" RowCount="3" ColumnCount="1" RowHeights="52,4,*">
            <GroupBox Name="Grp01" Grid.Row="0" Grid.RowSpan="1" Style="{StaticResource TabGroupBoxStyle}"
                      Grid.Column="3">
              <smc:GridLayout Name="Grid01" RowCount="1" ColumnCount="2" ColumnWidths="*,140" RowHeights="25,25">
                <TextBlock Name="lblMaDVCS" Text="Mã ĐVCS" Grid.Column="0" Grid.Row="1"/>
                <smc:AutoCompleteTextBox Name="txtMaDVCS" Grid.Column="1" Grid.Row="1" TabIndex="70" AllowEmty="true" AllowWrong="false"
                                         ListID="dmdvcs" Text="{smc:BindingEx Path=M_MA_DVCS, ElementName=frmIncd1}"
                                         ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                         SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
              </smc:GridLayout>
            </GroupBox>
            <GroupBox Name="Grp011" Grid.Row="2" Grid.RowSpan="1" Style="{StaticResource TabGroupBoxStyle}"
                      Grid.Column="3" Header="Mẫu báo cáo">
              <smc:GridLayout Name="Grid011" RowCount="2" ColumnCount="2" ColumnWidths="*,140" RowHeights="25, *">
                <TextBlock Name="lblKindReport" Grid.Row="0" Text="Mẫu VND/ngoại tệ" Grid.Column="0"/>
                <igEditors:XamComboEditor Name="cbmau_bc" Grid.Column="1" Grid.Row="0" TabIndex="190" Margin="0" IsEnabled="false"
                                          IsTabStop="false" SelectedIndex="0">
                  <igEditors:XamComboEditor.ItemsProvider>
                    <igEditors:ComboBoxItemsProvider>
                      <igEditors:ComboBoxItemsProvider.Items>
                        <smc:ExComboBoxDataItem DisplayText="{x:Static local:StartUp.M_ma_nt0}" Value="0"/>
                        <smc:ExComboBoxDataItem DisplayText="Ngoại tệ" DisplayText2="FC" Value="1"/>
                      </igEditors:ComboBoxItemsProvider.Items>
                    </igEditors:ComboBoxItemsProvider>
                  </igEditors:XamComboEditor.ItemsProvider>
                </igEditors:XamComboEditor>
              </smc:GridLayout>
            </GroupBox>
          </smc:GridLayout>
          <smr:ControlDetailFilter3 Name="GridSearch" Grid.Row="3" Grid.RowSpan="1" GroupBoxStyleResourceKey="TabGroupBoxStyle"
                                    filterID="INCD1" Grid.Column="1" Grid.ColumnSpan="3" IsEnableSelectField="true" IsTabStop="false"/>
        </smc:GridLayout>
      </smc:ExTabItem>
    </smc:ExTabControl>
    <Canvas Grid.Row="1" Width="150" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,33">
      <TextBlock Name="lblTracuu" Text="F5 - Tra cứu" Width="150" HorizontalAlignment="Right" TextAlignment="Right"/>
    </Canvas>
  </smc:ConfirmGridView>
</smr:FormFilter>