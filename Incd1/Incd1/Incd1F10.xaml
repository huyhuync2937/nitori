<SasFormReport:FormFilter x:Class="Incd1.Incd1F10"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:smc="http://sis.vn/SasControls"
                     xmlns:SasFormReport="clr-namespace:SasFormReport;assembly=SasFormReport"
                     xmlns:src="clr-namespace:Incd1"
                     Loaded="FormFilter_Loaded" Title="Sắp xếp" Width="700" Height="160" LanguageID="SOTH1FF10">
  <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" Loaded="ConfirmGridView_Loaded">
    <FrameworkElement.Resources>
      <src:GroupValidConverter x:Key="GroupValidConverter"/>
      <src:GroupEnableConvert x:Key="GroupEnableConvert"/>
    </FrameworkElement.Resources>
    <Border BorderBrush="LightGray" BorderThickness="1" Margin="12, 12, 12, 0">
      <smc:GridLayout RowCount="3" RowHeights="25,25,*" ColumnCount="4" ColumnWidths="160, 140,*, 140" Margin="12">
        <TextBlock Name="lblGroup" Grid.Row="0" Grid.Column="0" Text="Thứ tự sắp xếp theo nhóm"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
          <smc:MaskedTextBox Name="txtGrp1" Format="M" Width="38" VerticalAlignment="Center" TabIndex="10"
                             Value="{smc:BindingEx group1}">
            <smc:MaskedTextBox.InputMask>
              <MultiBinding Converter="{StaticResource GroupValidConverter}" ConverterParameter="NH1">
                <Binding ElementName="txtGrp2" Path="Value" Mode="OneWay"/>
                <Binding ElementName="txtGrp3" Path="Value" Mode="OneWay"/>
              </MultiBinding>
            </smc:MaskedTextBox.InputMask>
          </smc:MaskedTextBox>
          <smc:MaskedTextBox Name="txtGrp2" Format="M" Width="38" Margin="12,0,12,0" VerticalAlignment="Center" TabIndex="20"
                             Value="{smc:BindingEx group2}">
            <smc:MaskedTextBox.InputMask>
              <MultiBinding Converter="{StaticResource GroupValidConverter}" ConverterParameter="NH2">
                <Binding ElementName="txtGrp1" Path="Value" Mode="OneWay"/>
                <Binding ElementName="txtGrp3" Path="Value" Mode="OneWay"/>
              </MultiBinding>
            </smc:MaskedTextBox.InputMask>
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource GroupEnableConvert}" ConverterParameter="NH2">
                <Binding ElementName="txtGrp1" Path="Value" Mode="OneWay"/>
              </MultiBinding>
            </UIElement.IsEnabled>
          </smc:MaskedTextBox>
          <smc:MaskedTextBox Name="txtGrp3" Format="M" Width="38" VerticalAlignment="Center" TabIndex="30"
                             Value="{smc:BindingEx group3}">
            <smc:MaskedTextBox.InputMask>
              <MultiBinding Converter="{StaticResource GroupValidConverter}" ConverterParameter="NH3">
                <Binding ElementName="txtGrp1" Path="Value" Mode="OneWay"/>
                <Binding ElementName="txtGrp2" Path="Value" Mode="OneWay"/>
              </MultiBinding>
            </smc:MaskedTextBox.InputMask>
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource GroupEnableConvert}" ConverterParameter="NH2">
                <Binding ElementName="txtGrp1" Path="Value" Mode="OneWay"/>
                <Binding ElementName="txtGrp2" Path="Value" Mode="OneWay"/>
              </MultiBinding>
            </UIElement.IsEnabled>
          </smc:MaskedTextBox>
        </StackPanel>
        <TextBlock Name="lblSort" Grid.Row="1" Grid.Column="0" Text="Sắp xếp theo" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
          <smc:MaskedTextBox Width="38" HorizontalAlignment="Left" Format="M" InputMask="0,1" VerticalAlignment="Center"
                             TabIndex="40" Text="{smc:BindingEx sortby}"/>
          <TextBlock Name="lblSortDescription" Margin="12,0" Text="0 - Tên vật tư, 1 - Mã vật tư"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </smc:GridLayout>
    </Border>
  </smc:ConfirmGridView>
</SasFormReport:FormFilter>
