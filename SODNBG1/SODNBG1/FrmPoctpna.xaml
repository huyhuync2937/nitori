                                  KeyDown="GrdCt_KeyDown" x:Name="GrdCt" TabIndex="120" IsVoucher="true"
                                  Tag="{Binding Path=Value, Source={StaticResource IsInEditMode}}">
                                    <FrameworkElement.Resources>
                                        <DataTemplate x:Key="ControlSearchMaVatTu">
                                            <smc:AutoCompleteTextBox nRow="6" IsBorderTextBox="false" AllowEmty="false" AllowWrong="false"
