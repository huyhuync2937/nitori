                 Text="Số lượng"/>
            <smc:NumericTextBox x:Name="txtso_luong" IsEnabled="false" Grid.Row="0" Grid.Column="1"
                          Value="{smc:BindingEx Path=t_so_luong}"
                          Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_SL}"/>
        </Grid>
        <smc:GridLayout Name="GrdLayout10" Row="1" RowCount="1" RowHeights="*" ColumnCount="5"
                    ColumnWidths="23*,10,45*,12,276" Margin="12,4,12,12">
