                                                <smc:ExSummaryDefinition SourceFieldName="tien2_duyet" Calculator="Sum"
                                                 Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>
                                                <smc:ExSummaryDefinition SourceFieldName="tien_km" Calculator="Sum"
                                                 Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>
                                                <smc:ExSummaryDefinition SourceFieldName="thue" Calculator="Sum"
                                                 Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>
                                                <smc:ExSummaryDefinition SourceFieldName="thue_nt" Calculator="Sum"
                                                 Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN_NT}"/>
                                                <smc:ExSummaryDefinition SourceFieldName="ck" Calculator="Sum"
