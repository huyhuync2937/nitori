                <smc:GridLayout Name="GrdLayout35" RowCount="5" ColumnCount="5" HeightPerRow="25" ColumnWidths="100,140,*,100,140">

                    <TextBlock Name="tblma_ncc" Text="Mã NCC (F11)" Grid.Row="0" Grid.Column="0" Style="{StaticResource ContentTextStyle}"/>
                    <TextBox PreviewKeyUp="txtMa_ncc_PreviewKeyUp" Name="txtMa_ncc" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" 
                             Style="{StaticResource TextBoxEditModeEnable}" Text="{smc:BindingEx Path=ncc}" TabIndex="25"/>
                    <!--<smc:AutoCompleteTextBox PreviewLostFocus="txtMa_ncc_PreviewLostFocus"  x:Name="txtMa_ncc"
                                   Height="20" Grid.Column="1" Grid.Row="0" TabIndex="1" AllowEmty="False" AllowWrong="false"
                                   ListID="dmkh" Style="{StaticResource AutoCompleteTextBoxEditModeEnable}"
                                   Text="{smc:BindingEx Path=ncc}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="tblTenncc" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}" Text="{smc:BindingEx Path=ten_kh, Path2=ten_kh2}"/>-->

                    <TextBlock Text="Địa chỉ" Grid.Row="1" Grid.Column="0" Style="{StaticResource ContentTextStyle}"/>
                    <TextBox Name="txtDiachi" TabIndex="3" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4"
                   FontWeight="Normal" Style="{StaticResource TextBoxEditModeEnable}"
                   Text="{smc:BindingEx Path=dia_chi}"/>

                    <TextBlock Text="Người yêu cầu" Grid.Row="2" Grid.Column="0" Style="{StaticResource ContentTextStyle}"/>
                    <TextBox Name="txtNguoiyeucau" TabIndex="3" Grid.Column="1" Grid.Row="2"
                   FontWeight="Normal" Style="{StaticResource TextBoxEditModeEnable}"
                   Text="{smc:BindingEx Path=nguoi_yc}"/>

                    <TextBlock Name="tbldien_giai" Text="Diễn giải" Grid.Row="3" Grid.Column="0" Style="{StaticResource ContentTextStyle}"/>                    
                    <TextBox Name="txtDien_giai" TabIndex="3" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="4"
                   FontWeight="Normal" Style="{StaticResource TextBoxEditModeEnable}"
                   Text="{smc:BindingEx Path=dien_giai}"/>

                    <TextBlock Text="Hạn báo giá" Grid.Row="4" Grid.Column="0" Style="{StaticResource ContentTextStyle}"/>
                    <smc:DateTextBox x:Name="txtHanbaogia" Height="20" Grid.Column="1"
                           Grid.Row="4" TabIndex="60" Style="{StaticResource DateTextBoxEditModeEnable}"
                           Value="{smc:BindingEx Path=han_baogia}"/>

                </smc:GridLayout>
            </GroupBox>
            <GroupBox Name="gbVoucher" Header="Chứng từ" Grid.Column="4" Grid.Row="0">
                <smc:GridLayout Name="GrdVoucher" ColumnCount="3" ColumnWidths="5*,43,140" RowHeights="25,25,25,25,60*"
                        RowCount="5" Margin="0">
                    <TextBlock Name="tblngay_ct" Text="Ngày báo giá" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:DateTextBox LostFocus="txtNgay_ct_LostFocus" x:Name="txtNgay_ct" Height="20" AllowEmpty="false" Grid.Column="2"
                           Grid.Row="0" TabIndex="60" Style="{StaticResource DateTextBoxEditModeEnable}"
                           Value="{smc:BindingEx Path=ngay_ct}"/>
                    <TextBlock Name="tblma_qs" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Quyển c.từ"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_qs_PreviewLostFocus" x:Name="txtMa_qs" Height="20" Grid.Column="2"
                                   Grid.Row="1" TabIndex="70" AllowEmty="false" AllowWrong="false" ListID="dmqs"
                                   Filter="ma_cts like '%DNG%' and status = 1"
                                   Style="{StaticResource AutoCompleteTextBoxEditModeEnable}" Text="{smc:BindingEx Path=ma_qs}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="tblso_ct" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Số báo giá"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox GotFocus="txtSo_ct_GotFocus" LostFocus="txtSo_ct_LostFocus" x:Name="txtSo_ct" Height="20"
                   Grid.Column="2" Grid.Row="2" TabIndex="80" CharacterCasing="Upper"
                   Style="{StaticResource TextBoxEditModeEnable}" Text="{smc:BindingEx Path=so_ct}">
                    </TextBox>
                   
                    <smc:GridLayout Name="GrdLayoutStatus" Column="0" Row="3" ColumnSpan="3" ColumnCount="2" ColumnWidths="*,140"
                          KeyboardNavigation.TabNavigation="None">
                        <TextBlock Name="tblStatus" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                       Style="{StaticResource ContentTextStyle}"
                       Text="{Binding Path=Value, Source={StaticResource IsInEditMode}, Converter={StaticResource TextStatus}}"/>
                        <igEditors:XamComboEditor Name="cb_status" Grid.Column="2" Grid.Row="0" TabIndex="74" SelectedIndex="0" Value="{smc:BindingEx status}" Style="{StaticResource ComboBoxEditModeEnable}">
                            <igEditors:XamComboEditor.ItemsProvider>
                                <igEditors:ComboBoxItemsProvider>
                                    <igEditors:ComboBoxItemsProvider.Items>
                                        <smc:ExComboBoxDataItem DisplayText="Lập phiếu" DisplayText2="All" Value="1"/>
                                        <smc:ExComboBoxDataItem DisplayText="Đóng phiếu" DisplayText2="Unposted" Value="2"/>                                      
                                    </igEditors:ComboBoxItemsProvider.Items>
                                </igEditors:ComboBoxItemsProvider>
                            </igEditors:XamComboEditor.ItemsProvider>
                        </igEditors:XamComboEditor>
                    </smc:GridLayout>
                    
                    <smc:GridLayout Grid.Row="4" Grid.ColumnSpan="3" ColumnCount="2" ColumnWidths="100*,140" RowHeights="50*" RowCount="1" Margin="0,5,0,0">
                        <Button Grid.Column="0" Content="Chọn yêu cầu" TabIndex="90" Width="100" Name="BtnChondonhang" Click="BtnChondonhang_Click" Style="{StaticResource ButtonEditModeEnable}"></Button>
                        <TextBox Grid.Column="1" Height="20" Grid.Row="3" TabIndex="91" IsEnabled="False" Style="{StaticResource TextBoxEditModeEnable}" Text="{smc:BindingEx Path=so_yeucau}"/>
                    </smc:GridLayout>

                </smc:GridLayout>
            </GroupBox>
        </smc:GridLayout>
        <smc:GridLayout Name="GrdLayout33" Row="2" Column="0" Margin="12,0,12,4" KeyboardNavigation.TabIndex="120"
                    KeyboardNavigation.TabNavigation="Local">
            <igWindows:XamTabControl x:Name="TabInfo" Grid.Row="0" Grid.Column="0" Theme="Generic" Background="{x:Null}">
                <Control.BorderBrush>
                    <SolidColorBrush Color="#FFD0D0BF" igThemes:ResourceWasher.WashGroup="Selected"/>
                </Control.BorderBrush>
                <FrameworkElement.Resources>
                    <Style TargetType="{x:Type igWindows:TabItemEx}" BasedOn="{StaticResource TabItemStyle}"/>
                </FrameworkElement.Resources>
                <igWindows:TabItemEx x:Name="tiHT" Header="_1. Chi tiết" TabIndex="120" Background="{x:Null}">
                    <Control.BorderBrush>
                        <SolidColorBrush Color="#FFD0D0BF" igThemes:ResourceWasher.WashGroup="BaseColor"/>
