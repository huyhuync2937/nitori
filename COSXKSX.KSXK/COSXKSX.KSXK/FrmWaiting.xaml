<smc:Form x:Class="COSXKSX.KSXK.FrmWaiting"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:smc="http://sis.vn/SasControls"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          Name="FrmWaitingExecute" LanguageID="COSXKSX.KSXK_Waiting" Height="218" Width="427"
          Title="SASERP 20 .NET" WindowStyle="None" AllowsTransparency="true" Background="Transparent"
          ResizeMode="NoResize">
  <Grid Height="121" Width="314">
    <Border Background="White" BorderBrush="BlanchedAlmond" BorderThickness="2" CornerRadius="5" Padding="5"
            Margin="0,0,0,12">
      <HeaderedContentControl>
        <HeaderedContentControl.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.ColumnSpan="2" Fill="LightBlue"/>
            <TextBlock Grid.Column="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="3"
                       Text="SASERP 20 .NET"/>
          </Grid>
        </HeaderedContentControl.Header>
        <ContentControl.Content>
          <smc:GridLayout RowCount="4" RowHeights="12,25,25,12" ColumnCount="3" ColumnWidths="12,*,12">
            <TextBlock Name="lblMessage" Text="Đang thực hiện ..." Grid.Row="1" Grid.Column="1"/>
            <ProgressBar Name="PBar" Grid.Row="2" Grid.Column="1" IsIndeterminate="false"/>
          </smc:GridLayout>
        </ContentControl.Content>
      </HeaderedContentControl>
    </Border>
  </Grid>
</smc:Form>