<SasFormReport:FormFilter x:Class="COSXKSX.KSXK.FrmTim"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:COSXKSX.KSXK"
                     xmlns:smc="http://sis.vn/SasControls"
                     xmlns:smvc="clr-namespace:SasVoucherLib;assembly=SasVoucherLib"
                     xmlns:igEditors="http://infragistics.com/Editors"
                     xmlns:igDP="http://infragistics.com/DataPresenter"
                     xmlns:my="clr-namespace:System;assembly=mscorlib"
                     xmlns:SasFormReport="clr-namespace:SasFormReport;assembly=SasFormReport"
                     Loaded="FrmTim_Loaded" KeyUp="FrmTim_KeyUp" Name="FrmFilter" LanguageID="COSXLSX_KSX_3"
                     Title="Loc chung tu" Height="680" Width="960">
  <FrameworkElement.Resources>
    <smvc:BindingStatusVoucher x:Key="StatusVoucher"/>
    <smc:NotNullConverter x:Key="NotNullControl"/>
  </FrameworkElement.Resources>
  <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" OnCancel="ConfirmGridView_OnCancel" Name="grdConfirm">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <smc:CodeValueBindingObject x:Key="IsInEditMode" Value="false"/>
        <Style x:Key="ComboBoxEditModeEnable" TargetType="{x:Type igEditors:XamComboEditor}"
               BasedOn="{StaticResource XamComboEditorStyle}">
          <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_act"/>
          <Setter Property="UIElement.IsEnabled" Value="true"/>
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="False"/>
                <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type smvc:FormTrans}}}"
                           Value="E"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_act2"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="True"/>
                <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type smvc:FormTrans}}}"
                           Value="V"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_post"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="True"/>
                <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type smvc:FormTrans}}}"
                           Value="E"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_post2"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="True">
              <Setter Property="UIElement.IsEnabled" Value="true"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:GridLayout RowCount="2" RowHeights="180,*">
      <Grid Name="notUsed" Visibility="Hidden" Row="1">
        <TextBlock Name="tblSotien1" Grid.Column="0" Grid.Row="4" Text="Số tiền từ"
                   Style="{StaticResource ContentTextStyle}" Margin="0"/>
        <smc:NumericTextBox x:Name="txtSoTien1" TabIndex="55" Margin="0,2" Grid.Column="1" Grid.Row="4" Format="#,###"/>
        <TextBlock Name="tblSotien2" Grid.Column="3" Grid.Row="4" Text="Đến" Style="{StaticResource ContentTextStyle}"
                   Margin="0"/>
        <smc:NumericTextBox x:Name="txtSoTien2" TabIndex="60" Margin="0,2" Grid.Column="4" Grid.Row="4" Format="#,###"/>
        <TextBlock Name="tblHanThanhToan1" Grid.Column="0" Grid.Row="5" Text="Hạn thanh toán từ"
                   Style="{StaticResource ContentTextStyle}" Margin="0"/>
        <smc:NumericTextBox x:Name="txtHanThanhToan1" TabIndex="65" Margin="0,2" Grid.Column="1" Format="#" Grid.Row="5"/>
        <TextBlock Name="tblHanThanhToan2" Grid.Column="3" Grid.Row="5" Text="Đến"
                   Style="{StaticResource ContentTextStyle}" Margin="0"/>
        <smc:NumericTextBox x:Name="txtHanThanhToan2" TabIndex="70" Margin="0,2" Grid.Column="4" Format="#" Grid.Row="5"/>
      </Grid>
      <GroupBox Name="grpLocCT" Header="Điều kiện lọc" Grid.Column="0" Grid.Row="0" Margin="12,4,12,0">
        <smc:GridLayout Name="GrdPhLoc" RowCount="10" RowHeights="25,25,25,0,0,0,25,25,25,*" ColumnCount="8"
                        ColumnWidths="130,140,12,100,140,12,*" Margin="0">
          <TextBlock Name="tblma_qs" Grid.Column="0" Grid.Row="0" Text="Quyển c.từ"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_qs_PreviewLostFocus" Name="txtMa_qs" Grid.Column="1" Grid.Row="0"
                                   TabIndex="1" IsFocus="true" AllowEmty="true" AllowWrong="false" ListID="dmqs"
                                   Filter="ma_cts like '%KSX%' and status =1" Margin="0,2"
                                   Text="{smc:BindingEx Path=M_MA_QS, ElementName=FrmFilter}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
          <TextBlock Name="lbltenqs" Grid.Column="3" Grid.ColumnSpan="4" Grid.Row="0"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <TextBlock Name="tblso_ct1" Grid.Column="0" Grid.Row="1" Text="Lsx từ số"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <TextBox Name="txtSo_ct1" Grid.Column="1" Grid.Row="1" TabIndex="10" Margin="0,2"/>
          <TextBlock Name="tblso_ct2" Grid.Column="3" Grid.Row="1" Text="Đến số"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <TextBox Name="txtSo_ct2" Grid.Column="4" Grid.Row="1" TabIndex="12" Margin="0,2"/>
          <TextBlock Name="tblngay_ct1" Grid.Column="0" Grid.Row="2" Text="Lsx từ ngày"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <smc:DateTextBox Name="txtNgay_ct1" DisplayMode="IncludeBoth" Grid.Column="1" Grid.Row="2" IsAlwaysInEditMode="true"
                           TabIndex="20" Margin="0,2" Value="{smc:BindingEx Path=M_NGAY_CT1, ElementName=FrmFilter}"/>
          <TextBlock Name="tblngay_ct2" Grid.Column="3" Grid.Row="2" Text="Đến ngày"
                     Style="{StaticResource ContentTextStyle}"/>
          <smc:DateTextBox Name="txtNgay_ct2" DisplayMode="IncludeBoth" Grid.Column="4" Grid.Row="2" IsAlwaysInEditMode="true"
                           TabIndex="30" Margin="0,2" Value="{smc:BindingEx Path=M_NGAY_CT2, ElementName=FrmFilter}"/>
          <TextBlock Name="tblUser" Grid.Column="0" Grid.Row="8" Text="Lọc theo NSD"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <smc:MaskedTextBox TextChanged="txtUser_TextChanged" Name="txtUser" Grid.Column="1" Grid.Row="8" TabIndex="77"
                             Format="M" InputMask="0,1" Margin="0,2" Style="{StaticResource MaskedTextBoxStyle}"/>
          <TextBlock Name="tblUserCoKhong" Grid.Column="3" Grid.Row="8" Grid.ColumnSpan="4" Text="0 - Không, 1 - Có"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <TextBlock Name="tblStatus" Grid.Column="0" Grid.Row="6" Style="{StaticResource ContentTextStyle}"
                     Text="Trạng thái"/>
          <igEditors:XamComboEditor Name="cb_status" Style="{StaticResource ComboBoxEditModeEnable}" ValuePath="ma_post"
                                    Grid.Column="1" Height="20" Margin="0" Grid.Row="6" TabIndex="48"
                                    SelectedIndex="{Binding Path=status, Converter={StaticResource StatusVoucher}}"/>
          <TextBlock Name="tblma_dvcs" Grid.Column="0" Grid.Row="7" Text="Mã ĐVCS"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
          <smc:AutoCompleteTextBox LostFocus="txtMa_dvcs_LostFocus" Name="txtMa_dvcs" Grid.Column="1" Grid.Row="7" TabIndex="76"
                                   AllowEmty="true" AllowWrong="false" ListID="dmdvcs" Margin="0,2"
                                   Text="{smc:BindingEx Path=M_MA_DVCS, ElementName=FrmFilter}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
          <TextBlock Name="tblten_dvcs" Grid.Column="3" Grid.Row="7" Grid.ColumnSpan="4"
                     Style="{StaticResource ContentTextStyle}" Margin="0"/>
        </smc:GridLayout>
      </GroupBox>
      <smc:GridLayout Row="1" Margin="12,4,12,0">
        <SasFormReport:ControlDetailFilter3 x:Name="GridSearch" FontWeight="Normal"/>
      </smc:GridLayout>
    </smc:GridLayout>
    <Canvas Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,100,33"/>
    <TextBlock Name="tbltk_tracuu" Text="F5 - Tra cứu" HorizontalAlignment="Right" Margin="0,17.259,12,17.258"
               Grid.Row="1"/>
  </smc:ConfirmGridView>
</SasFormReport:FormFilter>
