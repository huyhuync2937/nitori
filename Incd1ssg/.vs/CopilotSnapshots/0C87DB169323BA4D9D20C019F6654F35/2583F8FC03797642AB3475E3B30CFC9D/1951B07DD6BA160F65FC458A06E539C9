    #region Helper Methods

    private static string SafeToString(object obj)
    {
        return obj != null ? obj.ToString() : "";
    }

    private static string GetCellString(DataRecord record, string fieldName)
    {
        if (record == null || record.Cells[fieldName] == null)
            return "";

        object value = record.Cells[fieldName].Value;
        return value != null ? value.ToString().Trim() : "";
    }

    private static DateTime GetCellDateTime(DataRecord record, string fieldName, DateTime defaultValue)
    {
        string value = GetCellString(record, fieldName);
        if (string.IsNullOrEmpty(value))
            return defaultValue;

        try
        {
            return Convert.ToDateTime(value);
        }
        catch
        {
            return defaultValue;
        }
    }

    private static double GetCellDouble(DataRecord record, string fieldName)
    {
        string value = GetCellString(record, fieldName);
        if (string.IsNullOrEmpty(value))
            return 0;

        double result = 0;
        double.TryParse(value, out result);
        return result;
    }

    private static double GetRowDouble(DataRowView row, string fieldName)
    {
        object value = row[fieldName];
        if (value == null)
            return 0;

        double result = 0;
        double.TryParse(value.ToString(), out result);
        return result;
    }

    private static void HandleException(Exception ex)
    {
        ErrorLog.CatchMessage(ex);
    }


    public static DataRow GetDVTKL(string ma_sp)
    {
        string sql = "SELECT * FROM v_dmvtdvt WHERE ma_vt = @ma_sp and hs_qd <> 1 ";

        using (SqlCommand sqlCommand = new SqlCommand(sql))
        {
            sqlCommand.Parameters.Add("@ma_sp", SqlDbType.Char, 16).Value = ma_sp;

            DataSet dataSet = StartupBase.SasObj.ExcuteReader(sqlCommand);
            return (dataSet.Tables.Count > 0 && dataSet.Tables[0].Rows.Count > 0)
                ? dataSet.Tables[0].Rows[0]
                : null;
        }
    }

    public static string GetCaKetThuc(double soCa, string ma_ca)
    {
        int ca = (int)Math.Ceiling(soCa); // làm tròn lên

        int startIndex;
        if (ma_ca == "CA01")
            startIndex = 1;
        else if (ma_ca == "CA02")
            startIndex = 2;
        else if (ma_ca == "CA03")
            startIndex = 3;
        else
            startIndex = 1;

        int totalCa = startIndex - 1 + ca;

        int index = ((totalCa - 1) % 3) + 1;

        if (index == 1)
            return "CA01";
        else if (index == 2)
            return "CA02";
        else
            return "CA03";
    }


    public static DateTime GetNgayKetThuc(double soCa, DateTime ngay_bd, string ma_ca)
    {

        int startIndex;
        switch (ma_ca)
        {
            case "CA01":
                startIndex = 1;
                break;
            case "CA02":
                startIndex = 2;
                break;
            case "CA03":
                startIndex = 3;
                break;
            default:
                startIndex = 1;
                break;
        }

        int totalCa = startIndex - 1 + (int)Math.Ceiling(soCa);

        int soNgayTang = (totalCa - 1) / 3;

        return ngay_bd.AddDays(soNgayTang);
    }

