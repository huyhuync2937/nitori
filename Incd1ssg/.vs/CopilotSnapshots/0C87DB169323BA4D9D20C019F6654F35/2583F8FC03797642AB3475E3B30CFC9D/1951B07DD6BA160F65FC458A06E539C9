    #region Dialog and Confirmation

    private static bool ShowFormDialog(FrmSetValue frm)
    {
        bool? result = frm.ShowDialog();
        return (result.HasValue && result.Value) &&
               frm.cbField.Value != null &&
               SafeToString(frm.cbField.Value).Trim() != "";
    }

    private static bool ConfirmUpdate()
    {
        MessageBoxResult result = ExMessageBox.Show(
            Messages.CONFIRM_UPDATE,
            StartupBase.SasObj,
            "Có muốn cập nhật số liệu không?",
            "",
            MessageBoxButton.YesNo,
            MessageBoxImage.Question,
            MessageBoxResult.Yes
        );

        return result == MessageBoxResult.Yes;
    }

