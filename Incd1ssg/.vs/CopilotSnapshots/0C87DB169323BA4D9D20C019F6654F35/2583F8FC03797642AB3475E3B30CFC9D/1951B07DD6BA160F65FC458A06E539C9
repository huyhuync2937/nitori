    // Field constants to avoid magic strings
    private static class FieldNames
    {
        public const string CHON = "chon";
        public const string MA_NVL_GOP = "ma_nvl_gop";
        public const string VUNG_MAY = "vung_may";
        public const string NHOM_MAY = "nhom_may";
        public const string NGAY_BD = "ngay_bd";
        public const string NGAY_KT = "ngay_kt";
        public const string SO_CA = "so_ca";
        public const string MA_MAY = "ma_may";
        public const string MA_CA = "ma_ca";
        public const string MA_CA_KT = "ma_ca_kt";
        public const string SS = "ss";
        public const string SL_KG_LENH = "sl_kg_lenh";
        public const string SL_CAI_LENH = "sl_cai_lenh";
        public const string NSC = "nsc";
        public const string SO_CA_LENH = "so_ca_lenh";
        public const string HS_QD = "hs_qd";
        public const string DM_TS = "dmts";
        public const string DM_CA = "dmca";
