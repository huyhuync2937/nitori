    private static class Messages
    {
        public const int UPDATE_ONE_BY_ONE = 556;
        public const int MACHINE_CONFLICT = 555;
        public const int CONFIRM_UPDATE = 1122;
    }

    // Main entry point
    public static void Execute()
    {
        try
        {
            // Validation
            if (!ValidatePrerequisites())
                return;

            CellInfo cellInfo = ExtractCellInfo();
            if (cellInfo == null)
                return;

            FrmSetValue frmSetValue = CreateAndConfigureForm(cellInfo.Value.ToString(), cellInfo.FieldName);

            if (!ShowFormDialog(frmSetValue))
                return;

            if (!ConfirmUpdate())
                return;

            UpdateData updateData = ExtractUpdateData(frmSetValue, cellInfo);
            ExecuteUpdates(updateData);
        }
        catch (Exception ex)
        {
            HandleException(ex);
        }
    }

    #region Validation Methods

    private static bool ValidatePrerequisites()
    {
        return StartUp.CanChangeValueFields != null &&
               StartUp.CanChangeValueFields.Length > 0 &&
               StartUp.oBrowse.frmBrw.oBrowse.ActiveCell != null;
    }

    private static bool IsValidEditableField(string fieldName)
    {
        string[] validFields = new[]
        {
            FieldNames.NGAY_BD, FieldNames.MA_MAY, FieldNames.MA_CA,
            FieldNames.NGAY_KT, FieldNames.MA_CA_KT, FieldNames.SL_KG_LENH,
            FieldNames.SL_CAI_LENH
        };

        foreach (string field in validFields)
        {
            if (field == fieldName)
                return true;
        }
        return false;
    }

    private static bool CanChangeField(string fieldName)
    {
        foreach (string field in StartUp.CanChangeValueFields)
        {
            if (field == fieldName)
                return true;
        }
        return false;
    }

    #endregion

    #region Cell Info Extraction

    private class CellInfo
    {
        public string FieldName { get; set; }
        public object Value { get; set; }
        public DataRecord Record { get; set; }
    }

    private static CellInfo ExtractCellInfo()
    {
        Cell cell = StartUp.oBrowse.frmBrw.oBrowse.ActiveCell;
        string fieldName = cell.Field.Name.ToString();

        if (!IsValidEditableField(fieldName))
            return null;

        if (StartUp.oBrowse.ActiveRecord != null)
        {
            EndEditMode();
            StartUp.oBrowse.ActiveRecord.Update();
        }

        CellInfo cellInfo = new CellInfo();
        cellInfo.FieldName = fieldName;
        cellInfo.Value = CanChangeField(fieldName) ? cell.Value : "";
        cellInfo.Record = cell.Record as DataRecord;

        return cellInfo;
    }

    private static void EndEditMode()
    {
        Cell activeCell = StartUp.oBrowse.DataGrid.ActiveCell;
        if (activeCell != null && activeCell.IsInEditMode)
            activeCell.EndEditMode();
    }

    #endregion

    #region Form Creation and Configuration

    private static FrmSetValue CreateAndConfigureForm(string oldValue, string fieldName)
    {
        FrmSetValue frm = new FrmSetValue(oldValue, fieldName);
        frm.cbField.ItemsProvider = new ComboBoxItemsProvider();
        frm.cbField.ValuePath = "Value";

        PopulateFieldCombo(frm);
        SetFieldValue(frm, fieldName);
        ConfigureFormByFieldType(frm, fieldName);

        return frm;
    }

    private static void PopulateFieldCombo(FrmSetValue frm)
    {
        FieldCollection fields = StartUp.oBrowse.frmBrw.oBrowse.FieldLayouts[0].Fields;

        foreach (string field in StartUp.CanChangeValueFields)
        {
            string displayName = field;

            if (fields.Any(f => f.Name == field))
            {
                displayName = fields[field].Label.ToString();
            }

            frm.cbField.ItemsProvider.Items.Add(new ComboBoxDataItem(field, displayName));
        }
    }

    private static void SetFieldValue(FrmSetValue frm, string fieldName)
    {
        if (CanChangeField(fieldName))
        {
            frm.cbField.Value = fieldName;
        }
        else
        {
            frm.cbField.SelectedIndex = 0;
        }
    }

    private static void ConfigureFormByFieldType(FrmSetValue frm, string fieldName)
    {
        string fieldValue = SafeToString(frm.cbField.Value).Trim();

        if (fieldValue == FieldNames.MA_MAY)
        {
            ConfigureForMaMay(frm);
        }
        else if (fieldValue == FieldNames.MA_CA || fieldValue == FieldNames.MA_CA_KT)
        {
            ConfigureForMaCa(frm);
        }
        else if (fieldValue == FieldNames.NGAY_BD || fieldValue == FieldNames.NGAY_KT)
        {
            ConfigureForDate(frm);
        }
        else if (fieldValue == FieldNames.SL_KG_LENH || fieldValue == FieldNames.SL_CAI_LENH)
        {
            ConfigureForQuantity(frm);
        }

        frm.txtNewValue.IsFocus = true;
    }

    private static void ConfigureForMaMay(FrmSetValue frm)
    {
        frm.txtNewValue.ListID = FieldNames.DM_TS;
        frm.Title = "Cập nhật thông tin mã khách hàng";
        HideDateAndQuantityFields(frm);
    }

    private static void ConfigureForMaCa(FrmSetValue frm)
    {
        frm.txtNewValue.ListID = FieldNames.DM_CA;
        frm.Title = "Cập nhật thông tin mã ca";
        HideDateAndQuantityFields(frm);
    }

    private static void ConfigureForDate(FrmSetValue frm)
    {
        frm.Title = "Cập nhật thông tin ngày bắt đầu";
        HideField(frm.lblNewValue, frm.txtNewValue);
        HideField(frm.tblsl, frm.txtsl);
    }

    private static void ConfigureForQuantity(FrmSetValue frm)
    {
        frm.Title = "Cập nhật thông tin số lượng";
        HideField(frm.lblNewValue, frm.txtNewValue);
        HideField(frm.lblNgaybd, frm.txtNgay_bd);
    }

    private static void HideDateAndQuantityFields(FrmSetValue frm)
    {
        HideField(frm.lblNgaybd, frm.txtNgay_bd);
        HideField(frm.tblsl, frm.txtsl);
    }

    private static void HideField(UIElement label, UIElement input)
    {
        label.Visibility = Visibility.Hidden;
        //input.IsTabStop = false;
        input.Visibility = Visibility.Hidden;
    }

