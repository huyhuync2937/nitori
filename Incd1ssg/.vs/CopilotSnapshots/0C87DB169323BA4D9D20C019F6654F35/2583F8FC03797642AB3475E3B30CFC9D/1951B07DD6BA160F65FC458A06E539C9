    #region Conflict Validation

    private static void ValidateMachineConflict(DataRowView[] selectedRows, DataRecord record, string newMachineCode)
    {
        if (selectedRows.Length > 1)
        {
            ExMessageBox.Show(
                Messages.UPDATE_ONE_BY_ONE,
                StartupBase.SasObj,
                "Mã máy chỉ cập nhật từng dòng",
                "",
                MessageBoxButton.OK,
                MessageBoxImage.Asterisk
            );
        }

        // Check if ngay_bd and ngay_kt are set for the new machine code validation
        string ngayBdStr = GetCellString(record, FieldNames.NGAY_BD);
        string ngayKtStr = GetCellString(record, FieldNames.NGAY_KT);

        // Only validate if both dates exist
        if (string.IsNullOrEmpty(ngayBdStr) || string.IsNullOrEmpty(ngayKtStr))
            return;

        DateTime currentStartDate = Convert.ToDateTime(ngayBdStr);
        DateTime currentEndDate = Convert.ToDateTime(ngayKtStr);

        DataView dataView = StartUp.oBrowse.DataGrid.DataSource as DataView;

        foreach (DataRowView otherRow in dataView)
        {
            string otherMachineCode = SafeToString(otherRow[FieldNames.MA_MAY]).Trim();

            if (otherMachineCode == newMachineCode && !string.IsNullOrEmpty(newMachineCode))
            {
                string otherNgayBdStr = SafeToString(otherRow[FieldNames.NGAY_BD]).Trim();
                string otherNgayKtStr = SafeToString(otherRow[FieldNames.NGAY_KT]).Trim();

                // Only compare if both dates exist in the other row
                if (!string.IsNullOrEmpty(otherNgayBdStr) && !string.IsNullOrEmpty(otherNgayKtStr))
                {
                    DateTime otherStartDate = Convert.ToDateTime(otherNgayBdStr);
                    DateTime otherEndDate = Convert.ToDateTime(otherNgayKtStr);

                    // Check if the new date range falls within or overlaps with existing range
                    // Allow only if new range is completely outside (before or after) the existing range
                    if (!(currentEndDate < otherStartDate || currentStartDate > otherEndDate))
                    {
                        ExMessageBox.Show(
                            Messages.MACHINE_CONFLICT,
                            StartupBase.SasObj,
                            "Mã máy đã sản xuất vật tư khác trong khoảng thời gian này",
                            "",
                            MessageBoxButton.OK,
                            MessageBoxImage.Asterisk
                        );
                        throw new InvalidOperationException("Machine code conflict detected");
                    }
                }
            }
        }
    }

