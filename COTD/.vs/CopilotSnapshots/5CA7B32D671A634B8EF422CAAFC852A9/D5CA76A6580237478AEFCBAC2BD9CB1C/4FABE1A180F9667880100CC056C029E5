<smc:FormList x:Class="COTD.newForm"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:COTD"
              xmlns:smc="http://sis.vn/SasControls"
              xmlns:igWindows="http://infragistics.com/Windows"
              xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors;assembly=InfragisticsWPF3.Editors.v10.2"
              Loaded="newForm_Loaded" Closed="FormList_Closed" PreviewKeyUp="FormList_PreviewKeyUp"
              Title="Them moi tu dien tu do" LanguageID="COTDNew" Width="747" Height="357">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <smc:EditModeBindingObject x:Key="IsInEditMode" IsEditMode="false"/>
      <Style x:Key="ReadOnly" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
        <Setter Property="TextBoxBase.IsReadOnly" Value="true"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
            <Setter Property="TextBoxBase.IsReadOnly" Value="false"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ReadOnlyNumericTextBox" TargetType="{x:Type smc:NumericTextBox}"
             BasedOn="{StaticResource NumericTextBoxStyle}">
        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
            <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="AutoCompleteReadOnly" TargetType="{x:Type smc:AutoCompleteTextBox}"
             BasedOn="{StaticResource AutoCompleteTextBoxStyle}">
        <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="true"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
            <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="false"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="DateTextBoxReadOnly" TargetType="{x:Type smc:DateTextBox}"
             BasedOn="{StaticResource DateTextBoxStyle}">
        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
            <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="MaskedTextBoxReadOnly" TargetType="{x:Type smc:MaskedTextBox}"
             BasedOn="{StaticResource MaskedTextBoxStyle}">
        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
            <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="XamComboEditorReadOnly" TargetType="{x:Type igEditors:XamComboEditor}"
             BasedOn="{StaticResource XamComboEditorStyle}">
        <Setter Property="UIElement.IsEnabled" Value="false"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
            <Setter Property="UIElement.IsEnabled" Value="true"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" OnCancel="ConfirmGV_OnCancel" Name="ConfirmGV">
    <smc:GridLayout Margin="12,12,12,0">
      <igWindows:XamTabControl Name="TabInfor" Theme="Generic" Margin="0,0,0,0">
        <igWindows:TabItemEx Name="TabMain" Header="_1. Thông tin chính" IsTabStop="false">
          <smc:GridLayout Name="gridMain" Margin="8,5.5,8,0" ColumnCount="6" ColumnWidths="160,140,12,140,*,140" RowCount="11"
                          RowHeights="25,25,25,0,25,25,25,25,50,25,25">
            <TextBlock Name="tblma_td" Text="Mã tự do" Grid.Row="0" Grid.Column="0"/>
            <TextBox GotFocus="txtma_td_GotFocus" x:Name="txtma_td" Grid.Column="1" Grid.Row="0" TabIndex="10"
                     CharacterCasing="Upper" Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ma_td}"/>
            <TextBlock Name="tblten_td" Text="Tên tự do" Grid.Row="1" Grid.Column="0"/>
            <TextBox x:Name="txtten_td" Grid.ColumnSpan="6" Grid.Row="1" Grid.Column="1" TabIndex="30"
                     Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ten_td}"/>
            <TextBlock Name="tblten_td2" Text="Tên 2" Grid.Row="2" Grid.Column="0"/>
            <TextBox x:Name="txtten_td2" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="5" TabIndex="40"
                     Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ten_td2}"/>
            <TextBlock x:Name="txtten_bpkd" Margin="12,0,0,0" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="4"
                       Text="{smc:BindingEx Path=ten_bpkd, Path2=ten_bpkd}"/>
            <TextBlock Name="tblnh_td1" Text="Phân nhóm kiểu 1" Grid.Row="4" Grid.Column="0"/>
            <smc:AutoCompleteTextBox PreviewLostFocus="txtnh_td1_PreviewLostFocus" Name="txtnh_td1" Grid.Column="1" Grid.Row="4"
                                     TabIndex="180" AllowWrong="false" AllowEmty="true" Style="{StaticResource AutoCompleteReadOnly}"
                                     Text="{smc:BindingEx nh_td1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                     ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
            <TextBlock x:Name="txtten_nh_td1" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0" Grid.Row="4"
                       Text="{smc:BindingEx ten_nh_td1}"/>
            <TextBlock Name="tblnh_td2" Text="Phân nhóm kiểu 2" Grid.Row="5" Grid.Column="0"/>
            <smc:AutoCompleteTextBox PreviewLostFocus="txtnh_td2_PreviewLostFocus" Name="txtnh_td2" Grid.Column="1" Grid.Row="5"
                                     TabIndex="190" AllowWrong="false" AllowEmty="true" Style="{StaticResource AutoCompleteReadOnly}"
                                     Text="{smc:BindingEx nh_td2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                     ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
            <TextBlock x:Name="txtten_nh_td2" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="5" Margin="12,0,0,0"
                       Text="{smc:BindingEx ten_nh_td2}"/>
            <TextBlock Name="tblnh_td3" Text="Phân nhóm kiểu 3" Grid.Row="6" Grid.Column="0"/>
            <smc:AutoCompleteTextBox PreviewLostFocus="txtnh_td3_PreviewLostFocus" Name="txtnh_td3" Grid.Column="1" Grid.Row="6"
                                     TabIndex="200" AllowWrong="false" AllowEmty="true" Style="{StaticResource AutoCompleteReadOnly}"
                                     Text="{smc:BindingEx nh_td3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                     ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
            <TextBlock x:Name="txtten_nh_td3" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="6" Margin="12,0,0,0"
                       Text="{smc:BindingEx ten_nh_td3}"/>
            <TextBlock Name="tblhe_so" Text="Hệ số" Grid.Row="7" Grid.Column="0"/>
            <smc:NumericTextBox x:Name="txthe_so" Grid.Column="1" Grid.Row="7" TabIndex="210"
                                Style="{StaticResource ReadOnlyNumericTextBox}" Value="{smc:BindingEx he_so}"/>
            <TextBlock Name="tblghi_chu" Text="Ghi chú" Grid.Row="8" Grid.Column="0" VerticalAlignment="Top"
                       Margin="0,5,0,0"/>
            <TextBox PreviewKeyDown="txtghi_chu_PreviewKeyDown" x:Name="txtghi_chu" Grid.Column="1" Grid.Row="8"
                     Grid.ColumnSpan="5" TabIndex="220" Height="45" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ghi_chu}"/>
            <TextBlock Name="tblstatus" Text="Trạng thái" Grid.Row="9" Grid.Column="0"/>
            <StackPanel Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="9" Orientation="Horizontal">
              <smc:MaskedTextBox LostFocus="txtstatus_LostFocus" Name="txtstatus" Format="M" InputMask="0,1,2,3,4" Width="38"
                                 TabIndex="230" Style="{StaticResource MaskedTextBoxReadOnly}" Value="{smc:BindingEx status}"/>
              <TextBlock Name="txtstatus_ghi_chu" Text="0 - Không còn sử dụng, 1 - Còn sử dụng" Margin="12,0,0,0"/>
            </StackPanel>
          </smc:GridLayout>
        </igWindows:TabItemEx>
        <igWindows:TabItemEx Name="TabEx" IsTabStop="false" Header="_2. Thông tin khác"/>
      </igWindows:XamTabControl>
    </smc:GridLayout>
  </smc:ConfirmGridView>
</smc:FormList>