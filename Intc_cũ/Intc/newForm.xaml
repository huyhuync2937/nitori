<smc:FormList x:Class="Intc.newForm"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:smc="http://sis.vn/SasControls"
              xmlns:igWindows="http://infragistics.com/Windows"
              xmlns:igEditors="clr-namespace:Infragistics.Windows.Editors.Events;assembly=InfragisticsWPF3.Editors.v10.2"
              Loaded="newForm_Loaded" Closed="FormList_Closed" PreviewKeyUp="FormList_PreviewKeyUp"
              Title="Them moi tieu chi" LanguageID="Arkh_0" Width="745" Height="400">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <smc:EditModeBindingObject x:Key="IsInEditMode" IsEditMode="false"/>
            <Style x:Key="MaskedTextBoxReadOnly" TargetType="{x:Type smc:MaskedTextBox}"
             BasedOn="{StaticResource MaskedTextBoxStyle}">
                <Setter Property="IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnly" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                <Setter Property="TextBoxBase.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnlyNumericTextBox" TargetType="{x:Type smc:NumericTextBox}"
             BasedOn="{StaticResource NumericTextBoxStyle}">
                <Setter Property="IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AutoCompleteReadOnly" TargetType="{x:Type smc:AutoCompleteTextBox}"
             BasedOn="{StaticResource AutoCompleteTextBoxStyle}">
                <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnlyDateTime" TargetType="{x:Type smc:DateTextBox}"
             BasedOn="{StaticResource DateTextBoxStyle}">
                <Setter Property="smc:DateTextBox.IsReadOnly" Value="true"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEditMode, Source={StaticResource IsInEditMode}}" Value="True">
                        <Setter Property="smc:DateTextBox.IsReadOnly" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:ConfirmGridView OnCancel="ConfirmGV_OnCancel" OnOk="ConfirmGridView_OnOk" Name="ConfirmGV">
        <smc:GridLayout Margin="12,4,12,0">
            <igWindows:XamTabControl Name="TabInfor">
                <FrameworkElement.Resources>
                    <Style TargetType="{x:Type igWindows:TabItemEx}" BasedOn="{StaticResource TabItemStyle}"/>
                </FrameworkElement.Resources>
                <igWindows:TabItemEx Name="TabMain" Header="_1. Thông tin chính" IsTabStop="True">
                    <smc:GridLayout Name="gridMain" Margin="8,0,8,0" RowCount="5" RowHeights="253,107,107,*">
                        <GroupBox Name="gbHT" Header="Thông tin chung">
                            <HeaderedContentControl.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background, ElementName=TabInfor}">
                                        <ContentPresenter Content="{TemplateBinding ContentPresenter.Content}"/>
                                    </Border>
                                </DataTemplate>
                            </HeaderedContentControl.HeaderTemplate>
                            <smc:GridLayout RowCount="10" RowHeights="25,25,25,25,25,25,25,25,25,*" ColumnCount="6"
                              ColumnWidths="180,140,12,100,*,140">
                                <TextBlock Name="tblma_tieu_chi" Text="Mã tiêu chí" Grid.Row="0" Grid.Column="0"/>
                                <TextBox GotFocus="txtma_tieu_chi_GotFocus" x:Name="txtma_tieu_chi" Grid.Column="1" Grid.Row="0" TabIndex="10"
                         CharacterCasing="Upper" Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ma_tieu_chi}"/>
                               
                                <TextBlock Name="tblten_tieu_chi" Text="Tên tiêu chí" Grid.Row="1" Grid.Column="0"/>
                                <TextBox x:Name="txtten_tieu_chi" Grid.ColumnSpan="5" Grid.Row="1" Grid.Column="1" TabIndex="30"
                         Style="{StaticResource ReadOnly}" Text="{smc:BindingEx ten_tieu_chi}"/>    
                                <TextBlock Name="tblmuc_tieu" Text="Mục tiêu" Grid.Row="2" Grid.Column="0"/>
                                <TextBox GotFocus="txtmuc_tieu_GotFocus" x:Name="txtmuc_tieu" Grid.Column="1" Grid.Row="2" TabIndex="75"
Style="{StaticResource ReadOnly}" Text="{smc:BindingEx muc_tieu}"/>
                                
                                <TextBlock Name="lbldvt" Grid.Row="3" Grid.Column="0" Text="DVT"/>
                                <smc:AutoCompleteTextBox LostFocus="txtdvt_LostFocus" Name="txtdvt" Grid.Row="3" Grid.Column="1" AllowEmty="true"
AllowWrong="false" ListID="dmdvt" TabIndex="200" Style="{StaticResource AutoCompleteReadOnly}"
SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
Text="{smc:BindingEx dvt}"/>
                                <TextBlock Name="txtTen_dvt" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="4" TextWrapping="NoWrap"/>

                                <TextBlock Name="tbltrong_so" Text="Trọng số" Grid.Row="4" Grid.Column="0"/>
                                <TextBox GotFocus="txtTrong_so_GotFocus" x:Name="txttrong_so" Grid.Column="1" Grid.Row="4" TabIndex="75"
Style="{StaticResource ReadOnly}" Text="{smc:BindingEx trong_so}"/>


                                <TextBlock Name="lblMa_dvcs" Grid.Row="5" Grid.Column="0" Text="Mã ĐVCS"/>
                                <smc:AutoCompleteTextBox LostFocus="txtMa_dvcs_LostFocus" Name="txtMa_dvcs" Grid.Row="5" Grid.Column="1" AllowEmty="true"
            AllowWrong="false" ListID="dmdvcs" TabIndex="200" Style="{StaticResource AutoCompleteReadOnly}"
            SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
            ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
            Text="{smc:BindingEx ma_dvcs}"/>
                                <TextBlock Name="txtTen_dvcs" Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="4" TextWrapping="NoWrap"/>
                                <TextBlock Name="tblstatus" Text="Trạng thái sử dụng" Grid.Row="6" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="6" Orientation="Horizontal">
                                    <smc:MaskedTextBox LostFocus="txtstatus_LostFocus" Name="txtstatus" Format="M" InputMask="0,1" Width="140"
        TabIndex="230" Style="{StaticResource MaskedTextBoxReadOnly}" HorizontalContentAlignment="Left"
        Value="{smc:BindingEx status}"/>
                                    <TextBlock Name="txtstatus_ghi_chu" Text="0 - Không sử dụng, 1 - Sử dụng" Margin="12,0,0,0"/>
                                </StackPanel>
                            </smc:GridLayout>
                        </GroupBox>
                    
                  
                      
                        
                    </smc:GridLayout>
                </igWindows:TabItemEx>
                          
            </igWindows:XamTabControl>
        </smc:GridLayout>
    </smc:ConfirmGridView>
</smc:FormList>