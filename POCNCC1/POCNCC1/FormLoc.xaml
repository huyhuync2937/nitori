<smr:FormFilter x:Class="POCNCC1.FormLoc"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:diagnostics="clr-namespace:System.Diagnostics;assembly=WindowsBase"
                     xmlns:smc="http://sis.vn/SasControls"
                     xmlns:igEditors="http://infragistics.com/Editors"
                     xmlns:smr="clr-namespace:SasFormReport;assembly=SasFormReport"
                     xmlns:igWindows="http://infragistics.com/Windows"
                     xmlns:sysData="clr-namespace:System.Data;assembly=System.Data"
                     xmlns:local="clr-namespace:POCNCC1"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                     Loaded="TransactionFrm_Loaded" KeyDown="TransactionFrm_KeyDown" Name="TransactionFrm"
                     ResizeMode="NoResize" Title="Bang ke don hang" Height="650" Width="910" Theme="Standard"
                     LanguageID="POCNCC1_0" WindowStartupLocation="CenterScreen" ShowInTaskbar="true">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:ConfirmGridView OnOk="btnNhan_Click" OnCancel="btnHuy_Click" Height="Auto">
        <FrameworkElement.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </FrameworkElement.Resources>
        <smc:ExTabControl Name="TabInfor" Margin="12,10,12,0" Height="Auto" Theme="Generic">
            <smc:ExTabItem Name="TabMain" Header="Thông tin chính">
                <smc:GridLayout Name="GrdLayOut" ColumnCount="8" RowCount="7" RowHeights="0,160,4,*,8"
                        ColumnWidths="8,537*,12,285,8">
                    <GroupBox Name="gbDKLoc" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1"
                    Style="{StaticResource TabGroupBoxStyle}" Header="Điều kiện lọc">
                        <smc:GridLayout RowCount="6" ColumnCount="6" Margin="0,1,0,1" ColumnWidths="100,140,12,100,140,*"
                            RowHeights="25,25,0,25,25,25,*">
                            <TextBlock Name="lblTuNgay" Text="Đh từ ngày" Grid.Row="0" Grid.Column="0" Margin="0,2"
                         VerticalAlignment="Center"/>
                            <smc:DateTextBox Name="TxtStartDateTime" Grid.Column="1" Grid.Row="0" TabIndex="1" IsTabStop="true"
                               Value="{smc:BindingEx Path=M_NGAY_CT1, ElementName=TransactionFrm}"/>
                            <TextBlock Name="lblDenNgay" Text="Đến ngày" Grid.Row="0" Grid.Column="3" Margin="0,2"
                         VerticalAlignment="Center"/>
                            <smc:DateTextBox Name="TxtEndDateTime" Grid.Row="0" Grid.Column="4" TabIndex="2" IsTabStop="true"
                               Value="{smc:BindingEx Path=M_NGAY_CT2, ElementName=TransactionFrm}"/>
                            <TextBlock Name="lblSoCtBatDau" Text="Đh từ số" Grid.Row="1" Grid.Column="0" Margin="0,2"
                         VerticalAlignment="Center"/>
                            <smc:AutoCompleteTextBox LostFocus="txtSoCtBatDau_LostFocus" Name="txtSoCtBatDau" Grid.Column="1" Grid.Row="1" ListID="dmhd"
                                       AllowEmty="true" AllowWrong="true" TabIndex="3" IsTabStop="true"
                                       SasObj="{Binding ElementName=TransactionFrm, Path=BindingSasObj}"
                                       ParentControl="{Binding ElementName=TransactionFrm}"/>
                            <TextBlock Name="lblSoCtkt" Text="Đến số" Grid.Row="1" Grid.Column="3" Margin="0,2" VerticalAlignment="Center"/>
                            <smc:AutoCompleteTextBox LostFocus="txtSoCtBatDau_LostFocus" Name="txtSoCtkt" Grid.Column="4" Grid.Row="1" ListID="dmhd"
                                       AllowEmty="true" AllowWrong="true" TabIndex="3" IsTabStop="true"
                                       SasObj="{Binding ElementName=TransactionFrm, Path=BindingSasObj}"
                                       ParentControl="{Binding ElementName=TransactionFrm}"/>

                            <TextBlock Name="lblMaKhach" Text="Mã khách" Grid.Row="3" Grid.Column="0" Margin="0,2"
                         VerticalAlignment="Center"/>

                            <smc:AutoCompleteTextBox PreviewLostFocus="txtMaKhach_PreviewLostFocus" Name="txtMaKhach" Grid.Column="1" Grid.Row="3"
                                       ListID="dmkh" AllowEmty="true" AllowWrong="true" TabIndex="5" IsTabStop="true"
                                       SasObj="{Binding ElementName=TransactionFrm, Path=BindingSasObj}"
                                       ParentControl="{Binding ElementName=TransactionFrm}"/>
                            
                            <TextBlock Name="lblTenKhach" Grid.Column="3" Grid.Row="3" Grid.ColumnSpan="2" Margin="2" ClipToBounds="false"/>
                            <TextBlock Name="lblMaKho" Grid.ColumnSpan="1" Grid.Row="4" Text="Mã kho" Grid.Column="0"
                         VerticalAlignment="Center"/>
                            <smc:AutoCompleteTextBox LostFocus="txtMaKho_LostFocus" Name="txtMaKho" AllowEmty="true" AllowWrong="true" Grid.Column="1"
                                       Grid.ColumnSpan="1" Grid.Row="4" ListID="dmkho" TabIndex="7" IsTabStop="true"
                                       Text="{smc:BindingEx Path=M_MA_KHO, ElementName=TransactionFrm}"
                                       ParentControl="{Binding ElementName=TransactionFrm}"
                                       SasObj="{Binding ElementName=TransactionFrm, Path=BindingSasObj}"/>
                            <TextBlock Name="lblTenKho" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="4" ClipToBounds="false"/>
                            <TextBlock Name="tblloai_dh" Text="Loại đh" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2"/>
                            <smc:MaskedTextBox LostFocus="txtps_ck_LostFocus" Name="tblstatus" TabIndex="8" Format="M" InputMask="1,2,*"
                                 Grid.Row="5" Grid.Column="1" Text="*"/>
                            <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="5"
                         Text="1 - Duyệt, 2 - Hủy, * - Cả 2"/>
                        </smc:GridLayout>
                    </GroupBox>
                    <smc:GridLayout Row="1" RowSpan="1" Column="3" RowCount="3" RowHeights="52,4,*">
                        <GroupBox Name="GroupDVCS" Grid.Row="0" Header="" Style="{StaticResource TabGroupBoxStyle}" Margin="0,0,0,0">
                            <smc:GridLayout RowCount="2" ColumnCount="2" ColumnWidths="100*,140" RowHeights="0,*">
                                <TextBlock Name="lblKieuloc" Grid.Row="0" Text="Kiểu lọc" Grid.Column="0" Visibility="Collapsed" Margin="0,2"
                           VerticalAlignment="Center"/>
                                <igEditors:XamComboEditor Name="cbKieuloc" Grid.Column="1" Grid.Row="0" IsTabStop="false" Visibility="Collapsed"
                                          SelectedIndex="0" Height="20" TabIndex="24">
                                    <igEditors:XamComboEditor.ItemsProvider>
                                        <igEditors:ComboBoxItemsProvider>
                                            <igEditors:ComboBoxItemsProvider.Items>
                                                <smc:ExComboBoxDataItem DisplayText="Tất cả các vật tư trong phiếu" DisplayText2="All items" Value="0"/>
                                                <smc:ExComboBoxDataItem DisplayText="Chỉ các vật tư theo đ/k lọc" DisplayText2="Only items with filter" Value="1"/>
                                            </igEditors:ComboBoxItemsProvider.Items>
                                        </igEditors:ComboBoxItemsProvider>
                                    </igEditors:XamComboEditor.ItemsProvider>
                                </igEditors:XamComboEditor>
                                <TextBlock Name="lblMa_dvcs" Grid.ColumnSpan="1" Grid.Row="1" Margin="0,2" Text="Mã ĐVCS" Grid.Column="0"
                           VerticalAlignment="Center"/>
                                <smc:AutoCompleteTextBox Name="txtMa_dvcs" Grid.Column="1" Grid.Row="1" Margin="1" ListID="dmdvcs" AllowEmty="true"
                                         AllowWrong="false" TabIndex="8" SasObj="{Binding ElementName=TransactionFrm, Path=BindingSasObj}"
                                         ParentControl="{Binding ElementName=TransactionFrm}"
                                         Text="{smc:BindingEx Path=M_MA_DVCS, ElementName=TransactionFrm}"/>
                            </smc:GridLayout>
                        </GroupBox>
                        <GroupBox Name="gbMauBC" Grid.Row="2" Grid.Column="3" Header="Mẫu báo cáo"
                      Style="{StaticResource TabGroupBoxStyle}" Margin="0,0,0,0">
                            <smc:GridLayout RowCount="3" ColumnCount="2" ColumnWidths="120,140                                         "
                              RowHeights="25,25,25*">
                                <TextBlock Name="lblKindReport" Grid.Row="0" Text="Mẫu VND/ngoại tệ" Grid.Column="0" Margin="0,2"
                           VerticalAlignment="Center"/>
                                <igEditors:XamComboEditor Name="cbMauBaoCao2" Grid.Column="1" Grid.Row="0" IsTabStop="false" Height="20" TabIndex="24"
                                          SelectedIndex="{smc:BindingEx Path=M_MAU_BC_NT, ElementName=TransactionFrm}">
                                    <igEditors:XamComboEditor.ItemsProvider>
                                        <igEditors:ComboBoxItemsProvider>
                                            <igEditors:ComboBoxItemsProvider.Items>
                                                <smc:ExComboBoxDataItem DisplayText="{x:Static local:StartUp.M_ma_nt0}" Value="0"/>
                                                <smc:ExComboBoxDataItem DisplayText="Ngoại tệ" DisplayText2="FC" Value="1"/>
                                            </igEditors:ComboBoxItemsProvider.Items>
                                        </igEditors:ComboBoxItemsProvider>
                                    </igEditors:XamComboEditor.ItemsProvider>
                                </igEditors:XamComboEditor>
                            </smc:GridLayout>
                        </GroupBox>
                    </smc:GridLayout>
                    <smr:ControlDetailFilter3 Name="GridSearch" GroupBoxStyleResourceKey="TabGroupBoxStyle" Grid.Row="3" Grid.RowSpan="1"
                                         IsShowCheckTableList="true" filterID="POCNCC1" Grid.Column="1" Grid.ColumnSpan="3"
                                         IsTabStop="false"/>
                </smc:GridLayout>
            </smc:ExTabItem>
        </smc:ExTabControl>
        <Canvas Grid.Row="1" Width="150" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,33">
            <TextBlock Name="lblTraCuu" Text="F5 - Tra cứu" Width="150" HorizontalAlignment="Right" TextAlignment="Right"/>
        </Canvas>
    </smc:ConfirmGridView>
</smr:FormFilter>
