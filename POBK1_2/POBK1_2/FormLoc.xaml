<SasFormReport:FormFilter x:Class="POBK1_2.FormLoc"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:POBK1_2"
                     xmlns:diagnostics="clr-namespace:System.Diagnostics;assembly=WindowsBase"
                     xmlns:smc="http://sis.vn/SasControls"
                     xmlns:igEditors="http://infragistics.com/Editors"
                     xmlns:SasFormReport="clr-namespace:SasFormReport;assembly=SasFormReport"
                     xmlns:igWindows="http://infragistics.com/Windows"
                     xmlns:sysData="clr-namespace:System.Data;assembly=System.Data"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                     Loaded="TransactionFrm_Loaded" KeyDown="TransactionFrm_KeyDown" Name="TransactionFrm"
                     ResizeMode="NoResize" Title="Bang ke phieu nhap" Height="650" Width="888" Theme="Standard"
                     LanguageID="POBK1_2Loc" WindowStartupLocation="CenterScreen" ShowInTaskbar="true">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <smc:ConfirmGridView OnOk="btnNhan_Click" OnCancel="btnHuy_Click" Name="grdConfirm" Height="Auto">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:ExTabControl Name="TabInfor" Theme="Generic" Margin="12,12,12,0">
      <smc:ExTabItem Name="TabMain" Header="Thông tin chung">
        <smc:GridLayout Name="GrdLayOut" ColumnCount="8" RowCount="6" RowHeights="0,178,4,*,8" ColumnWidths="8,527,12,*">
          <GroupBox Name="gpCon" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1"
                    Style="{StaticResource TabGroupBoxStyle}" Header="Điều kiện lọc">
            <smc:GridLayout Name="grdCon" RowCount="8" ColumnCount="6" ColumnWidths="100,140,12,110,*"
                            RowHeights="25,25,25,25,25,25,25,*">
              <TextBlock Name="lblDsManx" Grid.Row="0" Text="D.s mã nx (tk có)" Grid.Column="0" Margin="0,2"
                         VerticalAlignment="Center"/>
              <TextBox Name="txtDsManx" Grid.Column="1" TabIndex="0" Grid.Row="0"/>
              <TextBlock Name="lblTuNgay" Text="C.từ từ ngày" Grid.Row="1" Grid.Column="0" Margin="0,2"
                         VerticalAlignment="Center"/>
              <smc:DateTextBox Name="TxtStartDateTime" Grid.Column="1" Grid.Row="1" TabIndex="4" IsTabStop="true"
                               Value="{smc:BindingEx Path=M_NGAY_CT1, ElementName=TransactionFrm}"/>
              <TextBlock Name="lblDenNgay" Text="Đến ngày" Grid.Row="1" Grid.Column="3" Margin="0,2"
                         VerticalAlignment="Center"/>
              <smc:DateTextBox Name="TxtEndDateTime" Grid.Row="1" Grid.Column="4" TabIndex="5" IsTabStop="true"
                               Value="{smc:BindingEx Path=M_NGAY_CT2, ElementName=TransactionFrm}"/>
              <TextBlock Name="lblSoCtBatDau" Text="C.từ từ số" Grid.Row="2" Grid.Column="0" Margin="0,2"
                         VerticalAlignment="Center"/>
              <TextBox Name="txtSoCtBatDau" Grid.Column="1" Grid.Row="2" TabIndex="6" IsTabStop="true"
                       CharacterCasing="Upper"/>
              <TextBlock Name="lblSoCtKetThuc" Text="Đến số" Grid.Row="2" Grid.Column="3" Margin="0,2"
                         VerticalAlignment="Center"/>
              <TextBox Name="txtSoCtKetThuc" Grid.Column="4" Grid.Row="2" TabIndex="7" IsTabStop="true"
                       CharacterCasing="Upper"/>
              <TextBlock Name="lblMaKhach" Text="Mã ncc" Grid.Row="3" Grid.Column="0" Margin="0,2"
                         VerticalAlignment="Center"/>
              <smc:AutoCompleteTextBox LostFocus="txtMaKhach_LostFocus" Name="txtMaKhach" Grid.Column="1" Grid.Row="3" ListID="dmkh"
                                       AllowEmty="true" AllowWrong="true" TabIndex="8" IsTabStop="true" Height="20" Margin="0,0,0,2.5"
                                       VerticalAlignment="Bottom" Width="140"
                                       SasObj="{Binding ElementName=TransactionFrm, Path=BindingSasObj}"
                                       Text="{smc:BindingEx Path=M_MA_KH, ElementName=TransactionFrm}"
                                       ParentControl="{Binding ElementName=TransactionFrm}"/>
              <TextBlock Name="lblTenKhach" Grid.Column="3" Grid.Row="3" Grid.ColumnSpan="2" Margin="2" ClipToBounds="false"/>
              <TextBlock Name="tblten_tk" Grid.Column="3" Grid.Row="3" Grid.ColumnSpan="4"
                         Style="{StaticResource ContentTextStyle}" Margin="0"/>
              <TextBlock Name="lblMaVatTu" Grid.ColumnSpan="1" Grid.Row="4" Margin="0,2" Text="Mã vật tư" Grid.Column="0"
                         VerticalAlignment="Center"/>
              <smc:AutoCompleteTextBox LostFocus="txtMaVT_LostFocus" Name="txtMaVT" AllowEmty="true" AllowWrong="true" Grid.Column="1"
                                       Grid.ColumnSpan="1" Grid.Row="4" ListID="dmvt" TabIndex="9" IsTabStop="true"
                                       Text="{smc:BindingEx Path=M_MA_VT, ElementName=TransactionFrm}"
                                       ParentControl="{Binding ElementName=TransactionFrm}"
                                       SasObj="{Binding ElementName=TransactionFrm, Path=BindingSasObj}"/>
              <TextBlock Name="lblTenVT" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="4" Margin="2" ClipToBounds="false"/>
              <TextBlock Name="lblMaKho" Grid.ColumnSpan="1" Grid.Row="5" Margin="0,2" Text="Mã kho" Grid.Column="0"
                         VerticalAlignment="Center"/>
              <smc:AutoCompleteTextBox LostFocus="txtMaKho_LostFocus" Name="txtMaKho" AllowEmty="true" AllowWrong="true" Grid.Column="1"
                                       Grid.ColumnSpan="1" Grid.Row="5" ListID="dmkho" TabIndex="10" IsTabStop="true"
                                       Text="{smc:BindingEx Path=M_MA_KHO, ElementName=TransactionFrm}"
                                       ParentControl="{Binding ElementName=TransactionFrm}"
                                       SasObj="{Binding ElementName=TransactionFrm, Path=BindingSasObj}"/>
              <TextBlock Name="lblTenKho" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="5" Margin="2" ClipToBounds="false"/>
            </smc:GridLayout>
          </GroupBox>
          <smc:GridLayout Row="1" RowSpan="1" Column="3" RowCount="3" Margin="0,0,8,0" RowHeights="52,4,*">
            <GroupBox Name="gb_dvcs" Header="" Style="{StaticResource TabGroupBoxStyle}" Grid.Row="0" Grid.Column="0">
              <smc:GridLayout ColumnCount="2" ColumnWidths="110,140*" RowCount="2" RowHeights="25,*">
                <TextBlock Name="lblma_dvcs" Text="Mã ĐVCS" Grid.Row="0" Grid.Column="0" Margin="0,2"
                           VerticalAlignment="Center"/>
                <smc:AutoCompleteTextBox Name="txtma_dvcs" AllowEmty="true" AllowWrong="false" Grid.Column="1" Grid.Row="0" ListID="dmdvcs"
                                         LookupMode="true" Margin="1" TabIndex="25"
                                         ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                         SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                         Text="{smc:BindingEx Path=M_MA_DVCS, ElementName=TransactionFrm}"
                                         IsReadOnly="{Binding Path=ReadOnlyMaDVCS, ElementName=TransactionFrm, UpdateSourceTrigger=PropertyChanged}"/>
              </smc:GridLayout>
            </GroupBox>
            <GroupBox Name="gpRep" Grid.Row="2" Header="Mẫu báo cáo" Style="{StaticResource TabGroupBoxStyle}"
                      Margin="0,0,0,0">
              <smc:GridLayout Name="grdRep" RowCount="2" ColumnCount="2" ColumnWidths="110,*" HeightPerRow="25" RowHeights="25,*"/>
            </GroupBox>
          </smc:GridLayout>
          <SasFormReport:ControlDetailFilter3 Name="GridSearch" GroupBoxStyleResourceKey="TabGroupBoxStyle" Grid.Row="3" Margin="0,0,8,0"
                                         Grid.RowSpan="1" IsShowCheckTableList="true" filterID="POBK1_2" Grid.Column="1" Grid.ColumnSpan="3"
                                         IsTabStop="false"/>
        </smc:GridLayout>
      </smc:ExTabItem>
    </smc:ExTabControl>
    <Canvas Name="pnlSearch" Grid.Row="1" Width="150" VerticalAlignment="Bottom" HorizontalAlignment="Right"
            Margin="0,0,12,33">
      <TextBlock Name="lblSearch" Text="F5 - Tra cứu" Width="150" HorizontalAlignment="Right" TextAlignment="Right"/>
    </Canvas>
  </smc:ConfirmGridView>
</SasFormReport:FormFilter>
