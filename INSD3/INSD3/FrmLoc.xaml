<SasFormReport:FormFilter x:Class="INSD3.FrmLoc"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:smc="http://sis.vn/SasControls"
                     xmlns:igWindows="http://infragistics.com/Windows"
                     xmlns:igEditors="http://infragistics.com/Editors"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                     xmlns:SasFormReport="clr-namespace:SasFormReport;assembly=SasFormReport"
                     xmlns:diagnostics="clr-namespace:System.Diagnostics;assembly=WindowsBase"
                     xmlns:sysData="clr-namespace:System.Data;assembly=System.Data"
                     xmlns:local="clr-namespace:INSD3"
                     Loaded="formFilter_Loaded" Name="formFilter" LanguageID="INSD3_0"
                     WindowStartupLocation="CenterScreen" Title="Bao cao ton kho" ResizeMode="NoResize" Height="600"
                     Width="872" Theme="Standard">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
        <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <smc:ConfirmGridView OnOk="ConfirmGridView_OnOk" OnCancel="ConfirmGridView_OnCancel" Height="Auto">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:ExTabControl Name="TabInfor" Margin="12,12,12,0" Height="Auto" Theme="Generic">
      <smc:ExTabItem Name="TabMain" Header="Thông tin chính" Height="Auto">
        <smc:GridLayout Name="GrdLayOut" ColumnCount="8" RowCount="5" RowHeights="0,158,4,*,8" ColumnWidths="8,518,12,*,8">
          <GroupBox Name="Grp00" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1"
                    Style="{StaticResource TabGroupBoxStyle}" Header="Điều kiện lọc">
            <smc:GridLayout RowCount="5" ColumnCount="5" ColumnWidths="100,140,12,100,140" HeightPerRow="25">
              <TextBlock Name="lblkieu_xem" Text="Kiểu xem" Grid.Row="0" Grid.Column="0"/>
              <smc:MaskedTextBox Name="txtkieu_xem" Grid.Column="1" Grid.Row="0" Text="1" TabIndex="1" InputMask="1,2" Format="M"
                                 IsTabStop="true" HorizontalContentAlignment="Right"/>
              <TextBlock Name="lblten_kieu_xem" Grid.ColumnSpan="2" Grid.Row="0" Margin="0,2"
                         Text="1 - Theo cột, 2 - Theo dòng" Grid.Column="3"/>
              <TextBlock Name="lblNgay" Text="Đến cuối ngày" Grid.Row="1" Grid.Column="0"/>
              <smc:DateTextBox x:Name="txtNgay" Grid.Row="1" Grid.Column="1" Style="{StaticResource DateTextBoxStyle}"
                               TabIndex="10" Value="{smc:BindingEx Path=M_NGAY_CT2, ElementName=formFilter}"/>
              <TextBlock Name="lblMaKho" Text="Mã kho" Grid.Row="2" Grid.Column="0"/>
              <smc:AutoCompleteTextBox LostFocus="txtMaKho_LostFocus" x:Name="txtMaKho" AllowEmty="true" AllowWrong="true"
                                       LookupMode="true" ListID="dmkho" Grid.Row="2" Grid.Column="1" CharacterCasing="Upper"
                                       Style="{StaticResource AutoCompleteTextBoxStyle}" TabIndex="20"
                                       ParentControl="{Binding ElementName=formFilter}"
                                       SasObj="{Binding BindingSasObj, ElementName=formFilter}"
                                       Text="{smc:BindingEx Path=M_MA_KHO, ElementName=formFilter}"/>
              <TextBlock Name="tblTenKho" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"/>
              <TextBlock Name="lblMaVT" Text="Mã vật tư" Grid.Row="3" Grid.Column="0"/>
              <smc:AutoCompleteTextBox LostFocus="txtMaVT_LostFocus" x:Name="txtMaVT" AllowEmty="true" AllowWrong="true" LookupMode="true"
                                       ListID="dmvt" Grid.Row="3" Grid.Column="1" CharacterCasing="Upper"
                                       Style="{StaticResource AutoCompleteTextBoxStyle}" TabIndex="30"
                                       ParentControl="{Binding ElementName=formFilter}"
                                       SasObj="{Binding BindingSasObj, ElementName=formFilter}"/>
              <TextBlock Name="tblTenVT" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"/>
              <TextBlock Name="lblkho_dl" Text="Các kho gửi bán" Grid.Row="4" Grid.Column="0"/>
              <smc:MaskedTextBox Name="txtkho_dl" Grid.Column="1" Grid.Row="4" Text="1" TabIndex="31" InputMask="1,2" Format="M"
                                 IsTabStop="true" HorizontalContentAlignment="Right"/>
              <TextBlock Name="lblten_kho_dl" Grid.ColumnSpan="2" Grid.Row="4" Margin="0,2"
                         Text="1 - Chi tiết theo kho, 2 - Cộng gộp" Grid.Column="3"/>
            </smc:GridLayout>
          </GroupBox>
          <smc:GridLayout Name="gridlayout01" Row="1" Column="3" RowCount="3" ColumnCount="1" RowHeights="52,4,*">
            <GroupBox Name="Grp011" Grid.Row="0" Grid.Column="3" Style="{StaticResource TabGroupBoxStyle}">
              <smc:GridLayout RowCount="1" ColumnCount="2" ColumnWidths="*,140" RowHeights="25">
                <TextBlock Name="lblmDVCS" Grid.Row="0" Text="Mã ĐVCS" Grid.Column="0" VerticalAlignment="Center"/>
                <smc:AutoCompleteTextBox Name="txtMDVCS" AllowEmty="true" AllowWrong="false" Grid.Column="1" Grid.ColumnSpan="1"
                                         Grid.Row="0" LookupMode="true" ListID="dmdvcs" TabIndex="50"
                                         ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                         SasObj="{Binding BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                         Text="{smc:BindingEx Path=M_MA_DVCS, ElementName=formFilter}"/>
              </smc:GridLayout>
            </GroupBox>
            <GroupBox Name="Grp01" Grid.Row="2" Grid.Column="3" Header="Mẫu báo cáo"
                      Style="{StaticResource TabGroupBoxStyle}">
              <smc:GridLayout RowCount="4" ColumnCount="2" ColumnWidths="*,140" RowHeights="25, *">
                <TextBlock Name="lblKindReport" Grid.Row="0" Text="Mẫu VND/ngoại tệ" Grid.Column="0"/>
                <igEditors:XamComboEditor Name="cbmau_bc" Grid.Column="1" Grid.Row="0" IsTabStop="false" TabIndex="60" Margin="0"
                                          SelectedIndex="{smc:BindingEx Path=M_MAU_BC_NT, ElementName=formFilter}">
                  <igEditors:XamComboEditor.ItemsProvider>
                    <igEditors:ComboBoxItemsProvider>
                      <igEditors:ComboBoxItemsProvider.Items>
                        <smc:ExComboBoxDataItem DisplayText="{x:Static local:StartUp.M_ma_nt0}" Value="0"/>
                      </igEditors:ComboBoxItemsProvider.Items>
                    </igEditors:ComboBoxItemsProvider>
                  </igEditors:XamComboEditor.ItemsProvider>
                </igEditors:XamComboEditor>
              </smc:GridLayout>
            </GroupBox>
          </smc:GridLayout>
          <SasFormReport:ControlDetailFilter3 Name="GridSearch" GroupBoxStyleResourceKey="TabGroupBoxStyle" Grid.Row="3" Grid.RowSpan="1"
                                         filterID="INSD3" Grid.Column="1" IsShowCheckTableList="true" Grid.ColumnSpan="3" IsTabStop="false"/>
        </smc:GridLayout>
      </smc:ExTabItem>
    </smc:ExTabControl>
    <Canvas Grid.Row="1" Width="150" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,33">
      <TextBlock Name="lblTracuu" Text="F5 - Tra cứu" Width="150" HorizontalAlignment="Right" TextAlignment="Right"/>
    </Canvas>
  </smc:ConfirmGridView>
</SasFormReport:FormFilter>
