<smvc:FormTrans x:Class="Poctpnc.FrmPoctpnc"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:src="clr-namespace:Poctpnc"
                xmlns:igWindows="http://infragistics.com/Windows"
                xmlns:smc="http://sis.vn/SasControls"
                xmlns:smvc="clr-namespace:SasVoucherLib;assembly=SasVoucherLib"
                xmlns:System="clr-namespace:System;assembly=mscorlib"
                xmlns:igEditors="http://infragistics.com/Editors"
                xmlns:igDP="http://infragistics.com/DataPresenter"
                xmlns:diagnostics="clr-namespace:System.Diagnostics;assembly=WindowsBase"
                xmlns:sys="clr-namespace:System;assembly=mscorlib"
                xmlns:igThemes="http://infragistics.com/Themes"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                Cm_Moi="V_Moi" Cm_Sua="V_Sua" Cm_Nhan="V_Nhan" Cm_Copy="V_Copy" Cm_In="V_In" Cm_Huy="V_Huy"
                Cm_Xoa="V_Xoa" Cm_Xem="V_Xem" Cm_Dau="V_Dau" Cm_Truoc="V_Truoc" Cm_Sau="V_Sau" Cm_Cuoi="V_Cuoi"
                Cm_Tim="V_Tim" EditModeEnded="FormMain_EditModeEnded" Loaded="FormMain_Loaded" x:Name="FormMain"
                LanguageID="PoctpncMain" Title="Phieu nhap chi phi mua hang" Height="680" Width="960"
                Theme="Voucher" WindowStartupLocation="CenterScreen"
                AssignMaxLengthControlList="txtSo_ct;txtDia_chi;txtOng_ba;txtDien_giai;txtghi_chu">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBlockStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ButtonStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DataGridViewStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/GroupBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/CheckBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/NumericTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/MaskedTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/AutoCompleteTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/XamComboEditorStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/ExRateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/DateTextBoxStyles.xaml"/>
                <smc:CachedResourceDictionary Source="pack://application:,,,/SasStyle;component/TabItemExStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <smvc:BindingVisibility x:Key="VisibilityConverter"/>
            <smc:CheckBoxConverter x:Key="IsCheckedConverter"/>
            <src:BindingReadonly x:Key="ReadOnlyConverter"/>
            <src:BindingTextStatus x:Key="TextStatus"/>
            <smvc:BindingStatusVoucher x:Key="StatusVoucher"/>
            <smvc:FormatMaskNumberConverter x:Key="MaskNumeric"/>
            <smc:BoolInverter x:Key="BoolInverter"/>
            <smc:CodeValueBindingObject x:Key="Voucher_Lan0" Value="false"/>
            <src:IdRecordConverterXamDataGrid x:Key="IdRecordXamDataGrid"/>
            <smc:CodeValueBindingObject x:Key="IsInEditMode" Value="false"/>
            <smc:CodeValueBindingObject x:Key="Voucher_Ma_nt0"/>
            <smc:CodeValueBindingObject x:Key="M_Ngay_lct" Value="false"/>
            <smc:CodeValueBindingObject x:Key="IsCheckedSua_tien" Value="false"/>
            <smc:CodeValueBindingObject x:Key="Ty_Gia_ValueChange" Value="false"/>
            <Style x:Key="ButtonEditModeEnable" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="UIElement.IsEnabled" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TextBoxEditModeEnable" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="TextBoxBase.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AutoCompleteTextBoxEditModeEnable" TargetType="{x:Type smc:AutoCompleteTextBox}"
             BasedOn="{StaticResource AutoCompleteTextBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="smc:AutoCompleteTextBox.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NumericTextBoxrEditModeEnable" TargetType="{x:Type smc:NumericTextBox}"
             BasedOn="{StaticResource NumericTextBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CheckBoxEditModeEnable" TargetType="{x:Type CheckBox}"
             BasedOn="{StaticResource CheckBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="UIElement.IsEnabled" Value="false"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DateTextBoxEditModeEnable" TargetType="{x:Type smc:DateTextBox}"
             BasedOn="{StaticResource DateTextBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}"
                       Value="False">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ComboBoxEditModeEnable" TargetType="{x:Type igEditors:XamComboEditor}"
             BasedOn="{StaticResource XamComboEditorStyle}">
                <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_act"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="False"/>
                            <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type smvc:FormTrans}}}"
                         Value="E"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_act2"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="True"/>
                            <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type smvc:FormTrans}}}"
                         Value="V"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_post"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=Value, Source={StaticResource IsInEditMode}, Mode=OneWay}" Value="True"/>
                            <Condition Binding="{Binding Path=M_LAN, RelativeSource={RelativeSource AncestorType={x:Type smvc:FormTrans}}}"
                         Value="E"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="igEditors:XamComboEditor.DisplayMemberPath" Value="ten_post2"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MaskedTextBoxEditModeEnable" TargetType="{x:Type smc:MaskedTextBox}"
             BasedOn="{StaticResource MaskedTextBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="False">
                        <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <SolidColorBrush x:Key="TabControlNormalBorderBrush" Color="#919B9C"/>
            <SolidColorBrush x:Key="TabItemHotBorderBrush" Color="#FFE68B2C"/>
            <SolidColorBrush x:Key="TabItemHotBorderBackround" Color="#FFFFC73C"/>
            <LinearGradientBrush x:Key="TabItemHotBackground" EndPoint="0,1" StartPoint="0,0">
                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                <GradientStop Color="#FFECEBE6" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="TabItemSelectedBorderBrush" Color="#FFE68B2C"/>
            <SolidColorBrush x:Key="TabItemSelectedBorderBackround" Color="#FFFFC73C"/>
            <SolidColorBrush x:Key="TabItemSelectedBackground" Color="#FFFCFCFE"/>
            <SolidColorBrush x:Key="TabItemDisabledBackground" Color="#FFF5F4EA"/>
            <SolidColorBrush x:Key="TabItemDisabledBorderBrush" Color="#FFC9C7BA"/>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <smc:GridLayout x:Name="GrdLayout00" Margin="0" RowCount="5" RowHeights="35,185,66,*,115">
        <smc:GridLayout Name="GrdLayout10" Row="1" RowCount="1" RowHeights="*" ColumnCount="5"
                    ColumnWidths="23*,10,45*,12,276" Margin="12,4,12,4">
            <GroupBox Name="gbInfo" Header="Thông tin chung" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Margin="0">
                <smc:GridLayout Name="GridLayoutInfo" RowCount="6" ColumnCount="6" RowHeights="25,25,25,25,25,*"
                        ColumnWidths="100,140,*,100,140" Margin="0">
                    <TextBlock Name="tblma_kh" Text="Mã ncc" Grid.Row="0" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_kh_PreviewLostFocus" Name="txtMa_kh" Grid.Column="1" Grid.Row="0"
                                   TabIndex="10" AllowEmty="false" AllowWrong="false" ListID="dmkh"
                                   Style="{StaticResource AutoCompleteTextBoxEditModeEnable}" Text="{smc:BindingEx Path=ma_kh}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=smvc:FormTrans}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=smvc:FormTrans}}"/>
                    <TextBlock Name="tblTen_kh" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}" Text="{smc:BindingEx Path=ten_kh, Path2=ten_kh2}"/>
                    <TextBlock Name="tbldia_chi" Text="Địa chỉ" Grid.Row="1" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox GotFocus="txtDia_chi_GotFocus" x:Name="txtDia_chi" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                   TabIndex="15" Style="{StaticResource TextBoxEditModeEnable}" Text="{smc:BindingEx Path=dia_chi}"/>
                    <TextBlock Name="tblma_so_thue" Text="MST" Grid.Row="1" Grid.Column="3" Margin="12,0,0,0"/>
                    <TextBox x:Name="txtMaSoThue" Grid.Column="4" Grid.Row="1" Style="{StaticResource TextBoxStyle}"
                   IsReadOnly="true" Text="{smc:BindingEx Path=ma_so_thue}"/>
                    <TextBlock Name="tblso_du_kh" Text="Số dư" Grid.Row="2" Grid.Column="3" Margin="12,0,0,0"/>
                    <smc:NumericTextBox Name="txtso_du_kh" Grid.Row="2" Grid.Column="4" IsReadOnly="true"
                              Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}"/>
                    <TextBlock Name="tblong_ba" Text="Ng. giao hàng" Grid.Row="2" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox x:Name="txtOng_ba" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" TabIndex="20"
                   Text="{smc:BindingEx Path=ong_ba}">
                        <FrameworkElement.Style>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                                <Setter Property="TextBoxBase.IsReadOnly">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource ReadOnlyConverter}" ConverterParameter="PH;ong_ba" Mode="OneWay">
                                            <Binding Source="{StaticResource IsInEditMode}" Path="Value"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Control.IsTabStop" Value="true"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsReadOnly, ElementName=txtOng_ba}" Value="True">
                                        <Setter Property="Control.IsTabStop" Value="false"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </FrameworkElement.Style>
                    </TextBox>
                    <TextBlock Name="tbldien_giai" Text="Diễn giải" Grid.Row="3" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox Name="txtDien_giai" TabIndex="30" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="4"
                   Style="{StaticResource TextBoxEditModeEnable}" Text="{smc:BindingEx Path=dien_giai}"/>
                    <TextBlock Name="tblma_nx" Text="Mã nx (tk có)" Grid.Row="4" Grid.Column="0"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_nx_PreviewLostFocus" x:Name="txtMa_nx" Grid.Column="1" Grid.Row="4"
                                   TabIndex="40" AllowEmty="false" AllowWrong="false" ListID="dmnx"
                                   Style="{StaticResource AutoCompleteTextBoxEditModeEnable}" Text="{smc:BindingEx Path=ma_nx}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="tblTenTK" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Margin="12,0,0,0"
                     Style="{StaticResource ContentTextStyle}" Text="{smc:BindingEx Path=ten_tk, Path2=ten_tk2}"/>
                </smc:GridLayout>
            </GroupBox>
            <GroupBox Name="gbVoucher" Header="Chứng từ" Grid.Column="4" Grid.Row="0">
                <smc:GridLayout Name="GrdVoucher" ColumnCount="3" ColumnWidths="5*,43,140" HeightPerRow="25" RowCount="6"
                        Margin="0">
                    <TextBlock Name="tblngay_ct" Text="Ngày ht" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:DateTextBox LostFocus="txtNgay_ct_LostFocus" x:Name="txtNgay_ct" Grid.Column="2" Grid.Row="0" TabIndex="50"
                           AllowEmpty="false" Style="{StaticResource DateTextBoxEditModeEnable}"
                           Value="{smc:BindingEx Path=ngay_ct}"/>
                    <TextBlock Name="tblngay_lct" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Text="Ngày lập c.từ"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:DateTextBox GotFocus="txtngay_lct_GotFocus" LostFocus="txtngay_lct_LostFocus" x:Name="txtngay_lct"
                           Grid.Column="2" Grid.Row="1" TabIndex="60" Value="{smc:BindingEx Path=ngay_lct}">
                        <FrameworkElement.Style>
                            <Style TargetType="{x:Type smc:DateTextBox}" BasedOn="{StaticResource DateTextBoxStyle}">
                                <Setter Property="igEditors:ValueEditor.IsReadOnly">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource ReadOnlyConverter}" ConverterParameter="PH;ngay_lct" Mode="OneWay">
                                            <Binding Source="{StaticResource IsInEditMode}" Path="Value"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Control.IsTabStop" Value="true"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsReadOnly, ElementName=txtngay_lct}" Value="True">
                                        <Setter Property="Control.IsTabStop" Value="false"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </FrameworkElement.Style>
                    </smc:DateTextBox>
                    <TextBlock Name="tblma_qs" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Quyển c.từ"
                     Style="{StaticResource ContentTextStyle}"/>
                    <smc:AutoCompleteTextBox PreviewLostFocus="txtMa_qs_PreviewLostFocus" x:Name="txtMa_qs" Grid.Column="2" Grid.Row="2"
                                   TabIndex="70" AllowEmty="false" AllowWrong="false" ListID="dmqs"
                                   Filter="ma_cts like '%PNC%' and status = 1"
                                   Style="{StaticResource AutoCompleteTextBoxEditModeEnable}" Text="{smc:BindingEx Path=ma_qs}"
                                   ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
                    <TextBlock Name="tblso_ct" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="Số c.từ"
                     Style="{StaticResource ContentTextStyle}"/>
                    <TextBox GotFocus="txtSo_ct_GotFocus" x:Name="txtSo_ct" Grid.Column="2" Grid.Row="3" TabIndex="80"
                   CharacterCasing="Upper" Text="{smc:BindingEx Path=so_ct}"
                   Style="{smc:MergedStyles BasedOn={StaticResource TextBoxStyle}, MergeStyle={StaticResource TextBoxEditModeEnable}}">
                    </TextBox>
                    <smc:GridLayout Name="GrdLayoutNT" Row="4" Column="0" ColumnSpan="3" ColumnCount="3" ColumnWidths="52*,43,140">
                        <TextBlock Name="tblTy_gia" Grid.Row="4" Grid.Column="0" Text="Tỷ giá"
                       Style="{StaticResource ContentTextStyle}"/>
                        <smc:AutoCompleteTextBox PreviewLostFocus="cbMa_nt_PreviewLostFocus" Name="cbMa_nt" Grid.Column="1" Grid.Row="4"
                                     Margin="0,0,5,0" AllowEmty="false" AllowWrong="false" ListID="dmnt" IsTabStop="false"
                                     Style="{StaticResource AutoCompleteTextBoxEditModeEnable}" TabIndex="81"
                                     Text="{smc:BindingEx Path=ma_nt}"
                                     ParentControl="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                     SasObj="{Binding Path=BindingSasObj, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                        <smc:ExRateTextBox GotFocus="txtTy_gia_GotFocus" LostFocus="txtTy_gia_LostFocus" x:Name="txtTy_gia" Grid.Row="4"
                               Margin="0" Grid.Column="2" TabIndex="82" RateF="{smc:BindingEx Path=ty_giaf}"
                               Rate="{smc:BindingEx Path=ty_gia}" KindRate="{smc:BindingEx Path=loai_tg}"
                               Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TY_GIA}">
                            <FrameworkElement.Style>
                                <Style TargetType="{x:Type smc:ExRateTextBox}" BasedOn="{StaticResource ExRateTextBoxStyle}">
                                    <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="true"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{smc:BindingEx Path=Value, Source={StaticResource IsInEditMode}}" Value="True"/>
                                                <Condition Binding="{smc:BindingEx Path=Value, Source={StaticResource Voucher_Ma_nt0}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="igEditors:ValueEditor.IsReadOnly" Value="false"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </FrameworkElement.Style>
                        </smc:ExRateTextBox>
                    </smc:GridLayout>
                    <smc:GridLayout Name="GrdLayoutStatus" Column="0" Row="5" ColumnSpan="3" ColumnCount="2" ColumnWidths="*,140"
                          KeyboardNavigation.TabNavigation="None">
                        <TextBlock Name="tblStatus" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                       Style="{StaticResource ContentTextStyle}"
                       Text="{Binding Path=Value, Source={StaticResource IsInEditMode}, Converter={StaticResource TextStatus}}"/>
                        <igEditors:XamComboEditor Name="txtStatus" Style="{StaticResource ComboBoxEditModeEnable}" ValuePath="ma_post"
                                      Grid.Column="1" Grid.Row="0" Height="20" TabIndex="83"
                                      IsEnabled="{Binding Path=Value, Source={StaticResource IsInEditMode}}"
                                      SelectedIndex="{smc:BindingEx Path=status, Converter={StaticResource StatusVoucher}}"/>
                    </smc:GridLayout>
                </smc:GridLayout>
            </GroupBox>
        </smc:GridLayout>
        <GroupBox Name="gbPN" Grid.Row="2" Margin="12,0,12,12">
            <smc:GridLayout Name="GrdLayoutPN" RowCount="1" ColumnCount="10" ColumnWidths="100,100,140,12,100,140,12,100,140,*">
                <Button Click="btnChonpn_Click" Name="btnChonpn" Content="_Chọn pn mua" Grid.Column="0" Width="80"
                Height="22" Margin="0,0,0,0" TabIndex="83" Style="{StaticResource ButtonEditModeEnable}"
                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Name="tblngay_pn" Text="Ngày pn" Grid.Column="1" Style="{StaticResource ContentTextStyle}"/>
                <smc:DateTextBox x:Name="txtngay_pn" Grid.Column="2" IsEnabled="false" Value="{smc:BindingEx Path=ngay_pn}"/>
                <TextBlock Name="tblso_pn" Text="Số pn" Grid.Row="5" Grid.Column="4" Style="{StaticResource ContentTextStyle}"/>
                <TextBox x:Name="txtso_pn" Grid.Column="5" Grid.Row="5" Style="{StaticResource TextBoxEditModeEnable}"
                 IsReadOnly="true" Text="{smc:BindingEx Path=so_pn}"/>
                <TextBlock Name="tblma_kh_pn" Text="Mã ncc" Grid.Row="5" Grid.Column="7"
                   Style="{StaticResource ContentTextStyle}"/>
                <TextBox x:Name="txtma_kh_pn" Grid.Column="8" Grid.Row="5" Style="{StaticResource TextBoxEditModeEnable}"
                 IsReadOnly="true" Text="{smc:BindingEx Path=ma_kh_pn}"/>
                <TextBlock x:Name="txtten_kh_pn" Grid.Column="9" Grid.Row="5" Margin="12,0,0,0"
                   Style="{StaticResource ContentTextStyle}" Text="{smc:BindingEx Path=ten_kh_pn, Path2=ten_kh_pn2}"/>
            </smc:GridLayout>
        </GroupBox>
        <smc:GridLayout Name="GrdLayout30" Row="3" Column="0" Margin="12,0,12,4" KeyboardNavigation.TabIndex="120"
                    KeyboardNavigation.TabNavigation="Local">
            <igWindows:XamTabControl SelectionChanged="TabInfo_SelectionChanged" x:Name="TabInfo" Grid.Row="0" Grid.Column="0"
                               Theme="Generic" Background="{x:Null}">
                <Control.BorderBrush>
                    <SolidColorBrush Color="#FFD0D0BF" igThemes:ResourceWasher.WashGroup="Selected"/>
                </Control.BorderBrush>
                <FrameworkElement.Resources>
                    <Style TargetType="{x:Type igWindows:TabItemEx}" BasedOn="{StaticResource TabItemStyle}"/>
                </FrameworkElement.Resources>
                <igWindows:TabItemEx x:Name="tiCP" Header="_1. Chi tiết" TabIndex="130">
                    <smc:GridLayout Name="GrdTongChiPhi" ColumnCount="9" ColumnWidths="105,140,12,140,12,325,35,105,*" RowCount="2"
                          RowHeights="30,*">
                        <TextBlock Name="tbltong_cp" Text="Tổng chi phí" Grid.Column="0" Grid.Row="0" Margin="12,0,0,0"
                       Style="{StaticResource ContentTextStyle}"/>
                        <smc:NumericTextBox LostFocus="txttong_cp_nt_LostFocus" Name="txttong_cp_nt" TabIndex="120" Grid.Column="1"
                                Grid.Row="0" Style="{StaticResource NumericTextBoxrEditModeEnable}"
                                Value="{smc:BindingEx Path=t_cp_nt}"
                                Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN_NT}"/>
                        <smc:NumericTextBox LostFocus="txttong_cp_LostFocus" Name="txttong_cp" TabIndex="121" Grid.Column="3" Grid.Row="0"
                                Style="{StaticResource NumericTextBoxrEditModeEnable}" Value="{smc:BindingEx Path=t_cp}"
                                Format="{Binding Path=Text, Source={StaticResource Voucher_Ma_nt0}, Mode=OneWay, Converter={StaticResource MaskNumeric}, ConverterParameter=M_IP_TIEN}">
                            <UIElement.Visibility>
                                <MultiBinding Converter="{StaticResource VisibilityConverter}" ConverterParameter="NotMaNt0">
                                    <Binding Path="ma_nt" Source="{StaticResource Voucher_Ma_nt0}"/>
                                </MultiBinding>
                            </UIElement.Visibility>
                        </smc:NumericTextBox>
                        <TextBlock Name="tblloai_pb" Text="Kiểu phân bổ (1 - Theo tiền hàng, 2 - Theo số lượng)" Grid.Column="5"
                       Grid.Row="0" Margin="0,0,12,0" Style="{StaticResource ContentTextStyle}"/>
                        <smc:MaskedTextBox LostFocus="txtloai_pb_LostFocus" Name="txtloai_pb" TabIndex="122" Grid.Column="6" Grid.Row="0"
                               Format="M" InputMask="1,2" Style="{StaticResource MaskedTextBoxEditModeEnable}"
